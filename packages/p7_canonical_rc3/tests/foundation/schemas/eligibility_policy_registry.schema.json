          "type": "integer"
        },
        "min_scenario_count": {
          "default": 1,
          "minimum": 0,
          "title": "Min Scenario Count",
          "type": "integer"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "representative_only": {
          "default": true,
          "title": "Representative Only",
          "type": "boolean"
        },
        "require_calendar_id": {
          "default": false,
          "title": "Require Calendar Id",
          "type": "boolean"
        },
        "require_maximum_loss_proven": {
          "default": true,
          "title": "Require Maximum Loss Proven",
          "type": "boolean"
        },
        "required_candidate_paths": {
