{
  "$defs": {
    "EligibilityPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_calendars": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Calendars",
          "type": "array"
        },
        "allowed_currencies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Currencies",
          "type": "array"
        },
        "allowed_objective_families": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Objective Families",
          "type": "array"
        },
        "defined_risk_required": {
