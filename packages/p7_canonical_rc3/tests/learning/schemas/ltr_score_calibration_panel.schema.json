{
  "$id": "ltr_score_calibration_panel.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_name": {
      "const": "ltr_score_calibration_panel"
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "type": "string"
    },
    "pipeline_version": {
      "minLength": 1,
      "type": "string"
    },
    "producer_module_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_phase": {
      "minLength": 1,
      "type": "string"
    },
    "record_count": {
      "minimum": 0,
      "type": "integer"
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "calibrated_ltr_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "calibration_method": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "calibration_status": {
            "enum": [
              "CALIBRATED",
              "UNAVAILABLE"
            ]
          },
          "calibration_version": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate_id": {
            "minLength": 1,
            "type": "string"
          },
          "comparison_group_id": {
            "minLength": 1,
            "type": "string"
          },
          "lineage_id": {
            "minLength": 1,
            "type": "string"
          },
          "raw_ltr_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "candidate_id",
          "comparison_group_id",
          "raw_ltr_score",
          "calibrated_ltr_score",
          "calibration_status",
          "calibration_method",
          "calibration_version",
          "target_id",
          "lineage_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_name",
    "schema_version",
    "producer_phase",
    "producer_module_id",
    "pipeline_version",
    "run_id",
    "cycle_id",
    "decision_time",
    "available_at",
    "created_at",
    "lineage_id",
    "content_sha256",
    "record_count",
    "records"
  ],
  "type": "object"
}
