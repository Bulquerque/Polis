{
  "$id": "ltr_calibration_evidence_panel.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_name": {
      "const": "ltr_calibration_evidence_panel"
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "type": "string"
    },
    "pipeline_version": {
      "minLength": 1,
      "type": "string"
    },
    "producer_module_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_phase": {
      "minLength": 1,
      "type": "string"
    },
    "record_count": {
      "minimum": 0,
      "type": "integer"
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "minLength": 1,
            "type": "string"
          },
          "candidate_topology": {
            "minLength": 1,
            "type": "string"
          },
          "fold_id": {
            "minLength": 1,
            "type": "string"
          },
          "implementation_id": {
            "minLength": 1,
            "type": "string"
          },
          "interpretable_score": {
            "type": "number"
          },
          "model_family_id": {
            "minLength": 1,
            "type": "string"
          },
          "model_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "objective_family": {
            "minLength": 1,
            "type": "string"
          },
          "query_id": {
            "minLength": 1,
            "type": "string"
          },
          "raw_ltr_score": {
            "type": "number"
          },
          "regime": {
            "type": [
              "string",
              "null"
            ]
          },
          "split": {
            "const": "CALIBRATION"
          },
          "utility_label": {
            "type": "number"
          }
        },
        "required": [
          "model_family_id",
          "model_hash",
          "implementation_id",
          "fold_id",
          "split",
          "query_id",
          "candidate_id",
          "raw_ltr_score",
          "utility_label",
          "interpretable_score",
          "objective_family",
          "candidate_topology",
          "regime"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_name",
    "schema_version",
    "producer_phase",
    "producer_module_id",
    "pipeline_version",
    "run_id",
    "cycle_id",
    "decision_time",
    "available_at",
    "created_at",
    "lineage_id",
    "content_sha256",
    "record_count",
    "records"
  ],
  "type": "object"
}
