{
  "$id": "hybrid_candidate_score_panel.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_name": {
      "const": "hybrid_candidate_score_panel"
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "type": "string"
    },
    "pipeline_version": {
      "minLength": 1,
      "type": "string"
    },
    "producer_module_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_phase": {
      "minLength": 1,
      "type": "string"
    },
    "record_count": {
      "minimum": 0,
      "type": "integer"
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blend_policy_version": {
            "minLength": 1,
            "type": "string"
          },
          "calibrated_ltr_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate_id": {
            "minLength": 1,
            "type": "string"
          },
          "comparison_group_id": {
            "minLength": 1,
            "type": "string"
          },
          "hybrid_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "hybrid_status": {
            "enum": [
              "HYBRID",
              "SHADOW",
              "INTERPRETABLE_FALLBACK",
              "ABSTAINED"
            ]
          },
          "interpretable_score": {
            "type": "number"
          },
          "lineage_id": {
            "minLength": 1,
            "type": "string"
          },
          "model_hash": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "overall_confidence": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason_code": {
            "minLength": 1,
            "type": "string"
          },
          "runtime_mode": {
            "enum": [
              "INTERPRETABLE_ONLY",
              "LTR_SHADOW",
              "HYBRID_QUALIFIED"
            ]
          }
        },
        "required": [
          "candidate_id",
          "comparison_group_id",
          "interpretable_score",
          "calibrated_ltr_score",
          "hybrid_score",
          "overall_confidence",
          "runtime_mode",
          "hybrid_status",
          "reason_code",
          "blend_policy_version",
          "model_hash",
          "lineage_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_name",
    "schema_version",
    "producer_phase",
    "producer_module_id",
    "pipeline_version",
    "run_id",
    "cycle_id",
    "decision_time",
    "available_at",
    "created_at",
    "lineage_id",
    "content_sha256",
    "record_count",
    "records"
  ],
  "type": "object"
}
