{
  "$id": "ranking_target_policy_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_name": {
      "const": "ranking_target_policy_registry"
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "type": "string"
    },
    "pipeline_version": {
      "minLength": 1,
      "type": "string"
    },
    "producer_module_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_phase": {
      "minLength": 1,
      "type": "string"
    },
    "record_count": {
      "minimum": 0,
      "type": "integer"
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "availability_field": {
            "minLength": 1,
            "type": "string"
          },
          "costs_included": {
            "type": "boolean"
          },
          "denominator": {
            "minLength": 1,
            "type": "string"
          },
          "label_end_field": {
            "minLength": 1,
            "type": "string"
          },
          "policy_version": {
            "minLength": 1,
            "type": "string"
          },
          "raw_direction": {
            "enum": [
              "HIGHER_BETTER",
              "LOWER_BETTER"
            ]
          },
          "semantic_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source_field": {
            "minLength": 1,
            "type": "string"
          },
          "target_id": {
            "minLength": 1,
            "type": "string"
          },
          "transformation": {
            "enum": [
              "IDENTITY",
              "NEGATE",
              "REGRET_TO_BEST"
            ]
          },
          "unit": {
            "minLength": 1,
            "type": "string"
          },
          "utility_multiplier": {
            "type": "number"
          }
        },
        "required": [
          "target_id",
          "source_field",
          "unit",
          "raw_direction",
          "denominator",
          "transformation",
          "utility_multiplier",
          "availability_field",
          "label_end_field",
          "policy_version",
          "costs_included",
          "semantic_hash"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_name",
    "schema_version",
    "producer_phase",
    "producer_module_id",
    "pipeline_version",
    "run_id",
    "cycle_id",
    "decision_time",
    "available_at",
    "created_at",
    "lineage_id",
    "content_sha256",
    "record_count",
    "records"
  ],
  "type": "object"
}
