{
  "$id": "metric_semantics_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_name": {
      "const": "metric_semantics_registry"
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "cycle_id": {
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "type": "string"
    },
    "lineage_id": {
      "type": "string"
    },
    "pipeline_version": {
      "type": "string"
    },
    "producer_module_id": {
      "type": "string"
    },
    "producer_phase": {
      "type": "string"
    },
    "record_count": {
      "minimum": 0,
      "type": "integer"
    },
    "records": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "costs_included": {
                "type": "boolean"
              },
              "denominator": {
                "minLength": 1,
                "type": "string"
              },
              "direction": {
                "enum": [
                  "HIGHER_BETTER",
                  "LOWER_BETTER"
                ]
              },
              "metric_id": {
                "minLength": 1,
                "type": "string"
              },
              "unit": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "metric_id",
              "unit",
              "direction",
              "denominator",
              "costs_included"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "direction": {
                "enum": [
                  "HIGHER_BETTER",
                  "LOWER_BETTER"
                ]
              },
              "metric_id": {
                "minLength": 1,
                "type": "string"
              },
              "scale_id": {
                "minLength": 1,
                "type": "string"
              },
              "semantic_version": {
                "minLength": 1,
                "type": "string"
              },
              "unit": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "metric_id",
              "scale_id",
              "unit",
              "direction",
              "semantic_version"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_name",
    "schema_version",
    "producer_phase",
    "producer_module_id",
    "pipeline_version",
    "run_id",
    "cycle_id",
    "decision_time",
    "available_at",
    "created_at",
    "lineage_id",
    "content_sha256",
    "record_count",
    "records"
  ],
  "title": "Metric Semantics Registry \u2014 Offline Target or Runtime Blend Scale",
  "type": "object"
}
