{
  "$defs": {
    "QualityStatus": {
      "enum": [
        "PASS",
        "DEGRADED",
        "BLOCKED"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "SocietyStateRecord": {
      "additionalProperties": false,
      "properties": {
        "as_of_time": {
          "format": "date-time",
          "title": "As Of Time",
          "type": "string"
        },
        "attention_concentration": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Attention Concentration",
          "type": "number"
        },
        "confidence_dispersion": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Dispersion",
          "type": "number"
        },
        "coverage_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage Ratio",
          "type": "number"
        },
        "cycle_id": {
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "evidence_diversity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Diversity",
          "type": "number"
        },
        "horizon": {
          "minLength": 1,
          "title": "Horizon",
          "type": "string"
        },
        "information_asymmetry": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Information Asymmetry",
          "type": "number"
        },
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "proposition_id": {
          "minLength": 1,
          "title": "Proposition Id",
          "type": "string"
        },
        "quality_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Quality Reasons",
          "type": "array"
        },
        "quality_status": {
          "$ref": "#/$defs/QualityStatus"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "source_quality_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Quality Score",
          "type": "number"
        },
        "underlying_id": {
          "minLength": 1,
          "title": "Underlying Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "cycle_id",
        "as_of_time",
        "underlying_id",
        "proposition_id",
        "horizon",
        "confidence_dispersion",
        "evidence_diversity",
        "attention_concentration",
        "information_asymmetry",
        "coverage_ratio",
        "source_quality_score",
        "quality_status",
        "lineage_id"
      ],
      "title": "SocietyStateRecord",
      "type": "object"
    }
  },
  "$id": "https://example.invalid/p3/s30/validated_society_state_panel.input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "as_of_time": {
      "format": "date-time",
      "title": "As Of Time",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "title": "Lineage Id",
      "type": "string"
    },
    "pipeline_version": {
      "minLength": 1,
      "title": "Pipeline Version",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/SocietyStateRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "created_at",
    "lineage_id",
    "pipeline_version",
    "run_id",
    "cycle_id",
    "as_of_time",
    "records"
  ],
  "title": "ValidatedSocietyStatePanel",
  "type": "object"
}
