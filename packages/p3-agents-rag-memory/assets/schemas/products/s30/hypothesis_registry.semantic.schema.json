{
  "$defs": {
    "HypothesisRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "as_of_time": {
          "format": "date-time",
          "title": "As Of Time",
          "type": "string"
        },
        "context_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Context Evidence Refs",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_count": {
          "minimum": 0,
          "title": "Evidence Count",
          "type": "integer"
        },
        "falsification_criterion": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Falsification Criterion",
          "type": "string"
        },
        "horizon": {
          "minLength": 1,
          "title": "Horizon",
          "type": "string"
        },
        "hypothesis_id": {
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "hypothesis_text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Hypothesis Text",
          "type": "string"
        },
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "matures_at": {
          "format": "date-time",
          "title": "Matures At",
          "type": "string"
        },
        "opposing_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Opposing Evidence Refs",
          "type": "array"
        },
        "pipeline_version": {
          "minLength": 1,
          "title": "Pipeline Version",
          "type": "string"
        },
        "proposition_id": {
          "minLength": 1,
          "title": "Proposition Id",
          "type": "string"
        },
        "quality_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Quality Reasons",
          "type": "array"
        },
        "quality_status": {
          "$ref": "#/$defs/QualityStatus"
        },
        "required_observable": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Required Observable",
          "type": "string"
        },
        "source_quality_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Quality Score",
          "type": "number"
        },
        "supporting_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Refs",
          "type": "array"
        },
        "underlying_id": {
          "minLength": 1,
          "title": "Underlying Id",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "artifact_id",
        "created_at",
        "as_of_time",
        "matures_at",
        "underlying_id",
        "proposition_id",
        "horizon",
        "hypothesis_text",
        "supporting_evidence_refs",
        "opposing_evidence_refs",
        "context_evidence_refs",
        "evidence_count",
        "source_quality_score",
        "falsification_criterion",
        "required_observable",
        "quality_status",
        "quality_reasons",
        "lineage_id",
        "pipeline_version"
      ],
      "title": "HypothesisRecord",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "PASS",
        "DEGRADED",
        "BLOCKED"
      ],
      "title": "QualityStatus",
      "type": "string"
    }
  },
  "$id": "https://example.invalid/p3/s30/hypothesis_registry.semantic.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "as_of_time": {
      "format": "date-time",
      "title": "As Of Time",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "title": "Lineage Id",
      "type": "string"
    },
    "pipeline_version": {
      "minLength": 1,
      "title": "Pipeline Version",
      "type": "string"
    },
    "quality_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Quality Reasons",
      "type": "array"
    },
    "quality_status": {
      "$ref": "#/$defs/QualityStatus"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/HypothesisRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_id": {
      "minLength": 1,
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "created_at",
    "lineage_id",
    "pipeline_version",
    "run_id",
    "cycle_id",
    "as_of_time",
    "schema_id",
    "schema_version",
    "quality_status",
    "records"
  ],
  "title": "HypothesisRegistry",
  "type": "object"
}
