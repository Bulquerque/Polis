{
  "$defs": {
    "CompanyMode": {
      "enum": [
        "QUICK_CHECK",
        "STANDARD_REVIEW",
        "DEEP_QUALITATIVE",
        "ACCOUNTING_QUALITY",
        "FORENSIC"
      ],
      "title": "CompanyMode",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entity_id": {
      "minLength": 1,
      "title": "Entity Id",
      "type": "string"
    },
    "include_withdrawn": {
      "default": false,
      "title": "Include Withdrawn",
      "type": "boolean"
    },
    "metric_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Metric Ids",
      "type": "array"
    },
    "research_mode": {
      "$ref": "#/$defs/CompanyMode",
