{
  "$defs": {
    "CompanyMode": {
      "enum": [
        "QUICK_CHECK",
        "STANDARD_REVIEW",
        "DEEP_QUALITATIVE",
        "ACCOUNTING_QUALITY",
        "FORENSIC"
      ],
      "title": "CompanyMode",
      "type": "string"
    },
    "ExtensionLineage": {
      "additionalProperties": false,
      "properties": {
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "producer_module_id": {
          "pattern": "^P3\\.S38\\.M\\d{2}$",
          "title": "Producer Module Id",
          "type": "string"
        },
        "source_artifact_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Artifact Ids",
          "type": "array"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "transformation_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Transformation Ids",
          "type": "array"
        }
      },
      "required": [
        "lineage_id",
        "producer_module_id"
      ],
      "title": "ExtensionLineage",
      "type": "object"
    },
    "ReadinessRecord": {
      "additionalProperties": false,
      "properties": {
        "available_view_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Available View Ids",
          "type": "array"
        },
        "missing_view_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing View Ids",
          "type": "array"
        },
        "mode_id": {
          "$ref": "#/$defs/CompanyMode"
        },
        "operation_id": {
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "required_view_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required View Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ReadinessStatus"
        },
        "version_history_required": {
          "default": false,
          "title": "Version History Required",
          "type": "boolean"
        }
      },
      "required": [
        "operation_id",
        "mode_id",
        "status"
      ],
      "title": "ReadinessRecord",
      "type": "object"
    },
    "ReadinessStatus": {
      "enum": [
        "AVAILABLE",
        "DEGRADED",
        "BLOCKED_UPSTREAM"
      ],
      "title": "ReadinessStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lineage": {
      "$ref": "#/$defs/ExtensionLineage"
    },
    "panel_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Panel Hash",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ReadinessRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "p3.s38.v1",
      "default": "p3.s38.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "records",
    "lineage",
    "panel_hash"
  ],
  "title": "CompanyOperationReadinessPanel",
  "type": "object"
}
