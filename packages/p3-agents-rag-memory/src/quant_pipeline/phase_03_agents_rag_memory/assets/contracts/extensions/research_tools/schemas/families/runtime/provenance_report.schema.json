{
  "$defs": {
    "ProvenanceEvidence": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "p1_raw_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P1 Raw Artifact Id"
        },
        "p2_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P2 Artifact Id"
        },
        "p2_lineage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P2 Lineage Id"
        },
        "p2_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P2 Record Id"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_quality": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Quality",
          "type": "number"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "available_at",
        "content_hash"
      ],
      "title": "ProvenanceEvidence",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/ProvenanceEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "lineage_complete": {
      "title": "Lineage Complete",
      "type": "boolean"
    },
    "provenance_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provenance Hash",
      "type": "string"
    },
    "source_count": {
      "minimum": 0,
      "title": "Source Count",
      "type": "integer"
    },
    "source_families": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Source Families",
      "type": "array"
    }
  },
  "required": [
    "evidence",
    "source_families",
    "source_count",
    "lineage_complete",
    "provenance_hash"
  ],
  "title": "ProvenanceReport",
  "type": "object"
}
