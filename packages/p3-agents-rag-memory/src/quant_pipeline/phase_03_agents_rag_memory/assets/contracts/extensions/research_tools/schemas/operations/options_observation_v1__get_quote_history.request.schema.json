{
  "$id": "https://quant-pipeline.local/schema/p3/research-tools/options.observation.v1/get_quote_history/request/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Contract Ids",
      "type": "array"
    },
    "end_time": {
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "frequency": {
      "minLength": 1,
      "title": "Frequency",
      "type": "string"
    },
    "research_mode": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Research Mode",
      "type": "string"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    }
  },
  "required": [
    "research_mode",
    "contract_ids",
    "start_time",
    "end_time",
    "frequency"
  ],
  "title": "GetOptionQuoteHistoryRequest",
  "type": "object"
}
