{
  "$defs": {
    "ProvenanceEvidence": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "p1_raw_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P1 Raw Artifact Id"
        },
        "p2_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P2 Artifact Id"
        },
        "p2_lineage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P2 Lineage Id"
        },
        "p2_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P2 Record Id"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_quality": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Quality",
          "type": "number"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "available_at",
        "content_hash"
      ],
      "title": "ProvenanceEvidence",
      "type": "object"
    },
    "S40Lineage": {
      "additionalProperties": false,
      "properties": {
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "producer_module_id": {
          "pattern": "^P3\\.S40\\.M\\d{2}$",
          "title": "Producer Module Id",
          "type": "string"
        },
        "source_artifact_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Artifact Ids",
          "type": "array"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "transformation_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Transformation Ids",
          "type": "array"
        }
      },
      "required": [
        "lineage_id",
        "producer_module_id"
      ],
      "title": "S40Lineage",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lineage": {
      "$ref": "#/$defs/S40Lineage"
    },
    "map_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Map Hash",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ProvenanceEvidence"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "p3.s40.v1",
      "default": "p3.s40.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "records",
    "lineage",
    "map_hash"
  ],
  "title": "ResearchToolEvidenceMap",
  "type": "object"
}
