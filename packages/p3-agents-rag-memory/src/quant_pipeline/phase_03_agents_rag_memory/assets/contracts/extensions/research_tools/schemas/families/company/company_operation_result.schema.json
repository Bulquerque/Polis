{
  "$defs": {
    "CompanyMode": {
      "enum": [
        "QUICK_CHECK",
        "STANDARD_REVIEW",
        "DEEP_QUALITATIVE",
        "ACCOUNTING_QUALITY",
        "FORENSIC"
      ],
      "title": "CompanyMode",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "p2_artifact_id": {
          "minLength": 1,
          "title": "P2 Artifact Id",
          "type": "string"
        },
        "p2_record_id": {
          "minLength": 1,
          "title": "P2 Record Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_quality": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Quality",
          "type": "number"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "p2_artifact_id",
        "p2_record_id",
        "available_at",
        "content_hash"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "JsonValue": {},
    "OperationCoverage": {
      "additionalProperties": false,
      "properties": {
        "missing_requirements": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Requirements",
          "type": "array"
        },
        "records_rejected_future": {
          "minimum": 0,
          "title": "Records Rejected Future",
          "type": "integer"
        },
        "records_rejected_quality": {
          "default": 0,
          "minimum": 0,
          "title": "Records Rejected Quality",
          "type": "integer"
        },
        "records_requested": {
          "minimum": 0,
          "title": "Records Requested",
          "type": "integer"
        },
        "records_used": {
          "minimum": 0,
          "title": "Records Used",
          "type": "integer"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "score",
        "records_requested",
        "records_used",
        "records_rejected_future"
      ],
      "title": "OperationCoverage",
      "type": "object"
    },
    "OutcomeStatus": {
      "enum": [
        "PASS",
        "EMPTY_VALID",
        "DEGRADED",
        "BLOCKED_UPSTREAM"
      ],
      "title": "OutcomeStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cost_units": {
      "default": 1,
      "minimum": 0,
      "title": "Cost Units",
      "type": "integer"
    },
    "coverage": {
      "$ref": "#/$defs/OperationCoverage"
    },
    "diagnostics": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "downgrade_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Downgrade Reason"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "executed_mode": {
      "$ref": "#/$defs/CompanyMode"
    },
    "latest_available_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Available At"
    },
    "method_id": {
      "minLength": 1,
      "title": "Method Id",
      "type": "string"
    },
    "method_version": {
      "default": "1.0.0",
      "minLength": 1,
      "title": "Method Version",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metrics",
      "type": "object"
    },
    "operation_id": {
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "outcome_status": {
      "$ref": "#/$defs/OutcomeStatus"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "records": {
      "default": [],
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "title": "Records",
      "type": "array"
    },
    "requested_mode": {
      "$ref": "#/$defs/CompanyMode"
    },
    "result_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Result Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "p3.s38.v1",
      "default": "p3.s38.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_id": {
      "const": "company.fundamentals.v1",
      "default": "company.fundamentals.v1",
      "title": "Tool Id",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "requested_mode",
    "executed_mode",
    "outcome_status",
    "method_id",
    "coverage",
    "result_hash"
  ],
  "title": "CompanyOperationResult",
  "type": "object"
}
