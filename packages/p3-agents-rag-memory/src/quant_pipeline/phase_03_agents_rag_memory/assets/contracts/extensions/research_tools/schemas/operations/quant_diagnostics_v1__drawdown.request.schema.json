{
  "$id": "https://quant-pipeline.local/schema/p3/research-tools/quant.diagnostics.v1/drawdown/request/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "end_time": {
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "frequency": {
      "minLength": 1,
      "title": "Frequency",
      "type": "string"
    },
    "include_recovery": {
      "default": true,
      "title": "Include Recovery",
      "type": "boolean"
    },
    "instrument_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Instrument Ids",
      "type": "array"
    },
    "research_mode": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Research Mode",
      "type": "string"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    }
  },
  "required": [
    "research_mode",
    "instrument_ids",
    "start_time",
    "end_time",
    "frequency"
  ],
  "title": "DrawdownRequest",
  "type": "object"
}
