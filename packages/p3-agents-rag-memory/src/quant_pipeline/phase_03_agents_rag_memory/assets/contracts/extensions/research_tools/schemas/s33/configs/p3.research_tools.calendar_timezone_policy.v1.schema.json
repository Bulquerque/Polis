{
  "$id": "https://quant-pipeline.local/schema/p3.research_tools.calendar_timezone_policy.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_timezone": {
      "minLength": 1,
      "title": "Canonical Timezone",
      "type": "string"
    },
    "date_only_timezone": {
      "minLength": 1,
      "title": "Date Only Timezone",
      "type": "string"
    },
    "naive_datetime_action": {
      "const": "REJECT",
      "default": "REJECT",
      "title": "Naive Datetime Action",
      "type": "string"
    },
    "normalize_to_utc": {
      "const": true,
      "default": true,
      "title": "Normalize To Utc",
      "type": "boolean"
    },
    "schema_id": {
      "const": "p3.research_tools.calendar_timezone_policy.v1",
      "default": "p3.research_tools.calendar_timezone_policy.v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "canonical_timezone",
    "date_only_timezone"
  ],
  "title": "CalendarTimezonePolicyConfig",
  "type": "object"
}
