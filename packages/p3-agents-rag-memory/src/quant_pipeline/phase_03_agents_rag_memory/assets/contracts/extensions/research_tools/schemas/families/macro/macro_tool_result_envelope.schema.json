{
  "$defs": {
    "CoverageReport": {
      "additionalProperties": false,
      "properties": {
        "missing_dimensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Dimensions",
          "type": "array"
        },
        "missing_series": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Series",
          "type": "array"
        },
        "records_requested": {
          "minimum": 0,
          "title": "Records Requested",
          "type": "integer"
        },
        "records_returned": {
          "minimum": 0,
          "title": "Records Returned",
          "type": "integer"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "series_requested": {
          "minimum": 0,
          "title": "Series Requested",
          "type": "integer"
        },
        "series_returned": {
          "minimum": 0,
          "title": "Series Returned",
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "score",
        "records_requested",
        "records_returned",
        "series_requested",
        "series_returned"
      ],
      "title": "CoverageReport",
      "type": "object"
    },
    "ExecutionReport": {
      "additionalProperties": false,
      "properties": {
        "cost_units": {
          "minimum": 0.0,
          "title": "Cost Units",
          "type": "number"
        },
        "deterministic": {
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "internal_subquery_count": {
          "minimum": 0,
          "title": "Internal Subquery Count",
          "type": "integer"
        },
        "records_returned": {
          "minimum": 0,
          "title": "Records Returned",
          "type": "integer"
        },
        "records_scanned": {
          "minimum": 0,
          "title": "Records Scanned",
          "type": "integer"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "cost_units",
        "internal_subquery_count",
        "records_scanned",
        "records_returned"
      ],
      "title": "ExecutionReport",
      "type": "object"
    },
    "JsonValue": {},
    "MacroEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "p2_artifact_id": {
          "minLength": 1,
          "title": "P2 Artifact Id",
          "type": "string"
        },
        "p2_lineage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P2 Lineage Id"
        },
        "p2_record_id": {
          "minLength": 1,
          "title": "P2 Record Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_quality": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Quality",
          "type": "number"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "p2_artifact_id",
        "p2_record_id",
        "available_at",
        "content_hash"
      ],
      "title": "MacroEvidenceRef",
      "type": "object"
    },
    "OutcomeStatus": {
      "enum": [
        "PASS",
        "EMPTY_VALID",
        "DEGRADED",
        "BLOCKED_UPSTREAM"
      ],
      "title": "OutcomeStatus",
      "type": "string"
    },
    "PitQueryProof": {
      "additionalProperties": false,
      "properties": {
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "earliest_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earliest Available At"
        },
        "input_hashes": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "latest_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Available At"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "proof_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Proof Hash",
          "type": "string"
        },
        "records_rejected_filter": {
          "minimum": 0,
          "title": "Records Rejected Filter",
          "type": "integer"
        },
        "records_rejected_future": {
          "minimum": 0,
          "title": "Records Rejected Future",
          "type": "integer"
        },
        "records_rejected_missing_time": {
          "minimum": 0,
          "title": "Records Rejected Missing Time",
          "type": "integer"
        },
        "records_scanned": {
          "minimum": 0,
          "title": "Records Scanned",
          "type": "integer"
        },
        "records_visible": {
          "minimum": 0,
          "title": "Records Visible",
          "type": "integer"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "vintage_policy": {
          "minLength": 1,
          "title": "Vintage Policy",
          "type": "string"
        }
      },
      "required": [
        "policy_version",
        "decision_time",
        "vintage_policy",
        "records_scanned",
        "records_visible",
        "records_rejected_future",
        "records_rejected_missing_time",
        "records_rejected_filter",
        "snapshot_id",
        "input_hashes",
        "proof_hash"
      ],
      "title": "PitQueryProof",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "$ref": "#/$defs/CoverageReport"
    },
    "downgrade_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Downgrade Reason"
    },
    "envelope_version": {
      "default": "1.0.0",
      "title": "Envelope Version",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/MacroEvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "executed_mode": {
      "minLength": 1,
      "title": "Executed Mode",
      "type": "string"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionReport"
    },
    "operation_id": {
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "outcome_status": {
      "$ref": "#/$defs/OutcomeStatus"
    },
    "pit_proof": {
      "$ref": "#/$defs/PitQueryProof"
    },
    "provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Provenance",
      "type": "object"
    },
    "records": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "title": "Records",
      "type": "array"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "requested_mode": {
      "minLength": 1,
      "title": "Requested Mode",
      "type": "string"
    },
    "result_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Result Hash",
      "type": "string"
    },
    "tool_id": {
      "default": "macro.observation.v1",
      "minLength": 1,
      "title": "Tool Id",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "request_id",
    "outcome_status",
    "requested_mode",
    "executed_mode",
    "records",
    "evidence_refs",
    "coverage",
    "provenance",
    "pit_proof",
    "execution",
    "result_hash"
  ],
  "title": "MacroToolResultEnvelope",
  "type": "object"
}
