{
  "$defs": {
    "CompanyMode": {
      "enum": [
        "QUICK_CHECK",
        "STANDARD_REVIEW",
        "DEEP_QUALITATIVE",
        "ACCOUNTING_QUALITY",
        "FORENSIC"
      ],
      "title": "CompanyMode",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_classes": {
      "default": [
        "DOCUMENTED",
        "CANONICAL"
      ],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Authority Classes",
      "type": "array"
    },
    "entity_id": {
      "minLength": 1,
      "title": "Entity Id",
      "type": "string"
    },
    "maximum_peers": {
      "default": 10,
      "maximum": 50,
      "minimum": 1,
      "title": "Maximum Peers",
      "type": "integer"
    },
    "research_mode": {
      "$ref": "#/$defs/CompanyMode",
      "default": "QUICK_CHECK"
    },
    "view_id": {
      "default": "company_peers",
      "minLength": 1,
      "title": "View Id",
      "type": "string"
    }
  },
  "required": [
    "entity_id"
  ],
  "title": "GetPeersRequest",
  "type": "object"
}
