{
  "$defs": {
    "QualificationStatus": {
      "enum": [
        "QUALIFIED_LOCAL",
        "DEGRADED",
        "BLOCKED_UPSTREAM",
        "FAILED"
      ],
      "title": "QualificationStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_tests_passed": {
      "default": 0,
      "minimum": 0,
      "title": "Contract Tests Passed",
      "type": "integer"
    },
    "handler_id": {
      "minLength": 1,
      "title": "Handler Id",
      "type": "string"
    },
    "integration_tests_passed": {
      "default": 0,
      "minimum": 0,
      "title": "Integration Tests Passed",
      "type": "integer"
    },
    "leakage_tests_passed": {
      "default": 0,
      "minimum": 0,
      "title": "Leakage Tests Passed",
      "type": "integer"
    },
    "mode_id": {
      "minLength": 1,
      "title": "Mode Id",
      "type": "string"
    },
    "operation_id": {
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "replay_tests_passed": {
      "default": 0,
      "minimum": 0,
      "title": "Replay Tests Passed",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/QualificationStatus"
    },
    "tool_id": {
      "minLength": 1,
      "title": "Tool Id",
      "type": "string"
    }
  },
  "required": [
    "tool_id",
    "operation_id",
    "mode_id",
    "status",
    "handler_id"
  ],
  "title": "OperationModeQualificationRecord",
  "type": "object"
}
