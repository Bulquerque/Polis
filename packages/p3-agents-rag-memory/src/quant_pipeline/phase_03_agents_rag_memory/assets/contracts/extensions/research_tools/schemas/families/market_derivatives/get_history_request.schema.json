{
  "$defs": {
    "AdjustmentPolicy": {
      "enum": [
        "RAW",
        "PIT_SPLIT_ADJUSTED",
        "PIT_TOTAL_RETURN"
      ],
      "title": "AdjustmentPolicy",
      "type": "string"
    },
    "MarketMode": {
      "enum": [
        "OBSERVE",
        "DIAGNOSTIC",
        "STRUCTURAL"
      ],
      "title": "MarketMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjustment_policy": {
      "$ref": "#/$defs/AdjustmentPolicy",
      "default": "RAW"
    },
    "end_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Date"
    },
    "instrument_id": {
      "minLength": 1,
      "title": "Instrument Id",
      "type": "string"
    },
    "max_records": {
      "default": 252,
      "maximum": 5000,
      "minimum": 1,
      "title": "Max Records",
      "type": "integer"
    },
    "research_mode": {
      "$ref": "#/$defs/MarketMode",
      "default": "OBSERVE"
    },
    "start_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start Date"
    }
  },
  "required": [
    "instrument_id"
  ],
  "title": "GetHistoryRequest",
  "type": "object"
}
