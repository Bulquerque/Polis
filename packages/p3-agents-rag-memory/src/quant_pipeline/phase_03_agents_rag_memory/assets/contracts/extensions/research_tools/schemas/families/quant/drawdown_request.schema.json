    "QuantMode": {
      "enum": [
        "BASIC",
        "ROBUST",
        "STABILITY"
      ],
      "title": "QuantMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "end_time": {
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "instrument_id": {
      "minLength": 1,
      "title": "Instrument Id",
      "type": "string"
    },
    "research_mode": {
      "$ref": "#/$defs/QuantMode",
      "default": "BASIC"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    },
    "view_id": {
      "default": "market_prices",
      "minLength": 1,
      "title": "View Id",
      "type": "string"
    },
    "wealth_start": {
      "default": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Wealth Start",
      "type": "number"
    }
