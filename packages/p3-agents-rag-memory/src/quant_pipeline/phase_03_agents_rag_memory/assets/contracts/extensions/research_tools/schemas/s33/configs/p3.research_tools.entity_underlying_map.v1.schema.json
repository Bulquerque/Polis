{
  "$defs": {
    "EntityMapRecordConfig": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "entity_id": {
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "identifiers": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Identifiers",
          "type": "object"
        },
        "instrument_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instrument Id"
        },
        "instrument_type": {
          "minLength": 1,
          "title": "Instrument Type",
          "type": "string"
        },
        "ticker": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ticker"
        },
        "underlying_instrument_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Underlying Instrument Id"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "venue": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        }
      },
      "required": [
        "entity_id",
        "instrument_type"
      ],
      "title": "EntityMapRecordConfig",
      "type": "object"
    }
  },
  "$id": "https://quant-pipeline.local/schema/p3.research_tools.entity_underlying_map.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fuzzy_matching_enabled": {
      "default": false,
      "title": "Fuzzy Matching Enabled",
      "type": "boolean"
    },
    "identifier_namespaces": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Identifier Namespaces",
      "type": "array"
    },
    "minimum_probabilistic_confidence": {
      "default": 0.95,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Minimum Probabilistic Confidence",
      "type": "number"
    },
    "records": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EntityMapRecordConfig"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_id": {
      "const": "p3.research_tools.entity_underlying_map.v1",
      "default": "p3.research_tools.entity_underlying_map.v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "identifier_namespaces"
  ],
  "title": "EntityUnderlyingMapConfig",
  "type": "object"
}
