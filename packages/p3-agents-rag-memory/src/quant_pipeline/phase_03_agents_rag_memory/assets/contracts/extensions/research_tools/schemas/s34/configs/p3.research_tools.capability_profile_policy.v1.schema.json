{
  "$defs": {
    "AccessClassRule": {
      "additionalProperties": false,
      "properties": {
        "accepted_data_classes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Accepted Data Classes",
          "type": "array"
        },
        "accepted_institutions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Accepted Institutions",
          "type": "array"
        },
        "accepted_resource_labels": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Accepted Resource Labels",
          "type": "array"
        },
        "capability_id": {
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "default_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Default Score",
          "type": "number"
        },
        "score_when_matched": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score When Matched",
          "type": "number"
        }
      },
      "required": [
        "capability_id"
      ],
      "title": "AccessClassRule",
      "type": "object"
    },
    "CapabilitySourceRule": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "constraint_adjustments": {
          "additionalProperties": {
            "maximum": 1.0,
            "minimum": -1.0,
            "type": "number"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Constraint Adjustments",
          "type": "object"
        },
        "default_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Default Score",
          "type": "number"
        },
        "institution_adjustments": {
          "additionalProperties": {
            "maximum": 1.0,
            "minimum": -1.0,
            "type": "number"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Institution Adjustments",
          "type": "object"
        },
        "resource_adjustments": {
          "additionalProperties": {
            "maximum": 1.0,
            "minimum": -1.0,
            "type": "number"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Resource Adjustments",
          "type": "object"
        },
        "role_adjustments": {
          "additionalProperties": {
            "maximum": 1.0,
            "minimum": -1.0,
            "type": "number"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Role Adjustments",
          "type": "object"
        },
        "source_capability_weights": {
          "additionalProperties": {
            "maximum": 2.0,
            "minimum": 0.0,
            "type": "number"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Source Capability Weights",
          "type": "object"
        }
      },
      "required": [
        "capability_id"
      ],
      "title": "CapabilitySourceRule",
      "type": "object"
    },
    "ResourceResolutionRule": {
      "additionalProperties": false,
      "properties": {
        "accepted_resource_labels": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Accepted Resource Labels",
          "type": "array"
        },
        "default_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Default Score",
          "type": "number"
        },
        "numeric_limit_by_label": {
          "additionalProperties": {
            "minimum": 0.0,
            "type": "number"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Numeric Limit By Label",
          "type": "object"
        },
        "resource_id": {
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "source_capability_keys": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Capability Keys",
          "type": "array"
        }
      },
      "required": [
        "resource_id"
      ],
      "title": "ResourceResolutionRule",
      "type": "object"
    }
  },
  "$id": "https://quant-pipeline.local/schema/p3.research_tools.capability_profile_policy.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_rules": {
      "items": {
        "$ref": "#/$defs/AccessClassRule"
      },
      "title": "Access Rules",
      "type": "array"
    },
    "capability_rules": {
      "items": {
        "$ref": "#/$defs/CapabilitySourceRule"
      },
      "title": "Capability Rules",
      "type": "array"
    },
    "forbidden_source_fields": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Forbidden Source Fields",
      "type": "array"
    },
    "level_thresholds": {
      "additionalProperties": {
        "maximum": 1.0,
        "minimum": 0.0,
        "type": "number"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Level Thresholds",
      "type": "object"
    },
    "max_calls_per_cycle": {
      "default": 5,
      "maximum": 5,
      "minimum": 0,
      "title": "Max Calls Per Cycle",
      "type": "integer"
    },
    "max_cost_units_per_cycle": {
      "default": 100,
      "maximum": 10000,
      "minimum": 0,
      "title": "Max Cost Units Per Cycle",
      "type": "integer"
    },
    "minimum_population_coverage": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Minimum Population Coverage",
      "type": "number"
    },
    "policy_version": {
      "default": "1.0.0",
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "resource_rules": {
      "items": {
        "$ref": "#/$defs/ResourceResolutionRule"
      },
      "title": "Resource Rules",
      "type": "array"
    },
    "schema_id": {
      "const": "p3.research_tools.capability_profile_policy.v1",
      "default": "p3.research_tools.capability_profile_policy.v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "forbidden_source_fields",
    "level_thresholds",
    "capability_rules",
    "access_rules",
    "resource_rules"
  ],
  "title": "CapabilityProfilePolicyConfig",
  "type": "object"
}
