{
  "$id": "https://quant-pipeline.local/schema/p3/research-tools/quant.diagnostics.v1/realized_volatility/request/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annualization_factor": {
      "default": 252.0,
      "exclusiveMinimum": 0.0,
      "title": "Annualization Factor",
      "type": "number"
    },
    "end_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Time"
    },
    "estimator": {
      "default": "standard_deviation",
      "minLength": 1,
      "title": "Estimator",
      "type": "string"
    },
    "frequency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frequency"
    },
    "instrument_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Instrument Ids",
      "type": "array"
    },
    "research_mode": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Research Mode",
      "type": "string"
    },
    "returns": {
      "default": [],
      "items": {
        "type": "number"
      },
      "title": "Returns",
      "type": "array"
    },
    "start_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start Time"
    }
  },
  "required": [
    "research_mode"
  ],
  "title": "RealizedVolatilityRequest",
  "type": "object"
}
