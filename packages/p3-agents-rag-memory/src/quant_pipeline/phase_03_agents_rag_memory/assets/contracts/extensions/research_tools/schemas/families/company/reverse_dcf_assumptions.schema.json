{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_free_cash_flow": {
      "title": "Base Free Cash Flow",
      "type": "number"
    },
    "discount_rate": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Discount Rate",
      "type": "number"
    },
    "forecast_years": {
      "default": 5,
      "maximum": 20,
      "minimum": 1,
      "title": "Forecast Years",
      "type": "integer"
    },
    "iterations": {
      "default": 80,
      "maximum": 200,
      "minimum": 10,
      "title": "Iterations",
      "type": "integer"
    },
    "lower_growth": {
      "default": -0.5,
      "title": "Lower Growth",
      "type": "number"
    },
    "market_price": {
      "exclusiveMinimum": 0.0,
      "title": "Market Price",
      "type": "number"
    },
    "net_debt": {
      "default": 0.0,
      "title": "Net Debt",
      "type": "number"
    },
    "shares_outstanding": {
      "default": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Shares Outstanding",
      "type": "number"
    },
    "terminal_growth_rate": {
      "exclusiveMaximum": 0.2,
      "minimum": -0.2,
      "title": "Terminal Growth Rate",
      "type": "number"
    },
    "upper_growth": {
      "default": 1.0,
      "title": "Upper Growth",
      "type": "number"
    }
  },
  "required": [
    "market_price",
    "base_free_cash_flow",
    "discount_rate",
    "terminal_growth_rate"
  ],
  "title": "ReverseDcfAssumptions",
  "type": "object"
}
