{
  "$defs": {
    "CapabilityDefinition": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "DOMAIN",
            "METHOD",
            "ACCESS",
            "RESOURCE"
          ],
          "title": "Category",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "category",
        "description"
      ],
      "title": "CapabilityDefinition",
      "type": "object"
    }
  },
  "$id": "https://quant-pipeline.local/schema/p3.research_tools.capability_taxonomy_config.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityDefinition"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "schema_id": {
      "const": "p3.research_tools.capability_taxonomy_config.v1",
      "default": "p3.research_tools.capability_taxonomy_config.v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "capabilities"
  ],
  "title": "ResearchCapabilityTaxonomyConfig",
  "type": "object"
}
