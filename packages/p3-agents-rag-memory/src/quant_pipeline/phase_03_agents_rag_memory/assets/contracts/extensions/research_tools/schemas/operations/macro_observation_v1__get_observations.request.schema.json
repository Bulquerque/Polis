{
  "$id": "https://quant-pipeline.local/schema/p3/research-tools/macro.observation.v1/get_observations/request/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "end_time": {
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "research_mode": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Research Mode",
      "type": "string"
    },
    "series_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Series Ids",
      "type": "array"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    },
    "transformations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Transformations",
      "type": "array"
    },
    "vintage_policy": {
      "default": "KNOWN_AT_DECISION_TIME",
      "enum": [
        "KNOWN_AT_DECISION_TIME",
        "ORIGINAL_RELEASE",
        "LATEST_KNOWN_AT_DECISION_TIME"
      ],
      "title": "Vintage Policy",
      "type": "string"
    }
  },
  "required": [
    "research_mode",
    "series_ids",
    "start_time",
    "end_time"
  ],
  "title": "GetMacroObservationsRequest",
  "type": "object"
}
