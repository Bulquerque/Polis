    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "event_view_id": {
      "default": "events",
      "minLength": 1,
      "title": "Event View Id",
      "type": "string"
    },
    "instrument_id": {
      "minLength": 1,
      "title": "Instrument Id",
      "type": "string"
    },
    "market_view_id": {
      "default": "market_prices",
      "minLength": 1,
      "title": "Market View Id",
      "type": "string"
    },
    "placebo_offsets": {
      "default": [],
