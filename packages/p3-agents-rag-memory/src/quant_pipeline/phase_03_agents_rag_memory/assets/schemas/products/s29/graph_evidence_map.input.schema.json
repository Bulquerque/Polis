{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quant.local/p3/s29/input/graph-evidence-map/1.0.0",
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "RAG_CHUNK",
        "GRAPH_PATH",
        "TOOL_RESULT",
        "MEMORY_ITEM",
        "DOCUMENT"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "graph_path_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Path Id"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "event_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Time"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "source_quality_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Quality Score",
          "type": "number"
        },
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_kind",
        "source_id",
        "content_hash",
        "available_at",
        "source_quality_score",
        "lineage_id"
      ],
      "title": "EvidenceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "title": "Lineage Id",
      "type": "string"
    },
    "pipeline_version": {
      "minLength": 1,
      "title": "Pipeline Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "as_of_time": {
      "format": "date-time",
      "title": "As Of Time",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "created_at",
    "lineage_id",
    "pipeline_version",
    "run_id",
    "cycle_id",
    "as_of_time",
    "records"
  ],
  "title": "GraphEvidenceMap",
  "type": "object"
}
