{
  "$id": "https://quant-pipeline.local/schema/p3/research-tools/quant.diagnostics.v1/entropy/request/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bins": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 2,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bins"
    },
    "end_time": {
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "frequency": {
      "minLength": 1,
      "title": "Frequency",
      "type": "string"
    },
    "instrument_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Instrument Ids",
      "type": "array"
    },
    "method": {
      "default": "SHANNON",
      "enum": [
        "SHANNON",
        "PERMUTATION"
      ],
      "title": "Method",
      "type": "string"
    },
    "research_mode": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Research Mode",
      "type": "string"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    }
  },
  "required": [
    "research_mode",
    "instrument_ids",
    "start_time",
    "end_time",
    "frequency"
  ],
  "title": "EntropyRequest",
  "type": "object"
}
