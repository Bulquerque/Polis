{
  "$id": "https://quant-pipeline.local/schema/p3/research-tools/research.corpus.v1/inspect_provenance/request/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "research_mode": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Research Mode",
      "type": "string"
    }
  },
  "required": [
    "research_mode",
    "evidence_ids"
  ],
  "title": "InspectProvenanceRequest",
  "type": "object"
}
