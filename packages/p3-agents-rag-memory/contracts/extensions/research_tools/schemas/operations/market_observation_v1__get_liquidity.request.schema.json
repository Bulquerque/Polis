{
  "$id": "https://quant-pipeline.local/schema/p3/research-tools/market.observation.v1/get_liquidity/request/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "frequency": {
      "default": "1d",
      "minLength": 1,
      "title": "Frequency",
      "type": "string"
    },
    "instrument_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Instrument Ids",
      "type": "array"
    },
    "lookback_observations": {
      "default": 60,
      "maximum": 100000,
      "minimum": 1,
      "title": "Lookback Observations",
      "type": "integer"
    },
    "metrics": {
      "default": [
        "volume",
        "turnover"
      ],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Metrics",
      "type": "array"
    },
    "research_mode": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Research Mode",
      "type": "string"
    }
  },
  "required": [
    "research_mode",
    "instrument_ids"
  ],
  "title": "MarketLiquidityRequest",
  "type": "object"
}
