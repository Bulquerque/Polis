{
  "$id": "https://quant-pipeline.local/schema/p3/research-tools/options.observation.v1/get_contracts/request/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expiry_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expiry From"
    },
    "expiry_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expiry To"
    },
    "option_types": {
      "default": [],
      "items": {
        "enum": [
          "CALL",
          "PUT"
        ],
        "type": "string"
      },
      "title": "Option Types",
      "type": "array"
    },
    "research_mode": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Research Mode",
      "type": "string"
    },
    "underlying_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Underlying Ids",
      "type": "array"
    }
  },
  "required": [
    "research_mode",
    "underlying_ids"
  ],
  "title": "GetOptionContractsRequest",
  "type": "object"
}
