{
  "$defs": {
    "CorpusMode": {
      "enum": [
        "LOOKUP",
        "STANDARD",
        "TRIANGULATED",
        "FORENSIC"
      ],
      "title": "CorpusMode",
      "type": "string"
    },
    "OperationModeQualification": {
      "additionalProperties": false,
      "properties": {
        "mode_id": {
          "$ref": "#/$defs/CorpusMode"
        },
        "operation_id": {
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "required_capabilities": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/QualificationStatus"
        },
        "test_targets": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Test Targets",
          "type": "array"
        }
      },
      "required": [
        "operation_id",
        "mode_id",
        "status"
      ],
      "title": "OperationModeQualification",
      "type": "object"
    },
    "QualificationStatus": {
      "enum": [
        "QUALIFIED_LOCAL",
        "DEGRADED",
        "BLOCKED_UPSTREAM",
        "FAILED"
      ],
      "title": "QualificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/OperationModeQualification"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_id": {
      "const": "corpus_operation_mode_qualification.s35.v1",
      "default": "corpus_operation_mode_qualification.s35.v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "records",
    "content_hash"
  ],
  "title": "CorpusOperationQualificationPanel",
  "type": "object"
}
