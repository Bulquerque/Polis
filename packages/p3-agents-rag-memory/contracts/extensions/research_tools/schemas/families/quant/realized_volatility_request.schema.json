{
  "$defs": {
    "QuantMode": {
      "enum": [
        "BASIC",
        "ROBUST",
        "STABILITY"
      ],
      "title": "QuantMode",
      "type": "string"
    },
    "VolatilityEstimator": {
      "enum": [
        "CLOSE_TO_CLOSE",
        "PARKINSON",
        "GARMAN_KLASS"
      ],
      "title": "VolatilityEstimator",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annualization_factor": {
      "default": 252.0,
      "exclusiveMinimum": 0.0,
      "title": "Annualization Factor",
      "type": "number"
    },
    "block_length": {
      "default": 5,
      "exclusiveMinimum": 0,
      "title": "Block Length",
      "type": "integer"
    },
    "bootstrap_confidence": {
      "default": 0.95,
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.5,
      "title": "Bootstrap Confidence",
      "type": "number"
    },
    "bootstrap_samples": {
      "default": 0,
      "maximum": 2000,
      "minimum": 0,
      "title": "Bootstrap Samples",
      "type": "integer"
    },
    "end_time": {
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "estimators": {
      "default": [
        "CLOSE_TO_CLOSE"
      ],
      "items": {
        "$ref": "#/$defs/VolatilityEstimator"
      },
      "title": "Estimators",
      "type": "array"
    },
    "instrument_id": {
      "minLength": 1,
      "title": "Instrument Id",
      "type": "string"
    },
    "research_mode": {
      "$ref": "#/$defs/QuantMode",
      "default": "BASIC"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    },
    "view_id": {
      "default": "market_prices",
      "minLength": 1,
      "title": "View Id",
      "type": "string"
    }
  },
  "required": [
    "start_time",
    "end_time",
    "instrument_id"
  ],
  "title": "RealizedVolatilityRequest",
  "type": "object"
}
