{
  "$defs": {
    "QuantMode": {
      "enum": [
        "BASIC",
        "ROBUST",
        "STABILITY"
      ],
      "title": "QuantMode",
      "type": "string"
    },
    "ReturnKind": {
      "enum": [
        "SIMPLE",
        "LOG"
      ],
      "title": "ReturnKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annualization_factor": {
      "default": 252.0,
      "exclusiveMinimum": 0.0,
      "title": "Annualization Factor",
      "type": "number"
    },
    "end_time": {
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "instrument_id": {
      "minLength": 1,
      "title": "Instrument Id",
      "type": "string"
    },
    "quantiles": {
      "default": [
        0.05,
        0.5,
        0.95
      ],
      "items": {
        "exclusiveMaximum": 1.0,
        "exclusiveMinimum": 0.0,
        "type": "number"
      },
      "title": "Quantiles",
      "type": "array"
    },
    "research_mode": {
      "$ref": "#/$defs/QuantMode",
      "default": "BASIC"
    },
    "return_kind": {
      "$ref": "#/$defs/ReturnKind",
      "default": "SIMPLE"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    },
    "trim_fraction": {
      "default": 0.1,
      "exclusiveMaximum": 0.5,
      "minimum": 0.0,
      "title": "Trim Fraction",
      "type": "number"
    },
    "view_id": {
      "default": "market_prices",
      "minLength": 1,
      "title": "View Id",
      "type": "string"
    }
  },
  "required": [
    "start_time",
    "end_time",
    "instrument_id"
  ],
  "title": "ReturnStatisticsRequest",
  "type": "object"
}
