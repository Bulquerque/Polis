{
  "$defs": {
    "CompanyMode": {
      "enum": [
        "QUICK_CHECK",
        "STANDARD_REVIEW",
        "DEEP_QUALITATIVE",
        "ACCOUNTING_QUALITY",
        "FORENSIC"
      ],
      "title": "CompanyMode",
      "type": "string"
    },
    "ExtensionLineage": {
      "additionalProperties": false,
      "properties": {
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "producer_module_id": {
          "pattern": "^P3\\.S38\\.M\\d{2}$",
          "title": "Producer Module Id",
          "type": "string"
        },
        "source_artifact_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Artifact Ids",
          "type": "array"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "transformation_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Transformation Ids",
          "type": "array"
        }
      },
      "required": [
        "lineage_id",
        "producer_module_id"
      ],
      "title": "ExtensionLineage",
      "type": "object"
    },
    "HandlerQualificationRecord": {
      "additionalProperties": false,
      "properties": {
        "contract_tests_passed": {
          "default": 0,
          "title": "Contract Tests Passed",
          "type": "integer"
        },
        "handler_id": {
          "minLength": 1,
          "title": "Handler Id",
          "type": "string"
        },
        "leakage_tests_passed": {
          "default": 0,
          "title": "Leakage Tests Passed",
          "type": "integer"
        },
        "mode_id": {
          "$ref": "#/$defs/CompanyMode"
        },
        "operation_id": {
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/QualificationStatus"
        }
      },
      "required": [
        "operation_id",
        "mode_id",
        "status",
        "handler_id"
      ],
      "title": "HandlerQualificationRecord",
      "type": "object"
    },
    "QualificationStatus": {
      "enum": [
        "QUALIFIED_LOCAL",
        "DEGRADED",
        "BLOCKED_UPSTREAM",
        "FAILED"
      ],
      "title": "QualificationStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lineage": {
      "$ref": "#/$defs/ExtensionLineage"
    },
    "matrix_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Matrix Hash",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/HandlerQualificationRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "p3.s38.v1",
      "default": "p3.s38.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "records",
    "lineage",
    "matrix_hash"
  ],
  "title": "CompanyOperationModeQualification",
  "type": "object"
}
