{
  "$defs": {
    "CompanyMode": {
      "enum": [
        "QUICK_CHECK",
        "STANDARD_REVIEW",
        "DEEP_QUALITATIVE",
        "ACCOUNTING_QUALITY",
        "FORENSIC"
      ],
      "title": "CompanyMode",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entity_id": {
      "minLength": 1,
      "title": "Entity Id",
      "type": "string"
    },
    "include_instruments": {
      "default": true,
      "title": "Include Instruments",
      "type": "boolean"
    },
    "include_segments": {
      "default": true,
      "title": "Include Segments",
      "type": "boolean"
    },
    "research_mode": {
      "$ref": "#/$defs/CompanyMode",
      "default": "QUICK_CHECK"
    },
    "view_id": {
      "default": "company_profile",
      "minLength": 1,
      "title": "View Id",
      "type": "string"
    }
  },
  "required": [
    "entity_id"
  ],
  "title": "GetProfileRequest",
  "type": "object"
}
