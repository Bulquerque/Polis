{
  "$defs": {
    "QualificationStatus": {
      "enum": [
        "QUALIFIED_LOCAL",
        "DEGRADED",
        "BLOCKED_UPSTREAM",
        "FAILED"
      ],
      "title": "QualificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "available_tool_operations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Available Tool Operations",
      "type": "array"
    },
    "blocked_tool_operation_modes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Blocked Tool Operation Modes",
      "type": "array"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "schema_id": {
      "default": "p3.s37.macro_tool_readiness_report.v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/QualificationStatus"
    }
  },
  "required": [
    "snapshot_id",
    "status",
    "available_tool_operations",
    "blocked_tool_operation_modes",
    "reason_codes",
    "content_hash"
  ],
  "title": "MacroToolReadinessReport",
  "type": "object"
}
