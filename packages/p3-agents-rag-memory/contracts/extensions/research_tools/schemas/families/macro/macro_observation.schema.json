{
  "$defs": {
    "Frequency": {
      "enum": [
        "DAILY",
        "WEEKLY",
        "MONTHLY",
        "QUARTERLY",
        "ANNUAL",
        "IRREGULAR",
        "UNKNOWN"
      ],
      "title": "Frequency",
      "type": "string"
    },
    "Transformation": {
      "enum": [
        "LEVEL",
        "DIFFERENCE",
        "PERCENT_CHANGE",
        "LOG_DIFFERENCE",
        "YEAR_OVER_YEAR",
        "ANNUALIZED"
      ],
      "title": "Transformation",
      "type": "string"
    }
  },
  "additionalProperties": false,
