{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_operations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Affected Operations",
      "type": "array"
    },
    "issue_id": {
      "minLength": 1,
      "title": "Issue Id",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "reason_code": {
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "severity": {
      "enum": [
        "BLOCKER",
        "MAJOR",
        "MINOR"
      ],
      "title": "Severity",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "issue_id",
    "severity",
    "owner",
    "reason_code",
    "summary"
  ],
  "title": "BlockingIssue",
  "type": "object"
}
