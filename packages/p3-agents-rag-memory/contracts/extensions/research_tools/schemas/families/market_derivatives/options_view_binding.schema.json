{
  "$defs": {
    "BoundView": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_name": {
          "minLength": 1,
          "title": "Artifact Name",
          "type": "string"
        },
        "available_fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Available Fields",
          "type": "array"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "missing_required_fields": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Required Fields",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_count": {
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ViewReadinessStatus"
        }
      },
      "required": [
        "artifact_name",
        "artifact_id",
        "schema_version",
        "content_hash",
        "record_count",
        "available_fields",
        "status"
      ],
      "title": "BoundView",
      "type": "object"
    },
    "ViewReadinessStatus": {
      "enum": [
        "READY",
        "DEGRADED",
        "BLOCKED_UPSTREAM",
        "FAILED"
      ],
      "title": "ViewReadinessStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "observed_iv_available": {
      "title": "Observed Iv Available",
      "type": "boolean"
    },
    "operation_view_map": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Operation View Map",
      "type": "object"
    },
    "schema_id": {
      "const": "options_view_binding.s36.v1",
      "default": "options_view_binding.s36.v1",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "views": {
      "items": {
        "$ref": "#/$defs/BoundView"
      },
      "title": "Views",
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "views",
    "operation_view_map",
    "observed_iv_available",
    "content_hash"
  ],
  "title": "OptionsViewBinding",
  "type": "object"
}
