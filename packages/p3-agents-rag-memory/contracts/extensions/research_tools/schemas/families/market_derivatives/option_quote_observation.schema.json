    },
    "contract_key": {
      "minLength": 1,
      "title": "Contract Key",
      "type": "string"
    },
    "execution_status": {
      "minLength": 1,
      "title": "Execution Status",
      "type": "string"
    },
    "expiration_date": {
      "format": "date",
