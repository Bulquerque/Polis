{
  "version": "social_graph.test.v1",
  "min_degree": 2,
  "max_degree": 2,
  "max_connected_components": 4,
  "min_bridge_edges_between_role_families": 2,
  "max_hub_share": 0.7,
  "domain_trust_range": [
    0.0,
