{
  "$id": "p3://schemas/final_integration/p0_promotion_decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "const": "P0",
      "title": "Authority",
      "type": "string"
    },
    "candidate_bundle_hash": {
      "title": "Candidate Bundle Hash",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "enum": [
        "PROMOTE",
        "REJECT"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_version": {
      "default": "p0.p3-promotion-decision.v2",
      "title": "Decision Version",
      "type": "string"
    },
    "key_id": {
      "title": "Key Id",
      "type": "string"
    },
    "release_id": {
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    },
    "release_sha256": {
      "title": "Release Sha256",
      "type": "string"
    },
    "signature": {
      "maxLength": 88,
      "minLength": 88,
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "release_sha256",
    "candidate_bundle_hash",
    "decision",
    "decided_at",
    "authority",
    "key_id",
    "signature"
  ],
  "title": "P0PromotionDecision",
  "type": "object"
}
