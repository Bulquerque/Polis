{
  "$defs": {
    "MemoryRecord": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "cycle_id": {
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "horizon": {
          "minLength": 1,
          "title": "Horizon",
          "type": "string"
        },
        "importance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Importance",
          "type": "number"
        },
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "memory_type": {
          "$ref": "#/$defs/MemoryType"
        },
        "person_id": {
          "minLength": 1,
          "title": "Person Id",
          "type": "string"
        },
        "proposition_id": {
          "minLength": 1,
          "title": "Proposition Id",
          "type": "string"
        },
        "retrievability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Retrievability",
          "type": "number"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "source_quality_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Quality Score",
          "type": "number"
        },
        "underlying_id": {
          "minLength": 1,
          "title": "Underlying Id",
          "type": "string"
        }
      },
      "required": [
        "memory_id",
        "person_id",
        "run_id",
        "cycle_id",
        "underlying_id",
        "proposition_id",
        "horizon",
        "memory_type",
        "created_at",
        "available_at",
        "confidence",
        "importance",
        "retrievability",
        "source_quality_score",
        "content_hash",
        "lineage_id"
      ],
      "title": "MemoryRecord",
      "type": "object"
    },
    "MemoryType": {
      "enum": [
        "EPISODIC",
        "SEMANTIC",
        "PROCEDURAL",
        "AUDIT"
      ],
      "title": "MemoryType",
      "type": "string"
    }
  },
  "$id": "https://example.invalid/p3/s30/next_memory_state.input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "as_of_time": {
      "format": "date-time",
      "title": "As Of Time",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "title": "Lineage Id",
      "type": "string"
    },
    "pipeline_version": {
      "minLength": 1,
      "title": "Pipeline Version",
      "type": "string"
    },
    "population_size": {
      "minimum": 0,
      "title": "Population Size",
      "type": "integer"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/MemoryRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "created_at",
    "lineage_id",
    "pipeline_version",
    "run_id",
    "cycle_id",
    "as_of_time",
    "population_size",
    "records"
  ],
  "title": "NextMemoryState",
  "type": "object"
}
