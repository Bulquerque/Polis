{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrossListingRelationship",
  "type": "object",
  "required": ["relationship_id", "relationship_type", "local_instrument_id", "foreign_instrument_id", "source_id"],
  "properties": {
    "relationship_id": {"type": "string"},
    "relationship_type": {"const": "DEPOSITARY_RECEIPT_REFERENCE"},
    "local_instrument_id": {"type": "string"},
    "foreign_instrument_id": {"type": "string"},
    "conversion_ratio": {"type": ["number", "null"]},
    "currency_pair": {"type": ["string", "null"]},
    "valid_from": {"type": ["string", "null"]},
    "valid_until": {"type": ["string", "null"]},
    "source_id": {"type": "string"}
  },
  "additionalProperties": false
}
