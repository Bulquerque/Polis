{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "contract_version": {
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CandidateLiquidityState": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "capacity_units": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity Units"
        },
        "fidelity": {
          "$ref": "#/$defs/ComponentQuality"
        },
        "fill_probability_one_unit": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill Probability One Unit"
        },
        "legging_risk": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legging Risk"
        },
        "partial_fill_risk": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial Fill Risk"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "spread_bps": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spread Bps"
        },
        "weakest_leg_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weakest Leg Id"
        }
      },
      "required": [
        "candidate_id",
        "fidelity"
      ],
      "title": "CandidateLiquidityState",
      "type": "object"
    },
    "CandidateMarginState": {
      "additionalProperties": false,
      "properties": {
        "borrow_available": {
          "title": "Borrow Available",
          "type": "boolean"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "capital_capacity_units": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capital Capacity Units"
        },
        "capital_required_per_unit": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capital Required Per Unit"
        },
        "fidelity": {
          "$ref": "#/$defs/MarginFidelity"
        },
        "margin_per_unit": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Per Unit"
        },
        "quality": {
          "$ref": "#/$defs/ComponentQuality"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "borrow_available",
        "fidelity",
        "quality"
      ],
      "title": "CandidateMarginState",
      "type": "object"
    },
    "CandidateSizability": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "capital_max_units": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capital Max Units"
        },
        "component_quality": {
          "additionalProperties": {
            "$ref": "#/$defs/ComponentQuality"
          },
          "title": "Component Quality",
          "type": "object"
        },
        "liquidity_max_units": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Liquidity Max Units"
        },
        "max_units": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Units"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "risk_budget_cap": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Budget Cap",
          "type": "number"
        },
        "state": {
          "$ref": "#/$defs/SizabilityState"
        }
      },
      "required": [
        "candidate_id",
        "state",
        "risk_budget_cap",
        "component_quality"
      ],
      "title": "CandidateSizability",
      "type": "object"
    },
    "ComponentQuality": {
      "enum": [
        "FULLY_QUALIFIED",
        "DEGRADED",
        "UNAVAILABLE",
        "REJECTED"
      ],
      "title": "ComponentQuality",
      "type": "string"
    },
    "ConsumptionStatus": {
      "enum": [
        "INTEGRITY_VALIDATED",
        "SEMANTICALLY_CONSUMED",
        "PARTIALLY_CONSUMED",
        "RESERVED",
        "NOT_APPLICABLE",
        "CAPABILITY_UNAVAILABLE",
        "REJECTED"
      ],
      "title": "ConsumptionStatus",
      "type": "string"
    },
    "DependenceSummary": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "covariance_method": {
          "title": "Covariance Method",
          "type": "string"
        },
        "effective_sample_size": {
          "title": "Effective Sample Size",
          "type": "number"
        },
        "minimum_eigenvalue_after": {
          "title": "Minimum Eigenvalue After",
          "type": "number"
        },
        "minimum_eigenvalue_before": {
          "title": "Minimum Eigenvalue Before",
          "type": "number"
        },
        "psd_repair_relative": {
          "title": "Psd Repair Relative",
          "type": "number"
        },
        "quality": {
          "$ref": "#/$defs/ComponentQuality"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "shrinkage_alpha": {
          "title": "Shrinkage Alpha",
          "type": "number"
        },
        "storage_npz": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Npz"
        }
      },
      "required": [
        "covariance_method",
        "shrinkage_alpha",
        "effective_sample_size",
        "minimum_eigenvalue_before",
        "minimum_eigenvalue_after",
        "psd_repair_relative",
        "quality",
        "content_sha256"
      ],
      "title": "DependenceSummary",
      "type": "object"
    },
    "GreekPathSummary": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "dual_book_reconciliation_error": {
          "title": "Dual Book Reconciliation Error",
          "type": "number"
        },
        "greek_coverage_by_candidate": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Greek Coverage By Candidate",
          "type": "object"
        },
        "path_capability_by_candidate": {
          "additionalProperties": {
            "$ref": "#/$defs/ComponentQuality"
          },
          "title": "Path Capability By Candidate",
          "type": "object"
        },
        "quality": {
          "$ref": "#/$defs/ComponentQuality"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "storage_npz": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Npz"
        }
      },
      "required": [
        "greek_coverage_by_candidate",
        "path_capability_by_candidate",
        "dual_book_reconciliation_error",
        "quality",
        "content_sha256"
      ],
      "title": "GreekPathSummary",
      "type": "object"
    },
    "LiquiditySummary": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "states": {
          "items": {
            "$ref": "#/$defs/CandidateLiquidityState"
          },
          "title": "States",
          "type": "array"
        }
      },
      "required": [
        "states",
        "content_sha256"
      ],
      "title": "LiquiditySummary",
      "type": "object"
    },
    "MarginFidelity": {
      "enum": [
        "EXACT_BROKER_MODEL",
        "SPAN_LIKE_MODEL",
        "CONSERVATIVE_RULE_BASED",
        "UNAVAILABLE"
      ],
      "title": "MarginFidelity",
      "type": "string"
    },
    "MarginFundingSummary": {
      "additionalProperties": false,
      "properties": {
        "candidate_states": {
          "items": {
            "$ref": "#/$defs/CandidateMarginState"
          },
          "title": "Candidate States",
          "type": "array"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "eligible_collateral": {
          "title": "Eligible Collateral",
          "type": "number"
        },
        "free_cash_after_buffer": {
          "title": "Free Cash After Buffer",
          "type": "number"
        },
        "margin_headroom": {
          "title": "Margin Headroom",
          "type": "number"
        },
        "portfolio_margin_current": {
          "title": "Portfolio Margin Current",
          "type": "number"
        }
      },
      "required": [
        "candidate_states",
        "portfolio_margin_current",
        "margin_headroom",
        "free_cash_after_buffer",
        "eligible_collateral",
        "content_sha256"
      ],
      "title": "MarginFundingSummary",
      "type": "object"
    },
    "ModuleReceipt": {
      "additionalProperties": false,
      "properties": {
        "input_sha256": {
          "title": "Input Sha256",
          "type": "string"
        },
        "module_id": {
          "title": "Module Id",
          "type": "string"
        },
        "output_sha256": {
          "title": "Output Sha256",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "enum": [
            "PASS",
            "DEGRADED",
            "CAPABILITY_UNAVAILABLE",
            "NO_ACTION_VALID"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "module_id",
        "input_sha256",
        "output_sha256",
        "status"
      ],
      "title": "ModuleReceipt",
      "type": "object"
    },
    "P8DecisionReadyRiskBundle": {
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "title": "Bundle Id",
          "type": "string"
        },
        "candidate_sizability": {
          "items": {
            "$ref": "#/$defs/CandidateSizability"
          },
          "title": "Candidate Sizability",
          "type": "array"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "cycle_id": {
          "title": "Cycle Id",
          "type": "string"
        },
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "dependence_state_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "greek_path_state_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "liquidity_state_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "margin_funding_state_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "pnl_cube_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "risk_capability_receipt": {
          "$ref": "#/$defs/RiskCapabilityReceipt"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "s3_result_sha256": {
          "title": "S3 Result Sha256",
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "run_id",
        "cycle_id",
        "decision_time",
        "s3_result_sha256",
        "pnl_cube_ref",
        "dependence_state_ref",
        "greek_path_state_ref",
        "liquidity_state_ref",
        "margin_funding_state_ref",
        "candidate_sizability",
        "risk_capability_receipt",
        "content_sha256"
      ],
      "title": "P8DecisionReadyRiskBundle",
      "type": "object"
    },
    "PnLCubeSummary": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "title": "Candidate Count",
          "type": "integer"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "leg_count": {
          "title": "Leg Count",
          "type": "integer"
        },
        "scenario_count": {
          "title": "Scenario Count",
          "type": "integer"
        },
        "step_count": {
          "title": "Step Count",
          "type": "integer"
        },
        "storage_npz": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Npz"
        },
        "stress_scenario_count": {
          "title": "Stress Scenario Count",
          "type": "integer"
        },
        "valuation_quality_by_candidate": {
          "additionalProperties": {
            "$ref": "#/$defs/ValuationQuality"
          },
          "title": "Valuation Quality By Candidate",
          "type": "object"
        }
      },
      "required": [
        "candidate_count",
        "leg_count",
        "scenario_count",
        "stress_scenario_count",
        "step_count",
        "valuation_quality_by_candidate",
        "content_sha256"
      ],
      "title": "PnLCubeSummary",
      "type": "object"
    },
    "RiskCapabilityReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifact_status": {
          "additionalProperties": {
            "$ref": "#/$defs/ConsumptionStatus"
          },
          "title": "Artifact Status",
          "type": "object"
        },
        "candidate_status": {
          "additionalProperties": {
            "$ref": "#/$defs/SizabilityState"
          },
          "title": "Candidate Status",
          "type": "object"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "artifact_status",
        "candidate_status"
      ],
      "title": "RiskCapabilityReceipt",
      "type": "object"
    },
    "SizabilityState": {
      "enum": [
        "FULLY_SIZABLE",
        "DEGRADED_SIZABLE",
        "NOT_SIZABLE",
        "RISK_STATE_INCOMPLETE"
      ],
      "title": "SizabilityState",
      "type": "string"
    },
    "ValuationQuality": {
      "enum": [
        "FULL_REPRICING",
        "ANALYTIC_LINEAR",
        "DEGRADED",
        "UNAVAILABLE"
      ],
      "title": "ValuationQuality",
      "type": "string"
    }
  },
  "$id": "https://inferencia.local/p8/s4/v1/S4Result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle": {
      "$ref": "#/$defs/P8DecisionReadyRiskBundle"
    },
    "candidate_sizability": {
      "items": {
        "$ref": "#/$defs/CandidateSizability"
      },
      "title": "Candidate Sizability",
      "type": "array"
    },
    "cycle_id": {
      "title": "Cycle Id",
      "type": "string"
    },
    "dependence": {
      "$ref": "#/$defs/DependenceSummary"
    },
    "greek_path": {
      "$ref": "#/$defs/GreekPathSummary"
    },
    "liquidity": {
      "$ref": "#/$defs/LiquiditySummary"
    },
    "margin_funding": {
      "$ref": "#/$defs/MarginFundingSummary"
    },
    "pnl_cube": {
      "$ref": "#/$defs/PnLCubeSummary"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/ModuleReceipt"
      },
      "title": "Receipts",
      "type": "array"
    },
    "result_sha256": {
      "title": "Result Sha256",
      "type": "string"
    },
    "risk_capability_receipt": {
      "$ref": "#/$defs/RiskCapabilityReceipt"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "cycle_id",
    "pnl_cube",
    "dependence",
    "greek_path",
    "liquidity",
    "margin_funding",
    "candidate_sizability",
    "risk_capability_receipt",
    "bundle",
    "receipts",
    "result_sha256"
  ],
  "title": "S4Result",
  "type": "object"
}
