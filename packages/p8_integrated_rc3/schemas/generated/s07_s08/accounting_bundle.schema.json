      "type": "object"
    },
    "RealizedPnLEntry": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "minLength": 1,
          "title": "Currency",
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "instrument_id": {
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "event_time",
        "instrument_id",
        "currency",
        "amount"
      ],
      "title": "RealizedPnLEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accounts": {
      "items": {
        "$ref": "#/$defs/CurrencyAccountStateFinal"
      },
      "title": "Accounts",
      "type": "array"
    },
    "balanced": {
      "title": "Balanced",
      "type": "boolean"
    },
    "cash_ledger": {
      "items": {
        "$ref": "#/$defs/CashLedgerEntry"
      },
      "title": "Cash Ledger",
      "type": "array"
    },
    "collateral_ledger": {
      "items": {
        "$ref": "#/$defs/CollateralLedgerEntry"
      },
      "title": "Collateral Ledger",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "cost_ledger": {
      "items": {
        "$ref": "#/$defs/CostLedgerEntry"
      },
      "title": "Cost Ledger",
      "type": "array"
    },
    "external_flow_delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "External Flow Delta"
    },
    "journal_entries": {
      "items": {
        "$ref": "#/$defs/JournalEntry"
      },
      "title": "Journal Entries",
      "type": "array"
    },
    "margin_ledger": {
      "items": {
        "$ref": "#/$defs/MarginLedgerEntry"
      },
      "title": "Margin Ledger",
      "type": "array"
    },
    "premium_ledger": {
      "items": {
        "$ref": "#/$defs/PremiumLedgerEntry"
      },
      "title": "Premium Ledger",
      "type": "array"
