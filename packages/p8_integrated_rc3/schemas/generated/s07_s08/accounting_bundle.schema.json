  "required": [
    "accounts",
    "journal_entries",
    "cash_ledger",
    "premium_ledger",
    "cost_ledger",
    "margin_ledger",
    "collateral_ledger",
    "realized_pnl_ledger",
    "balanced",
    "external_flow_delta",
    "content_sha256"
  ],
  "title": "AccountingBundle",
  "type": "object"
}
