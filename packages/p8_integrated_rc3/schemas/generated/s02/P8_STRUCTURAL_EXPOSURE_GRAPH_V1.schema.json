{
  "$defs": {
    "ExposureEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "source_node_id": {
          "minLength": 1,
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "minLength": 1,
          "title": "Target Node Id",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/ExposureRelationType"
        },
        "instrument_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instrument Id"
        },
        "signed_contract_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signed Contract Quantity"
        },
        "expiration": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiration"
        }
      },
      "required": [
        "edge_id",
        "source_node_id",
        "target_node_id",
        "relation"
      ],
      "title": "ExposureEdge",
      "type": "object"
    },
    "ExposureNode": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "node_type": {
          "$ref": "#/$defs/ExposureNodeType"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "node_type",
        "label"
      ],
      "title": "ExposureNode",
      "type": "object"
    },
    "ExposureNodeType": {
      "enum": [
        "CANDIDATE",
        "INSTRUMENT",
        "COMPARISON_GROUP",
        "OBJECTIVE_FAMILY",
        "CANDIDATE_FAMILY",
        "CURRENCY",
        "UNDERLYING_SCOPE",
        "EXPIRATION"
      ],
      "title": "ExposureNodeType",
      "type": "string"
    },
    "ExposureRelationType": {
      "enum": [
        "CANDIDATE_HAS_LEG",
        "CANDIDATE_IN_GROUP",
        "CANDIDATE_OBJECTIVE_FAMILY",
        "CANDIDATE_FAMILY",
        "CANDIDATE_CURRENCY",
        "CANDIDATE_UNDERLYING_SCOPE",
        "INSTRUMENT_EXPIRATION",
        "SAME_INSTRUMENT",
        "OPPOSITE_LEG",
        "SAME_EXPIRATION",
        "SAME_UNDERLYING_SCOPE",
        "SAME_OBJECTIVE_FAMILY"
      ],
      "title": "ExposureRelationType",
      "type": "string"
    },
    "GraphComponent": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "node_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Node Ids",
          "type": "array"
        }
      },
      "required": [
        "component_id",
        "node_ids"
      ],
      "title": "GraphComponent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "P8_STRUCTURAL_EXPOSURE_GRAPH_V1",
      "title": "Contract Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/ExposureNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/ExposureEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "connected_components": {
      "items": {
        "$ref": "#/$defs/GraphComponent"
      },
      "title": "Connected Components",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "schema_version",
    "snapshot_id",
    "nodes",
    "edges",
    "connected_components",
    "content_sha256"
  ],
  "title": "StructuralExposureGraph",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "P8_STRUCTURAL_EXPOSURE_GRAPH_V1.schema.json"
}
