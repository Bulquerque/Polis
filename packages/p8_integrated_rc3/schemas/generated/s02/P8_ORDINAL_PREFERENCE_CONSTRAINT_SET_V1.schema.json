{
  "$defs": {
    "ConfidenceEvidenceHint": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ConfidenceEvidenceState"
        },
        "calibration_artifact_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Artifact Hash"
        },
        "numerical_cap_status": {
          "const": "NOT_DERIVED_BY_S2",
          "default": "NOT_DERIVED_BY_S2",
          "title": "Numerical Cap Status",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "state"
      ],
      "title": "ConfidenceEvidenceHint",
      "type": "object"
    },
    "ConfidenceEvidenceState": {
      "enum": [
        "CALIBRATED_REFERENCE_AVAILABLE",
        "UNCALIBRATED",
        "UNAVAILABLE"
      ],
      "title": "ConfidenceEvidenceState",
      "type": "string"
    },
    "LexicographicTier": {
      "additionalProperties": false,
      "properties": {
        "comparison_group_id": {
          "minLength": 1,
          "title": "Comparison Group Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "candidate_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Candidate Ids",
          "type": "array"
        }
      },
      "required": [
        "comparison_group_id",
        "rank",
        "candidate_ids"
      ],
      "title": "LexicographicTier",
      "type": "object"
    },
    "OrdinalConstraintType": {
      "enum": [
        "PREFERRED_OVER"
      ],
      "title": "OrdinalConstraintType",
      "type": "string"
    },
    "OrdinalPenaltyTemplate": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "inversion_unit_penalty": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1",
          "title": "Inversion Unit Penalty"
        },
        "economic_weight_status": {
          "const": "UNASSIGNED_BY_S2",
          "default": "UNASSIGNED_BY_S2",
          "title": "Economic Weight Status",
          "type": "string"
        }
      },
      "required": [
        "constraint_id"
      ],
      "title": "OrdinalPenaltyTemplate",
      "type": "object"
    },
    "OrdinalSemanticsProof": {
      "additionalProperties": false,
      "properties": {
        "pairwise_mode": {
          "$ref": "#/$defs/PairwiseMode"
        },
        "score_values_ignored": {
          "const": true,
          "default": true,
          "title": "Score Values Ignored",
          "type": "boolean"
        },
        "cardinal_financial_outputs_absent": {
          "const": true,
          "default": true,
          "title": "Cardinal Financial Outputs Absent",
          "type": "boolean"
        },
        "scenario_distribution_unchanged": {
          "const": true,
          "default": true,
          "title": "Scenario Distribution Unchanged",
          "type": "boolean"
        },
        "cross_group_constraints_absent": {
          "const": true,
          "default": true,
          "title": "Cross Group Constraints Absent",
          "type": "boolean"
        }
      },
      "required": [
        "pairwise_mode"
      ],
      "title": "OrdinalSemanticsProof",
      "type": "object"
    },
    "PairwiseMode": {
      "enum": [
        "ADJACENT_TIERS",
        "ALL_ORDERED_TIERS"
      ],
      "title": "PairwiseMode",
      "type": "string"
    },
    "PairwiseOrdinalConstraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "constraint_type": {
          "$ref": "#/$defs/OrdinalConstraintType"
        },
        "comparison_group_id": {
          "minLength": 1,
          "title": "Comparison Group Id",
          "type": "string"
        },
        "preferred_candidate_id": {
          "minLength": 1,
          "title": "Preferred Candidate Id",
          "type": "string"
        },
        "less_preferred_candidate_id": {
          "minLength": 1,
          "title": "Less Preferred Candidate Id",
          "type": "string"
        },
        "preferred_rank": {
          "minimum": 1,
          "title": "Preferred Rank",
          "type": "integer"
        },
        "less_preferred_rank": {
          "minimum": 1,
          "title": "Less Preferred Rank",
          "type": "integer"
        }
      },
      "required": [
        "constraint_id",
        "constraint_type",
        "comparison_group_id",
        "preferred_candidate_id",
        "less_preferred_candidate_id",
        "preferred_rank",
        "less_preferred_rank"
      ],
      "title": "PairwiseOrdinalConstraint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "P8_ORDINAL_PREFERENCE_CONSTRAINT_SET_V1",
      "title": "Contract Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "pairwise_constraints": {
      "items": {
        "$ref": "#/$defs/PairwiseOrdinalConstraint"
      },
      "title": "Pairwise Constraints",
      "type": "array"
    },
    "lexicographic_tiers": {
      "items": {
        "$ref": "#/$defs/LexicographicTier"
      },
      "title": "Lexicographic Tiers",
      "type": "array"
    },
    "penalty_templates": {
      "items": {
        "$ref": "#/$defs/OrdinalPenaltyTemplate"
      },
      "title": "Penalty Templates",
      "type": "array"
    },
    "confidence_hints": {
      "items": {
        "$ref": "#/$defs/ConfidenceEvidenceHint"
      },
      "title": "Confidence Hints",
      "type": "array"
    },
    "proof": {
      "$ref": "#/$defs/OrdinalSemanticsProof"
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "schema_version",
    "snapshot_id",
    "pairwise_constraints",
    "lexicographic_tiers",
    "penalty_templates",
    "confidence_hints",
    "proof",
    "content_sha256"
  ],
  "title": "OrdinalPreferenceConstraintSet",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "P8_ORDINAL_PREFERENCE_CONSTRAINT_SET_V1.schema.json"
}
