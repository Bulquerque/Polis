    "NettingTransformProof": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "instrument_count": {
          "minimum": 0,
          "title": "Instrument Count",
          "type": "integer"
        },
        "coefficient_count": {
          "minimum": 0,
          "title": "Coefficient Count",
          "type": "integer"
        },
        "all_active_candidates_mapped": {
          "title": "All Active Candidates Mapped",
          "type": "boolean"
        },
        "contains_final_target_quantities": {
          "const": false,
          "default": false,
          "title": "Contains Final Target Quantities",
          "type": "boolean"
        },
        "equation_semantics": {
          "const": "target_physical_quantity = current_physical_quantity + sum(coefficient * virtual_candidate_quantity)",
          "title": "Equation Semantics",
          "type": "string"
        }
      },
      "required": [
        "candidate_count",
        "instrument_count",
        "coefficient_count",
        "all_active_candidates_mapped",
        "equation_semantics"
      ],
      "title": "NettingTransformProof",
      "type": "object"
    },
