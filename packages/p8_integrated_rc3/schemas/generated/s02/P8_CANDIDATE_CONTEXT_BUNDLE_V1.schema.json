    "CandidateInstrumentCoefficient": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "instrument_id": {
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "signed_contracts_per_candidate_unit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Signed Contracts Per Candidate Unit"
        },
        "contract_multiplier": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Contract Multiplier"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "instrument_id",
        "signed_contracts_per_candidate_unit",
        "contract_multiplier",
        "currency"
      ],
      "title": "CandidateInstrumentCoefficient",
      "type": "object"
    },
    "ComponentQualificationStatus": {
      "enum": [
        "QUALIFIED",
        "DEGRADED",
        "RESERVED",
        "UNAVAILABLE",
        "REJECTED"
      ],
