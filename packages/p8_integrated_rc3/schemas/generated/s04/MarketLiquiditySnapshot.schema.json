          "type": "number"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "bid": {
          "exclusiveMinimum": 0.0,
          "title": "Bid",
          "type": "number"
        },
        "bid_size": {
          "minimum": 0.0,
          "title": "Bid Size",
          "type": "number"
        },
        "combo_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
