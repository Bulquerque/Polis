          "default": null,
          "title": "Combo Group Id"
        },
        "daily_volume": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Daily Volume"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "open_interest": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open Interest"
        },
        "quote_time": {
          "format": "date-time",
          "title": "Quote Time",
          "type": "string"
        }
      },
      "required": [
