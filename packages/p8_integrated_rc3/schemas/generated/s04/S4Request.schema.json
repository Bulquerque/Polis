  "$id": "https://inferencia.local/p8/s4/v1/S4Request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_state": {
      "$ref": "#/$defs/AccountState"
    },
    "borrow_records": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BorrowRecord"
      },
      "title": "Borrow Records",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateEconomicPackage"
      },
      "title": "Candidates",
      "type": "array"
    },
    "current_candidate_positions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidatePosition"
      },
      "title": "Current Candidate Positions",
      "type": "array"
    },
    "cycle_id": {
      "title": "Cycle Id",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "dependence_policy": {
      "$ref": "#/$defs/DependencePolicy",
      "default": {
        "max_psd_repair_relative": 0.25,
        "minimum_effective_samples": 20.0,
        "psd_floor": 1e-10,
        "shrinkage_alpha": null,
        "tail_probability": 0.1
      }
    },
    "factor_definitions": {
      "items": {
        "$ref": "#/$defs/FactorDefinition"
      },
      "title": "Factor Definitions",
      "type": "array"
    },
    "greek_policy": {
      "$ref": "#/$defs/GreekPolicy",
      "default": {
        "approximation_error_max": 0.25,
        "reconciliation_tolerance": 1e-08
      }
    },
    "liquidity_policy": {
      "$ref": "#/$defs/LiquidityPolicy",
      "default": {
        "combo_fill_bonus": 0.1,
        "depth_multiplier": 1.0,
        "max_quote_age_seconds": 300.0,
        "max_spread_bps": 500.0,
        "min_fill_probability": 0.05,
        "open_interest_participation": 0.02,
        "volume_participation": 0.05
      }
    },
    "liquidity_snapshot": {
      "$ref": "#/$defs/MarketLiquiditySnapshot"
    },
    "margin_policy": {
      "$ref": "#/$defs/MarginPolicy",
      "default": {
        "allow_rule_based": true,
        "allow_span_like": true,
        "liquidity_addon_rate": 0.05,
        "settlement_reserve_rate": 0.02,
        "stress_loss_multiplier": 1.0
      }
    },
    "margin_rules": {
      "$ref": "#/$defs/MarginRules"
    },
    "physical_positions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PhysicalPosition"
      },
      "title": "Physical Positions",
      "type": "array"
    },
    "pnl_policy": {
      "$ref": "#/$defs/PnLPolicy",
      "default": {
        "option_spot_floor": 1e-08,
        "option_volatility_floor": 0.0001,
        "use_reduced_scenarios": true
      }
    },
    "reconciliation_policy": {
      "$ref": "#/$defs/ReconciliationPolicy",
      "default": {
        "degraded_cap_multiplier": 0.5,
        "quantity_tolerance": 1e-08,
        "require_physical_reconciliation": true
      }
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "s3_result": {
      "$ref": "#/$defs/S3Result"
    },
    "scenario_artifacts": {
      "$ref": "#/$defs/ScenarioArtifactBundle"
    },
    "step_year_fractions": {
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "title": "Step Year Fractions",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "cycle_id",
    "decision_time",
    "s3_result",
    "scenario_artifacts",
    "candidates",
    "factor_definitions",
    "step_year_fractions",
    "liquidity_snapshot",
    "account_state",
    "margin_rules"
  ],
  "title": "S4Request",
  "type": "object"
}
