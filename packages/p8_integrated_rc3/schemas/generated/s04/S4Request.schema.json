{
  "$defs": {
    "AccountState": {
      "additionalProperties": false,
      "properties": {
        "available_cash": {
          "minimum": 0.0,
          "title": "Available Cash",
          "type": "number"
        },
        "cash_buffer_required": {
          "minimum": 0.0,
          "title": "Cash Buffer Required",
          "type": "number"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "current_margin_used": {
          "minimum": 0.0,
          "title": "Current Margin Used",
          "type": "number"
        },
        "eligible_collateral": {
          "minimum": 0.0,
          "title": "Eligible Collateral",
          "type": "number"
        },
        "margin_limit": {
          "minimum": 0.0,
          "title": "Margin Limit",
          "type": "number"
        },
        "max_new_risk_capital": {
          "minimum": 0.0,
          "title": "Max New Risk Capital",
          "type": "number"
        }
      },
      "required": [
        "currency",
        "available_cash",
        "eligible_collateral",
        "current_margin_used",
        "margin_limit",
        "cash_buffer_required",
        "max_new_risk_capital"
      ],
      "title": "AccountState",
      "type": "object"
    },
    "ActionabilityState": {
      "enum": [
        "NOMINAL_ACTIONABLE",
        "ROBUST_ONLY",
        "DEGRADED_ACTIONABLE",
        "CLOSE_ONLY",
        "NO_NEW_RISK",
        "NO_ACTION_VALID"
      ],
      "title": "ActionabilityState",
      "type": "string"
    },
    "AmbiguityAssessment": {
      "additionalProperties": false,
      "properties": {
        "actionability_state": {
          "$ref": "#/$defs/ActionabilityState"
        },
        "ambiguity_radius": {
          "minimum": 0.0,
          "title": "Ambiguity Radius",
          "type": "number"
        },
        "liquidity_haircut": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Liquidity Haircut",
          "type": "number"
        },
        "margin_buffer": {
          "minimum": 0.0,
          "title": "Margin Buffer",
          "type": "number"
        },
        "probability_lower_bounds": {
          "items": {
            "type": "number"
          },
          "title": "Probability Lower Bounds",
          "type": "array"
        },
        "probability_upper_bounds": {
          "items": {
            "type": "number"
          },
          "title": "Probability Upper Bounds",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "risk_budget_cap": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Budget Cap",
          "type": "number"
        },
        "uncertainty_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Uncertainty Score",
          "type": "number"
        }
      },
      "required": [
        "actionability_state",
        "uncertainty_score",
        "ambiguity_radius",
        "risk_budget_cap",
        "liquidity_haircut",
        "margin_buffer",
        "probability_lower_bounds",
        "probability_upper_bounds"
      ],
      "title": "AmbiguityAssessment",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "contract_version": {
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BorrowRecord": {
      "additionalProperties": false,
      "properties": {
        "annual_rate": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annual Rate"
        },
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "quantity_available": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity Available"
        }
      },
      "required": [
        "instrument_id",
        "available"
      ],
      "title": "BorrowRecord",
      "type": "object"
    },
    "CandidateEconomicPackage": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "canonical_candidate_id": {
          "minLength": 1,
          "title": "Canonical Candidate Id",
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "entry_cash_flow_per_unit": {
          "default": 0.0,
          "title": "Entry Cash Flow Per Unit",
          "type": "number"
        },
        "gross_notional_per_unit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gross Notional Per Unit"
        },
        "legs": {
          "items": {
            "discriminator": {
              "mapping": {
                "EUROPEAN_OPTION": "#/$defs/EuropeanOptionLeg",
                "LINEAR": "#/$defs/LinearLeg"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LinearLeg"
              },
              {
                "$ref": "#/$defs/EuropeanOptionLeg"
              }
            ]
          },
          "minItems": 1,
          "title": "Legs",
          "type": "array"
        },
        "margin_offset_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Offset Group"
        },
        "maximum_loss_per_unit": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Loss Per Unit"
        },
        "maximum_loss_proof_status": {
          "default": "UNAVAILABLE",
          "enum": [
            "PROVEN",
            "DEGRADED",
            "UNAVAILABLE"
          ],
          "title": "Maximum Loss Proof Status",
          "type": "string"
        },
        "required_capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "source_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "strategy_family": {
          "minLength": 1,
          "title": "Strategy Family",
          "type": "string"
        },
        "unit_definition": {
          "minLength": 1,
          "title": "Unit Definition",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "canonical_candidate_id",
        "strategy_family",
        "currency",
        "unit_definition",
        "legs",
        "source_ref"
      ],
      "title": "CandidateEconomicPackage",
      "type": "object"
    },
    "CandidatePosition": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "units": {
          "title": "Units",
          "type": "number"
        }
      },
      "required": [
        "candidate_id",
        "units"
      ],
      "title": "CandidatePosition",
      "type": "object"
    },
    "DependencePolicy": {
      "additionalProperties": false,
      "properties": {
        "max_psd_repair_relative": {
          "default": 0.25,
          "minimum": 0.0,
          "title": "Max Psd Repair Relative",
          "type": "number"
        },
        "minimum_effective_samples": {
          "default": 20.0,
          "minimum": 2.0,
          "title": "Minimum Effective Samples",
          "type": "number"
        },
        "psd_floor": {
          "default": 1e-10,
          "minimum": 0.0,
          "title": "Psd Floor",
          "type": "number"
        },
        "shrinkage_alpha": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shrinkage Alpha"
        },
        "tail_probability": {
          "default": 0.1,
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": 0.0,
          "title": "Tail Probability",
          "type": "number"
        }
      },
      "title": "DependencePolicy",
      "type": "object"
    },
    "DistributionResolution": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "distribution_type": {
          "$ref": "#/$defs/DistributionType"
        },
        "factor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Factor Ids",
          "type": "array"
        },
        "path_capability": {
          "enum": [
            "TERMINAL_ONLY",
            "FULL_PATH"
          ],
          "title": "Path Capability",
          "type": "string"
        },
        "probability_measure": {
          "$ref": "#/$defs/ProbabilityMeasure"
        },
        "step_labels": {
          "items": {
            "type": "string"
          },
          "title": "Step Labels",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "distribution_type",
        "probability_measure",
        "factor_ids",
        "step_labels",
        "path_capability",
        "content_sha256"
      ],
      "title": "DistributionResolution",
      "type": "object"
    },
    "DistributionType": {
      "enum": [
        "PARAMETRIC",
        "MIXTURE",
        "QUANTILE",
        "EMPIRICAL",
        "PATH"
      ],
      "title": "DistributionType",
      "type": "string"
    },
    "EuropeanOptionLeg": {
      "additionalProperties": false,
      "properties": {
        "contract_multiplier": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Contract Multiplier",
          "type": "number"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "dividend_yield": {
          "default": 0.0,
          "title": "Dividend Yield",
          "type": "number"
        },
        "instrument_id": {
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "kind": {
          "const": "EUROPEAN_OPTION",
          "default": "EUROPEAN_OPTION",
          "title": "Kind",
          "type": "string"
        },
        "leg_id": {
          "minLength": 1,
          "title": "Leg Id",
          "type": "string"
        },
        "option_type": {
          "$ref": "#/$defs/OptionType"
        },
        "provided_greeks_per_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/GreekVector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quantity_per_unit": {
          "title": "Quantity Per Unit",
          "type": "number"
        },
        "rate_factor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Factor Id"
        },
        "risk_free_rate": {
          "title": "Risk Free Rate",
          "type": "number"
        },
        "spot": {
          "exclusiveMinimum": 0.0,
          "title": "Spot",
          "type": "number"
        },
        "strike": {
          "exclusiveMinimum": 0.0,
          "title": "Strike",
          "type": "number"
        },
        "time_to_expiry_years": {
          "exclusiveMinimum": 0.0,
          "title": "Time To Expiry Years",
          "type": "number"
        },
        "underlying_factor_id": {
          "minLength": 1,
          "title": "Underlying Factor Id",
          "type": "string"
        },
        "volatility": {
          "exclusiveMinimum": 0.0,
          "title": "Volatility",
          "type": "number"
        },
        "volatility_factor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volatility Factor Id"
        }
      },
      "required": [
        "leg_id",
        "instrument_id",
        "underlying_factor_id",
        "option_type",
        "quantity_per_unit",
        "spot",
        "strike",
        "volatility",
        "risk_free_rate",
        "time_to_expiry_years",
        "currency"
      ],
      "title": "EuropeanOptionLeg",
      "type": "object"
    },
    "FactorDefinition": {
      "additionalProperties": false,
