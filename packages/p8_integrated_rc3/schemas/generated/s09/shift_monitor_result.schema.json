{
  "$defs": {
    "MetricFamily": {
      "enum": [
        "MARKET",
        "MODEL",
        "RISK",
        "LIQUIDITY",
        "EXECUTION"
      ],
      "title": "MetricFamily",
      "type": "string"
    },
    "MetricMonitorState": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "cusum_negative": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cusum Negative",
          "type": "number"
        },
        "cusum_positive": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cusum Positive",
          "type": "number"
        },
        "ewma_z": {
          "default": 0.0,
          "title": "Ewma Z",
          "type": "number"
        },
        "last_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Observed At"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        }
      },
      "required": [
        "metric_name",
        "count"
      ],
      "title": "MetricMonitorState",
      "type": "object"
    },
    "MetricShiftResult": {
      "additionalProperties": false,
      "properties": {
        "cusum_score": {
          "title": "Cusum Score",
          "type": "number"
        },
        "ewma_z": {
          "title": "Ewma Z",
          "type": "number"
        },
        "family": {
          "$ref": "#/$defs/MetricFamily"
        },
        "metric_name": {
          "title": "Metric Name",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/ShiftState"
        },
        "z_score": {
          "title": "Z Score",
          "type": "number"
        }
      },
      "required": [
        "metric_name",
        "family",
        "z_score",
        "ewma_z",
        "cusum_score",
        "state"
      ],
      "title": "MetricShiftResult",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "MATERIAL_DISTRIBUTION_SHIFT",
        "TAIL_RISK_SHIFT",
        "LIQUIDITY_DETERIORATION",
        "EXECUTION_MODEL_DETERIORATION",
        "MONITOR_DATA_STALE",
        "MONITOR_BASELINE_INVALID",
        "CANDIDATE_CONSERVATION_FAIL",
        "ORDER_CONSERVATION_FAIL",
        "DUAL_BOOK_RECONCILIATION_FAIL",
        "CASH_RECONCILIATION_FAIL",
        "MARGIN_HEADROOM_BREACH",
        "MAX_LOSS_BREACH",
        "QUOTE_STALE",
        "LIFECYCLE_INCONSISTENT",
        "SETTLEMENT_INCONSISTENT",
        "STATE_HASH_MISMATCH",
        "UNHEDGED_PARTIAL_FILL",
        "FALLBACK_NOT_FEASIBLE",
        "CHALLENGER_INPUT_MISMATCH",
        "CHALLENGER_RISK_BREACH",
        "MATERIAL_DECISION_DISAGREEMENT",
        "ADAPTATION_NON_CONSERVATIVE",
        "ADAPTATION_OUT_OF_BOUNDS",
        "RUNTIME_POLICY_EXPIRED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ShiftState": {
      "enum": [
        "IN_DISTRIBUTION",
        "MILD_SHIFT",
        "MATERIAL_SHIFT",
        "TAIL_SHIFT",
        "LIQUIDITY_SHIFT",
        "EXECUTION_MODEL_SHIFT",
        "UNKNOWN_REGIME",
        "MONITOR_DEGRADED"
      ],
      "title": "ShiftState",
      "type": "string"
    }
  },
  "$id": "https://inferencia.local/schemas/p8/s9/shift_monitor_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "metric_results": {
      "items": {
        "$ref": "#/$defs/MetricShiftResult"
      },
      "title": "Metric Results",
      "type": "array"
    },
    "next_states": {
      "items": {
        "$ref": "#/$defs/MetricMonitorState"
      },
      "title": "Next States",
      "type": "array"
    },
    "overall_state": {
      "$ref": "#/$defs/ShiftState"
    }
  },
  "required": [
    "overall_state",
    "metric_results",
    "next_states",
    "generated_at"
  ],
  "title": "ShiftMonitorResult",
  "type": "object"
}
