        "alpha",
        "drift_allowance",
        "mild_threshold",
        "material_threshold",
        "critical_threshold",
        "minimum_observations",
        "maximum_observation_age_seconds"
      ],
      "title": "ShiftMonitorPolicy",
      "type": "object"
    },
    "ShiftMonitorRequest": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/RuntimeContext"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/MetricObservation"
          },
          "minItems": 1,
          "title": "Observations",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/ShiftMonitorPolicy"
        },
        "prior_states": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricMonitorState"
          },
          "title": "Prior States",
          "type": "array"
        }
      },
      "required": [
        "context",
        "observations",
        "policy"
      ],
      "title": "ShiftMonitorRequest",
      "type": "object"
    },
    "SupervisorPolicy": {
      "additionalProperties": false,
      "properties": {
        "critical_margin_mode": {
          "$ref": "#/$defs/RuntimeMode",
          "default": "CONTROLLED_FLATTEN"
        },
        "material_shift_mode": {
          "$ref": "#/$defs/RuntimeMode",
          "default": "HOLD_NO_NEW_RISK"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "state_inconsistent_mode": {
          "$ref": "#/$defs/RuntimeMode",
          "default": "HOLD_NO_NEW_RISK"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "valid_until"
      ],
      "title": "SupervisorPolicy",
      "type": "object"
    },
    "TargetQuantity": {
      "additionalProperties": false,
      "properties": {
        "instrument_id": {
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        }
      },
      "required": [
        "instrument_id",
        "quantity"
      ],
      "title": "TargetQuantity",
      "type": "object"
    }
  },
  "$id": "https://inferencia.local/schemas/p8/s9/runtime_assurance_request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adaptation_bounds": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AdaptationBound"
      },
      "title": "Adaptation Bounds",
      "type": "array"
    },
    "adaptation_requests": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AdaptationRequest"
      },
      "title": "Adaptation Requests",
      "type": "array"
    },
    "context": {
      "$ref": "#/$defs/RuntimeContext"
    },
    "exposure_state": {
      "$ref": "#/$defs/ExecutionExposureState"
    },
    "invariant_request": {
      "$ref": "#/$defs/InvariantMonitorRequest"
    },
    "shadow_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShadowEvaluationRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shift_request": {
      "$ref": "#/$defs/ShiftMonitorRequest"
    },
    "source_artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Source Artifacts",
      "type": "array"
    },
    "supervisor_policy": {
      "$ref": "#/$defs/SupervisorPolicy"
    }
  },
  "required": [
    "context",
    "shift_request",
    "invariant_request",
    "exposure_state",
    "supervisor_policy"
  ],
  "title": "RuntimeAssuranceRequest",
  "type": "object"
}
