{
  "$defs": {
    "ComparisonState": {
      "enum": [
        "AGREES",
        "BENIGN_DISAGREEMENT",
        "MATERIAL_DISAGREEMENT",
        "UNSAFE_CHALLENGER",
        "CHAMPION_SUSPECT",
        "INPUT_MISMATCH"
      ],
      "title": "ComparisonState",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "MATERIAL_DISTRIBUTION_SHIFT",
        "TAIL_RISK_SHIFT",
        "LIQUIDITY_DETERIORATION",
        "EXECUTION_MODEL_DETERIORATION",
        "MONITOR_DATA_STALE",
        "MONITOR_BASELINE_INVALID",
        "CANDIDATE_CONSERVATION_FAIL",
        "ORDER_CONSERVATION_FAIL",
        "DUAL_BOOK_RECONCILIATION_FAIL",
        "CASH_RECONCILIATION_FAIL",
        "MARGIN_HEADROOM_BREACH",
        "MAX_LOSS_BREACH",
        "QUOTE_STALE",
        "LIFECYCLE_INCONSISTENT",
        "SETTLEMENT_INCONSISTENT",
        "STATE_HASH_MISMATCH",
        "UNHEDGED_PARTIAL_FILL",
        "FALLBACK_NOT_FEASIBLE",
        "CHALLENGER_INPUT_MISMATCH",
        "CHALLENGER_RISK_BREACH",
        "MATERIAL_DECISION_DISAGREEMENT",
        "ADAPTATION_NON_CONSERVATIVE",
        "ADAPTATION_OUT_OF_BOUNDS",
        "RUNTIME_POLICY_EXPIRED"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "$id": "https://inferencia.local/schemas/p8/s9/shadow_evaluation_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "absolute_risk_difference": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Absolute Risk Difference"
    },
    "action_agrees": {
      "title": "Action Agrees",
      "type": "boolean"
    },
    "challenger_execution_authority": {
      "const": false,
      "default": false,
      "title": "Challenger Execution Authority",
      "type": "boolean"
    },
    "comparison_state": {
      "$ref": "#/$defs/ComparisonState"
    },
    "max_absolute_quantity_difference": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Max Absolute Quantity Difference"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "comparison_state",
    "action_agrees",
    "max_absolute_quantity_difference",
    "absolute_risk_difference",
    "reason_codes"
  ],
  "title": "ShadowEvaluationResult",
  "type": "object"
}
