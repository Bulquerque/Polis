{
  "$defs": {
    "AlertSeverity": {
      "enum": [
        "INFO",
        "CAUTION",
        "MATERIAL",
        "CRITICAL",
        "STATE_INCONSISTENT",
        "MONITOR_FAILURE"
      ],
      "title": "AlertSeverity",
      "type": "string"
    },
    "ExecutionExposureState": {
      "additionalProperties": false,
      "properties": {
        "has_unhedged_partial_fill": {
          "title": "Has Unhedged Partial Fill",
          "type": "boolean"
        },
        "margin_headroom_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Margin Headroom Ratio"
        },
        "market_access_available": {
          "title": "Market Access Available",
          "type": "boolean"
        },
        "safe_cancel_available": {
          "title": "Safe Cancel Available",
          "type": "boolean"
        },
        "safe_flatten_available": {
          "title": "Safe Flatten Available",
          "type": "boolean"
        },
        "safe_hedge_available": {
          "title": "Safe Hedge Available",
          "type": "boolean"
        }
      },
      "required": [
        "has_unhedged_partial_fill",
        "margin_headroom_ratio",
        "safe_cancel_available",
        "safe_hedge_available",
        "safe_flatten_available",
        "market_access_available"
      ],
      "title": "ExecutionExposureState",
      "type": "object"
    },
    "InvariantMonitorResult": {
      "additionalProperties": false,
      "properties": {
        "healthy": {
          "title": "Healthy",
          "type": "boolean"
        },
        "highest_severity": {
          "$ref": "#/$defs/AlertSeverity"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/InvariantViolation"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "healthy",
        "highest_severity",
        "violations"
      ],
      "title": "InvariantMonitorResult",
      "type": "object"
    },
    "InvariantViolation": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "title": "Actual",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "invariant_id": {
          "minLength": 1,
          "title": "Invariant Id",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "severity": {
          "$ref": "#/$defs/AlertSeverity"
        }
      },
      "required": [
        "invariant_id",
        "severity",
        "reason_code",
        "expected",
        "actual"
      ],
      "title": "InvariantViolation",
      "type": "object"
    },
    "MetricFamily": {
      "enum": [
        "MARKET",
        "MODEL",
        "RISK",
        "LIQUIDITY",
        "EXECUTION"
      ],
      "title": "MetricFamily",
      "type": "string"
    },
    "MetricMonitorState": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "cusum_negative": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cusum Negative",
          "type": "number"
        },
        "cusum_positive": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cusum Positive",
          "type": "number"
        },
        "ewma_z": {
          "default": 0.0,
          "title": "Ewma Z",
          "type": "number"
        },
        "last_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Observed At"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        }
      },
      "required": [
        "metric_name",
        "count"
      ],
      "title": "MetricMonitorState",
      "type": "object"
    },
    "MetricShiftResult": {
      "additionalProperties": false,
      "properties": {
        "cusum_score": {
          "title": "Cusum Score",
          "type": "number"
        },
        "ewma_z": {
          "title": "Ewma Z",
          "type": "number"
        },
        "family": {
          "$ref": "#/$defs/MetricFamily"
        },
        "metric_name": {
          "title": "Metric Name",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/ShiftState"
        },
        "z_score": {
          "title": "Z Score",
          "type": "number"
        }
      },
      "required": [
        "metric_name",
        "family",
        "z_score",
        "ewma_z",
        "cusum_score",
        "state"
      ],
      "title": "MetricShiftResult",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "MATERIAL_DISTRIBUTION_SHIFT",
        "TAIL_RISK_SHIFT",
        "LIQUIDITY_DETERIORATION",
        "EXECUTION_MODEL_DETERIORATION",
        "MONITOR_DATA_STALE",
        "MONITOR_BASELINE_INVALID",
        "CANDIDATE_CONSERVATION_FAIL",
        "ORDER_CONSERVATION_FAIL",
        "DUAL_BOOK_RECONCILIATION_FAIL",
        "CASH_RECONCILIATION_FAIL",
        "MARGIN_HEADROOM_BREACH",
        "MAX_LOSS_BREACH",
        "QUOTE_STALE",
        "LIFECYCLE_INCONSISTENT",
        "SETTLEMENT_INCONSISTENT",
        "STATE_HASH_MISMATCH",
        "UNHEDGED_PARTIAL_FILL",
        "FALLBACK_NOT_FEASIBLE",
        "CHALLENGER_INPUT_MISMATCH",
        "CHALLENGER_RISK_BREACH",
        "MATERIAL_DECISION_DISAGREEMENT",
        "ADAPTATION_NON_CONSERVATIVE",
        "ADAPTATION_OUT_OF_BOUNDS",
        "RUNTIME_POLICY_EXPIRED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RuntimeContext": {
      "additionalProperties": false,
      "properties": {
        "cycle_id": {
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "cycle_id",
        "trace_id",
        "decision_time",
        "observed_at",
        "policy_version"
      ],
      "title": "RuntimeContext",
      "type": "object"
    },
    "RuntimeMode": {
      "enum": [
        "NORMAL",
        "HOLD_NO_NEW_RISK",
        "CANCEL_OPEN_ORDERS",
        "CLOSE_ONLY",
        "RISK_REDUCTION_ONLY",
        "HEDGE_ONLY",
        "CONTROLLED_FLATTEN",
        "HALT"
      ],
      "title": "RuntimeMode",
      "type": "string"
    },
    "ShiftMonitorResult": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "metric_results": {
          "items": {
            "$ref": "#/$defs/MetricShiftResult"
          },
          "title": "Metric Results",
          "type": "array"
        },
        "next_states": {
          "items": {
            "$ref": "#/$defs/MetricMonitorState"
          },
          "title": "Next States",
          "type": "array"
        },
        "overall_state": {
          "$ref": "#/$defs/ShiftState"
        }
      },
      "required": [
        "overall_state",
        "metric_results",
        "next_states",
        "generated_at"
      ],
      "title": "ShiftMonitorResult",
      "type": "object"
    },
    "ShiftState": {
      "enum": [
        "IN_DISTRIBUTION",
        "MILD_SHIFT",
        "MATERIAL_SHIFT",
        "TAIL_SHIFT",
        "LIQUIDITY_SHIFT",
        "EXECUTION_MODEL_SHIFT",
        "UNKNOWN_REGIME",
        "MONITOR_DEGRADED"
      ],
      "title": "ShiftState",
      "type": "string"
    },
    "SupervisorPolicy": {
      "additionalProperties": false,
      "properties": {
        "critical_margin_mode": {
          "$ref": "#/$defs/RuntimeMode",
          "default": "CONTROLLED_FLATTEN"
        },
        "material_shift_mode": {
          "$ref": "#/$defs/RuntimeMode",
          "default": "HOLD_NO_NEW_RISK"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "state_inconsistent_mode": {
          "$ref": "#/$defs/RuntimeMode",
          "default": "HOLD_NO_NEW_RISK"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "valid_until"
      ],
      "title": "SupervisorPolicy",
      "type": "object"
    }
  },
  "$id": "https://inferencia.local/schemas/p8/s9/safety_supervisor_request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/RuntimeContext"
    },
    "exposure_state": {
      "$ref": "#/$defs/ExecutionExposureState"
    },
    "invariant_result": {
      "$ref": "#/$defs/InvariantMonitorResult"
    },
    "policy": {
      "$ref": "#/$defs/SupervisorPolicy"
    },
    "shift_result": {
      "$ref": "#/$defs/ShiftMonitorResult"
    }
  },
  "required": [
    "context",
    "shift_result",
    "invariant_result",
    "exposure_state",
    "policy"
  ],
  "title": "SafetySupervisorRequest",
  "type": "object"
}
