{
  "$defs": {
    "AdaptationDecision": {
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ],
      "title": "AdaptationDecision",
      "type": "string"
    },
    "AdaptationKind": {
      "enum": [
        "INCREASE_LIQUIDITY_HAIRCUT",
        "INCREASE_MARGIN_BUFFER",
        "DECREASE_RISK_CAP",
        "DECREASE_PARTICIPATION_RATE",
        "WIDEN_NO_TRADE_REGION",
        "ENTER_RESTRICTED_MODE"
      ],
      "title": "AdaptationKind",
      "type": "string"
    },
    "AdaptationRecord": {
      "additionalProperties": false,
      "properties": {
        "adaptation_id": {
          "title": "Adaptation Id",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/AdaptationDecision"
        },
        "kind": {
          "$ref": "#/$defs/AdaptationKind"
        },
        "previous_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Previous Value"
        },
        "proposed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Proposed Value"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "adaptation_id",
        "kind",
        "previous_value",
        "proposed_value",
        "decision",
        "reason_codes"
      ],
      "title": "AdaptationRecord",
      "type": "object"
    },
    "AlertSeverity": {
      "enum": [
        "INFO",
        "CAUTION",
        "MATERIAL",
        "CRITICAL",
        "STATE_INCONSISTENT",
        "MONITOR_FAILURE"
      ],
      "title": "AlertSeverity",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_sha256",
        "schema_version",
        "contract_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ComparisonState": {
      "enum": [
        "AGREES",
        "BENIGN_DISAGREEMENT",
        "MATERIAL_DISAGREEMENT",
        "UNSAFE_CHALLENGER",
        "CHAMPION_SUSPECT",
        "INPUT_MISMATCH"
      ],
      "title": "ComparisonState",
      "type": "string"
    },
    "InvariantMonitorResult": {
      "additionalProperties": false,
      "properties": {
        "healthy": {
          "title": "Healthy",
          "type": "boolean"
        },
        "highest_severity": {
          "$ref": "#/$defs/AlertSeverity"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/InvariantViolation"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "healthy",
        "highest_severity",
        "violations"
      ],
      "title": "InvariantMonitorResult",
      "type": "object"
    },
    "InvariantViolation": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "title": "Actual",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "invariant_id": {
          "minLength": 1,
          "title": "Invariant Id",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "severity": {
          "$ref": "#/$defs/AlertSeverity"
        }
      },
      "required": [
        "invariant_id",
        "severity",
        "reason_code",
        "expected",
        "actual"
      ],
      "title": "InvariantViolation",
      "type": "object"
    },
    "MetricFamily": {
      "enum": [
        "MARKET",
        "MODEL",
        "RISK",
        "LIQUIDITY",
        "EXECUTION"
      ],
      "title": "MetricFamily",
      "type": "string"
    },
    "MetricMonitorState": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "cusum_negative": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cusum Negative",
          "type": "number"
        },
        "cusum_positive": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cusum Positive",
          "type": "number"
        },
        "ewma_z": {
          "default": 0.0,
          "title": "Ewma Z",
          "type": "number"
        },
        "last_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Observed At"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        }
      },
      "required": [
        "metric_name",
        "count"
      ],
      "title": "MetricMonitorState",
      "type": "object"
    },
    "MetricShiftResult": {
      "additionalProperties": false,
      "properties": {
        "cusum_score": {
          "title": "Cusum Score",
          "type": "number"
        },
        "ewma_z": {
          "title": "Ewma Z",
          "type": "number"
        },
        "family": {
          "$ref": "#/$defs/MetricFamily"
        },
        "metric_name": {
          "title": "Metric Name",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/ShiftState"
        },
        "z_score": {
          "title": "Z Score",
          "type": "number"
        }
      },
      "required": [
        "metric_name",
        "family",
        "z_score",
        "ewma_z",
        "cusum_score",
        "state"
      ],
      "title": "MetricShiftResult",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "MATERIAL_DISTRIBUTION_SHIFT",
        "TAIL_RISK_SHIFT",
        "LIQUIDITY_DETERIORATION",
        "EXECUTION_MODEL_DETERIORATION",
        "MONITOR_DATA_STALE",
        "MONITOR_BASELINE_INVALID",
        "CANDIDATE_CONSERVATION_FAIL",
        "ORDER_CONSERVATION_FAIL",
        "DUAL_BOOK_RECONCILIATION_FAIL",
        "CASH_RECONCILIATION_FAIL",
        "MARGIN_HEADROOM_BREACH",
        "MAX_LOSS_BREACH",
        "QUOTE_STALE",
        "LIFECYCLE_INCONSISTENT",
        "SETTLEMENT_INCONSISTENT",
        "STATE_HASH_MISMATCH",
        "UNHEDGED_PARTIAL_FILL",
        "FALLBACK_NOT_FEASIBLE",
        "CHALLENGER_INPUT_MISMATCH",
        "CHALLENGER_RISK_BREACH",
        "MATERIAL_DECISION_DISAGREEMENT",
        "ADAPTATION_NON_CONSERVATIVE",
        "ADAPTATION_OUT_OF_BOUNDS",
        "RUNTIME_POLICY_EXPIRED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RuntimeContext": {
      "additionalProperties": false,
      "properties": {
        "cycle_id": {
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "cycle_id",
        "trace_id",
        "decision_time",
        "observed_at",
        "policy_version"
      ],
      "title": "RuntimeContext",
      "type": "object"
    },
    "RuntimeControlCommand": {
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "command_id": {
          "minLength": 1,
          "title": "Command Id",
          "type": "string"
        },
        "feasibility_proven": {
          "title": "Feasibility Proven",
          "type": "boolean"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/RuntimeMode"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "mode",
        "reason_codes",
        "issued_at",
        "valid_until",
        "idempotency_key",
        "allowed_actions",
        "feasibility_proven"
      ],
      "title": "RuntimeControlCommand",
      "type": "object"
    },
    "RuntimeMode": {
      "enum": [
        "NORMAL",
        "HOLD_NO_NEW_RISK",
        "CANCEL_OPEN_ORDERS",
        "CLOSE_ONLY",
        "RISK_REDUCTION_ONLY",
        "HEDGE_ONLY",
        "CONTROLLED_FLATTEN",
        "HALT"
      ],
      "title": "RuntimeMode",
      "type": "string"
    },
    "SafetySupervisorResult": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "$ref": "#/$defs/RuntimeControlCommand"
        },
        "selected_mode": {
          "$ref": "#/$defs/RuntimeMode"
        },
        "trigger_severity": {
          "$ref": "#/$defs/AlertSeverity"
        },
        "trigger_shift_state": {
          "$ref": "#/$defs/ShiftState"
        }
      },
      "required": [
        "selected_mode",
        "command",
        "trigger_severity",
        "trigger_shift_state"
      ],
      "title": "SafetySupervisorResult",
      "type": "object"
    },
    "ShadowEvaluationResult": {
      "additionalProperties": false,
      "properties": {
        "absolute_risk_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Absolute Risk Difference"
        },
        "action_agrees": {
          "title": "Action Agrees",
          "type": "boolean"
        },
        "challenger_execution_authority": {
          "const": false,
          "default": false,
          "title": "Challenger Execution Authority",
          "type": "boolean"
        },
        "comparison_state": {
          "$ref": "#/$defs/ComparisonState"
        },
        "max_absolute_quantity_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Absolute Quantity Difference"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "comparison_state",
        "action_agrees",
        "max_absolute_quantity_difference",
        "absolute_risk_difference",
        "reason_codes"
      ],
      "title": "ShadowEvaluationResult",
      "type": "object"
    },
    "ShiftMonitorResult": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "metric_results": {
          "items": {
            "$ref": "#/$defs/MetricShiftResult"
          },
          "title": "Metric Results",
          "type": "array"
        },
        "next_states": {
          "items": {
            "$ref": "#/$defs/MetricMonitorState"
          },
          "title": "Next States",
          "type": "array"
        },
        "overall_state": {
          "$ref": "#/$defs/ShiftState"
        }
      },
      "required": [
        "overall_state",
        "metric_results",
        "next_states",
        "generated_at"
      ],
      "title": "ShiftMonitorResult",
      "type": "object"
    },
    "ShiftState": {
      "enum": [
        "IN_DISTRIBUTION",
        "MILD_SHIFT",
        "MATERIAL_SHIFT",
        "TAIL_SHIFT",
        "LIQUIDITY_SHIFT",
        "EXECUTION_MODEL_SHIFT",
        "UNKNOWN_REGIME",
        "MONITOR_DEGRADED"
      ],
      "title": "ShiftState",
      "type": "string"
    }
  },
  "$id": "https://inferencia.local/schemas/p8/s9/runtime_evidence_bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adaptations": {
      "items": {
        "$ref": "#/$defs/AdaptationRecord"
      },
      "title": "Adaptations",
      "type": "array"
    },
    "bundle_id": {
      "minLength": 1,
      "title": "Bundle Id",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/RuntimeContext"
    },
    "invariant_result": {
      "$ref": "#/$defs/InvariantMonitorResult"
    },
    "production_promotion_allowed": {
      "default": false,
      "title": "Production Promotion Allowed",
      "type": "boolean"
    },
    "shadow_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShadowEvaluationResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "shift_result": {
      "$ref": "#/$defs/ShiftMonitorResult"
    },
    "source_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Source Artifacts",
      "type": "array"
    },
    "supervisor_result": {
      "$ref": "#/$defs/SafetySupervisorResult"
    }
  },
  "required": [
    "bundle_id",
    "context",
    "shift_result",
    "invariant_result",
    "supervisor_result",
    "shadow_result",
    "adaptations",
    "source_artifacts"
  ],
  "title": "RuntimeEvidenceBundle",
  "type": "object"
}
