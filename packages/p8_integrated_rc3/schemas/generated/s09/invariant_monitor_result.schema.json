{
  "$defs": {
    "AlertSeverity": {
      "enum": [
        "INFO",
        "CAUTION",
        "MATERIAL",
        "CRITICAL",
        "STATE_INCONSISTENT",
        "MONITOR_FAILURE"
      ],
      "title": "AlertSeverity",
      "type": "string"
    },
    "InvariantViolation": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "title": "Actual",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "invariant_id": {
          "minLength": 1,
          "title": "Invariant Id",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "severity": {
          "$ref": "#/$defs/AlertSeverity"
        }
      },
      "required": [
        "invariant_id",
        "severity",
        "reason_code",
        "expected",
        "actual"
      ],
      "title": "InvariantViolation",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "MATERIAL_DISTRIBUTION_SHIFT",
        "TAIL_RISK_SHIFT",
        "LIQUIDITY_DETERIORATION",
        "EXECUTION_MODEL_DETERIORATION",
        "MONITOR_DATA_STALE",
        "MONITOR_BASELINE_INVALID",
        "CANDIDATE_CONSERVATION_FAIL",
        "ORDER_CONSERVATION_FAIL",
        "DUAL_BOOK_RECONCILIATION_FAIL",
        "CASH_RECONCILIATION_FAIL",
        "MARGIN_HEADROOM_BREACH",
        "MAX_LOSS_BREACH",
        "QUOTE_STALE",
        "LIFECYCLE_INCONSISTENT",
        "SETTLEMENT_INCONSISTENT",
        "STATE_HASH_MISMATCH",
        "UNHEDGED_PARTIAL_FILL",
        "FALLBACK_NOT_FEASIBLE",
        "CHALLENGER_INPUT_MISMATCH",
        "CHALLENGER_RISK_BREACH",
        "MATERIAL_DECISION_DISAGREEMENT",
        "ADAPTATION_NON_CONSERVATIVE",
        "ADAPTATION_OUT_OF_BOUNDS",
        "RUNTIME_POLICY_EXPIRED"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "$id": "https://inferencia.local/schemas/p8/s9/invariant_monitor_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "healthy": {
      "title": "Healthy",
      "type": "boolean"
    },
    "highest_severity": {
      "$ref": "#/$defs/AlertSeverity"
    },
    "violations": {
      "items": {
        "$ref": "#/$defs/InvariantViolation"
      },
      "title": "Violations",
      "type": "array"
    }
  },
  "required": [
    "healthy",
    "highest_severity",
    "violations"
  ],
  "title": "InvariantMonitorResult",
  "type": "object"
}
