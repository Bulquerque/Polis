{
  "$defs": {
    "AuditContext": {
      "additionalProperties": false,
      "properties": {
        "audit_time": {
          "format": "date-time",
          "title": "Audit Time",
          "type": "string"
        },
        "contract_version": {
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "cycle_id": {
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "cycle_id",
        "trace_id",
        "decision_time",
        "audit_time"
      ],
      "title": "AuditContext",
      "type": "object"
    },
    "CycleTerminalState": {
      "enum": [
        "NO_ACTION_VALID",
        "EXECUTED_VALID",
        "PARTIALLY_EXECUTED_VALID",
        "RISK_BLOCKED_VALID",
        "PORTFOLIO_INFEASIBLE_VALID",
        "EXECUTION_REJECTED_VALID",
        "BACKTEST_INVALID",
        "STATE_INCONSISTENT",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "CycleTerminalState",
      "type": "string"
    },
    "EconomicQualification": {
      "enum": [
        "DEFERRED_TO_P9"
      ],
      "title": "EconomicQualification",
      "type": "string"
    },
    "ImplementationRobustness": {
      "enum": [
        "PASS",
        "FAIL",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "ImplementationRobustness",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "CANDIDATE_CONSERVATION_FAIL",
        "ORDER_CONSERVATION_FAIL",
        "FILL_LEDGER_MISMATCH",
        "POSITION_RECONCILIATION_FAIL",
        "DUAL_BOOK_RECONCILIATION_FAIL",
        "CASH_RECONCILIATION_FAIL",
        "MARGIN_RECONCILIATION_FAIL",
        "COLLATERAL_RECONCILIATION_FAIL",
        "NAV_RECONCILIATION_FAIL",
        "PNL_RECONCILIATION_FAIL",
        "MARK_UNAVAILABLE",
        "REPLAY_HASH_MISMATCH",
        "EVENT_SEQUENCE_INVALID",
        "TECHNICAL_AUDIT_FAILED",
        "ROBUSTNESS_EVIDENCE_MISSING",
        "ROBUSTNESS_TEST_FAILED",
        "STATISTICAL_SAMPLE_INSUFFICIENT",
        "TRIAL_REGISTRY_INCOMPLETE",
        "HOLDOUT_VIOLATED",
        "DSR_BELOW_THRESHOLD",
        "PBO_ABOVE_THRESHOLD",
        "EVIDENCE_CLASS_INVALID",
        "CANDIDATE_EVIDENCE_MISSING",
        "LINEAGE_INCOMPLETE",
        "EVALUATION_COMMITMENT_LATE",
        "FILE_OUTSIDE_RELEASE_ROOT",
        "FILE_HASH_MISMATCH",
        "RELEASE_EVIDENCE_INCOMPLETE",
        "PRODUCTION_PROMOTION_FORBIDDEN"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "StatisticalDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "deflated_sharpe_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deflated Sharpe Ratio"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "probability_backtest_overfitting": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Probability Backtest Overfitting"
        },
        "sharpe_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sharpe Ratio"
        }
      },
      "required": [
        "observation_count",
        "sharpe_ratio",
        "deflated_sharpe_ratio",
        "probability_backtest_overfitting"
      ],
      "title": "StatisticalDiagnostics",
      "type": "object"
    },
    "StatisticalQualification": {
      "enum": [
        "QUALIFIED",
        "FAILED",
        "INSUFFICIENT_EVIDENCE",
        "NOT_APPLICABLE"
      ],
      "title": "StatisticalQualification",
      "type": "string"
    },
    "TechnicalValidity": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "TechnicalValidity",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/AuditContext"
    },
    "diagnostics": {
      "$ref": "#/$defs/StatisticalDiagnostics"
    },
    "economic_qualification": {
      "$ref": "#/$defs/EconomicQualification",
      "default": "DEFERRED_TO_P9"
    },
    "eligible_for_p9_evaluation": {
      "title": "Eligible For P9 Evaluation",
      "type": "boolean"
    },
    "implementation_robustness": {
      "$ref": "#/$defs/ImplementationRobustness"
    },
    "production_promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Production Promotion Allowed",
      "type": "boolean"
    },
    "qualification_id": {
      "minLength": 1,
      "title": "Qualification Id",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "statistical_qualification": {
      "$ref": "#/$defs/StatisticalQualification"
    },
    "technical_validity": {
      "$ref": "#/$defs/TechnicalValidity"
    },
    "terminal_state": {
      "$ref": "#/$defs/CycleTerminalState"
    }
  },
  "required": [
    "qualification_id",
    "context",
    "terminal_state",
    "technical_validity",
    "implementation_robustness",
    "statistical_qualification",
    "diagnostics",
    "reason_codes",
    "eligible_for_p9_evaluation"
  ],
  "title": "QualificationDecision",
  "type": "object"
}
