{
  "$defs": {
    "AuditCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "expected_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Value"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Value"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "residual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual"
        },
        "status": {
          "$ref": "#/$defs/AuditCheckStatus"
        }
      },
      "required": [
        "check_id",
        "status"
      ],
      "title": "AuditCheck",
      "type": "object"
    },
    "AuditCheckStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "WARNING",
        "NOT_APPLICABLE"
      ],
      "title": "AuditCheckStatus",
      "type": "string"
    },
    "AuditContext": {
      "additionalProperties": false,
      "properties": {
        "audit_time": {
          "format": "date-time",
          "title": "Audit Time",
          "type": "string"
        },
        "contract_version": {
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "cycle_id": {
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "cycle_id",
        "trace_id",
        "decision_time",
        "audit_time"
      ],
      "title": "AuditContext",
      "type": "object"
    },
    "AuditOverallStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ],
      "title": "AuditOverallStatus",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "CANDIDATE_CONSERVATION_FAIL",
        "ORDER_CONSERVATION_FAIL",
        "FILL_LEDGER_MISMATCH",
        "POSITION_RECONCILIATION_FAIL",
        "DUAL_BOOK_RECONCILIATION_FAIL",
        "CASH_RECONCILIATION_FAIL",
        "MARGIN_RECONCILIATION_FAIL",
        "COLLATERAL_RECONCILIATION_FAIL",
        "NAV_RECONCILIATION_FAIL",
        "PNL_RECONCILIATION_FAIL",
        "MARK_UNAVAILABLE",
        "REPLAY_HASH_MISMATCH",
        "EVENT_SEQUENCE_INVALID",
        "TECHNICAL_AUDIT_FAILED",
        "ROBUSTNESS_EVIDENCE_MISSING",
        "ROBUSTNESS_TEST_FAILED",
        "STATISTICAL_SAMPLE_INSUFFICIENT",
        "TRIAL_REGISTRY_INCOMPLETE",
        "HOLDOUT_VIOLATED",
        "DSR_BELOW_THRESHOLD",
        "PBO_ABOVE_THRESHOLD",
        "EVIDENCE_CLASS_INVALID",
        "CANDIDATE_EVIDENCE_MISSING",
        "LINEAGE_INCOMPLETE",
        "EVALUATION_COMMITMENT_LATE",
        "FILE_OUTSIDE_RELEASE_ROOT",
        "FILE_HASH_MISMATCH",
        "RELEASE_EVIDENCE_INCOMPLETE",
        "PRODUCTION_PROMOTION_FORBIDDEN"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_id": {
      "minLength": 1,
      "title": "Audit Id",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/AuditCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "context": {
      "$ref": "#/$defs/AuditContext"
    },
    "failure_count": {
      "minimum": 0,
      "title": "Failure Count",
      "type": "integer"
    },
    "independent_implementation": {
      "title": "Independent Implementation",
      "type": "boolean"
    },
    "overall_status": {
      "$ref": "#/$defs/AuditOverallStatus"
    },
    "production_promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Production Promotion Allowed",
      "type": "boolean"
    },
    "replayed_state_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Replayed State Sha256",
      "type": "string"
    },
    "warning_count": {
      "minimum": 0,
      "title": "Warning Count",
      "type": "integer"
    }
  },
  "required": [
    "audit_id",
    "context",
    "overall_status",
    "checks",
    "failure_count",
    "warning_count",
    "replayed_state_sha256",
    "independent_implementation"
  ],
  "title": "IndependentAuditReport",
  "type": "object"
}
