{
  "$defs": {
    "DependenceStateRecord": {
      "additionalProperties": false,
      "properties": {
        "champion_status": {
          "minLength": 1,
          "title": "Champion Status",
          "type": "string"
        },
        "condition_number": {
          "minimum": 1.0,
          "title": "Condition Number",
          "type": "number"
        },
        "correlation_matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "minItems": 2,
          "title": "Correlation Matrix",
          "type": "array"
        },
        "covariance_matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "minItems": 2,
          "title": "Covariance Matrix",
          "type": "array"
        },
        "covariance_type": {
          "minLength": 1,
          "title": "Covariance Type",
          "type": "string"
        },
        "effective_rank": {
          "exclusiveMinimum": 0.0,
          "title": "Effective Rank",
          "type": "number"
        },
        "estimation_window": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ],
          "title": "Estimation Window",
          "type": "array"
        },
        "horizon": {
          "minLength": 1,
          "title": "Horizon",
          "type": "string"
        },
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "psd_status": {
          "minLength": 1,
          "title": "Psd Status",
          "type": "string"
        },
        "repair_magnitude": {
          "minimum": 0.0,
          "title": "Repair Magnitude",
          "type": "number"
        },
        "underlying_order": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Underlying Order",
          "type": "array"
        }
      },
      "required": [
        "covariance_type",
        "covariance_matrix",
        "correlation_matrix",
        "effective_rank",
        "condition_number",
        "psd_status",
        "repair_magnitude",
        "estimation_window",
        "underlying_order",
        "horizon",
        "champion_status",
        "lineage_id"
      ],
      "title": "DependenceStateRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "title": "Lineage Id",
      "type": "string"
    },
    "producer_module_id": {
      "pattern": "^P5\\.S[1-9]\\.M\\d{2}$",
      "title": "Producer Module Id",
      "type": "string"
    },
    "producer_phase": {
      "default": "P5",
      "pattern": "^P5$",
      "title": "Producer Phase",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/DependenceStateRecord"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_sha256",
    "producer_module_id",
    "run_id",
    "cycle_id",
    "decision_time",
    "created_at",
    "available_at",
    "lineage_id",
    "records"
  ],
  "title": "DependenceState",
  "type": "object"
}
