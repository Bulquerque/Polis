{
  "$defs": {
    "RegimeOODStateRecord": {
      "additionalProperties": false,
      "properties": {
        "change_point_probability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Point Probability"
        },
        "dependence_ood": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependence Ood"
        },
        "expected_duration": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Expected Duration",
          "type": "object"
        },
        "feature_ood": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Ood"
        },
        "horizon": {
          "minLength": 1,
          "title": "Horizon",
          "type": "string"
        },
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "market_state_ood": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market State Ood"
        },
        "model_ood": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ood"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "regime_probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "minProperties": 1,
          "title": "Regime Probabilities",
          "type": "object"
        },
        "severity": {
          "minLength": 1,
          "title": "Severity",
          "type": "string"
        },
        "transition_probabilities": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "title": "Transition Probabilities",
          "type": "object"
        },
        "underlying": {
          "minLength": 1,
          "title": "Underlying",
          "type": "string"
        },
        "validity_status": {
          "$ref": "#/$defs/ValidityStatus",
          "default": "VALID"
        }
      },
      "required": [
        "underlying",
        "horizon",
        "regime_probabilities",
        "severity",
        "lineage_id"
      ],
      "title": "RegimeOODStateRecord",
      "type": "object"
    },
    "ValidityStatus": {
      "enum": [
        "VALID",
        "DEGRADED",
        "LIMITED",
        "REJECTED",
        "UNAVAILABLE"
      ],
      "title": "ValidityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "title": "Lineage Id",
      "type": "string"
    },
    "producer_module_id": {
      "pattern": "^P5\\.S[1-9]\\.M\\d{2}$",
      "title": "Producer Module Id",
      "type": "string"
    },
    "producer_phase": {
      "default": "P5",
      "pattern": "^P5$",
      "title": "Producer Phase",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/RegimeOODStateRecord"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_sha256",
    "producer_module_id",
    "run_id",
    "cycle_id",
    "decision_time",
    "created_at",
    "available_at",
    "lineage_id",
    "records"
  ],
  "title": "RegimeOODState",
  "type": "object"
}
