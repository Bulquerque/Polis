{
  "$defs": {
    "ScenarioPathRecord": {
      "additionalProperties": false,
      "properties": {
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "future_return": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Future Return"
        },
        "future_spot": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Future Spot"
        },
        "generator_id": {
          "minLength": 1,
          "title": "Generator Id",
          "type": "string"
        },
        "horizon": {
          "minLength": 1,
          "title": "Horizon",
          "type": "string"
        },
        "implied_volatility_state": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Implied Volatility State"
        },
        "jump_state": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jump State"
        },
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "liquidity_state": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Liquidity State"
        },
        "path_step": {
          "minimum": 0,
          "title": "Path Step",
          "type": "integer"
        },
        "path_timestamp": {
          "format": "date-time",
          "title": "Path Timestamp",
          "type": "string"
        },
        "probability": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability"
        },
        "realized_volatility_state": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realized Volatility State"
        },
        "regime_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regime State"
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_type": {
          "$ref": "#/$defs/ScenarioType"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "skew_state": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skew State"
        },
        "stress_flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Stress Flags",
          "type": "array"
        },
        "term_structure_state": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Term Structure State"
        },
        "underlying": {
          "minLength": 1,
          "title": "Underlying",
          "type": "string"
        }
      },
      "required": [
        "underlying",
        "decision_time",
        "horizon",
        "scenario_id",
        "scenario_type",
        "path_step",
        "path_timestamp",
        "seed",
        "generator_id",
        "lineage_id"
      ],
      "title": "ScenarioPathRecord",
      "type": "object"
    },
    "ScenarioType": {
      "enum": [
        "NOMINAL",
        "ADVERSARIAL",
        "STRESS"
      ],
      "title": "ScenarioType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "title": "Lineage Id",
      "type": "string"
    },
    "producer_module_id": {
      "pattern": "^P5\\.S[1-9]\\.M\\d{2}$",
      "title": "Producer Module Id",
      "type": "string"
    },
    "producer_phase": {
      "default": "P5",
      "pattern": "^P5$",
      "title": "Producer Phase",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ScenarioPathRecord"
      },
      "minItems": 2,
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_sha256",
    "producer_module_id",
    "run_id",
    "cycle_id",
    "decision_time",
    "created_at",
    "available_at",
    "lineage_id",
    "records"
  ],
  "title": "ScenarioPathPanel",
  "type": "object"
}
