{
  "$defs": {
    "AmbiguitySetRecord": {
      "additionalProperties": false,
      "properties": {
        "ambiguity_method": {
          "minLength": 1,
          "title": "Ambiguity Method",
          "type": "string"
        },
        "calibration_sample_size": {
          "minimum": 1,
          "title": "Calibration Sample Size",
          "type": "integer"
        },
        "coverage_target": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Coverage Target",
          "type": "number"
        },
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "nominal_distribution_id": {
          "minLength": 1,
          "title": "Nominal Distribution Id",
          "type": "string"
        },
        "plausible_distribution_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Plausible Distribution Ids",
          "type": "array"
        },
        "radius_or_band": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Radius Or Band"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Scope",
          "type": "object"
        },
        "stress_distribution_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Stress Distribution Ids",
          "type": "array"
        },
        "validity_status": {
          "$ref": "#/$defs/ValidityStatus"
        }
      },
      "required": [
        "nominal_distribution_id",
        "ambiguity_method",
        "radius_or_band",
        "calibration_sample_size",
        "coverage_target",
        "plausible_distribution_ids",
        "scope",
        "validity_status",
        "lineage_id"
      ],
      "title": "AmbiguitySetRecord",
      "type": "object"
    },
    "ValidityStatus": {
      "enum": [
        "VALID",
        "DEGRADED",
        "LIMITED",
        "REJECTED",
        "UNAVAILABLE"
      ],
      "title": "ValidityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "lineage_id": {
      "minLength": 1,
      "title": "Lineage Id",
      "type": "string"
    },
    "producer_module_id": {
      "pattern": "^P5\\.S[1-9]\\.M\\d{2}$",
      "title": "Producer Module Id",
      "type": "string"
    },
    "producer_phase": {
      "default": "P5",
      "pattern": "^P5$",
      "title": "Producer Phase",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/AmbiguitySetRecord"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_sha256",
    "producer_module_id",
    "run_id",
    "cycle_id",
    "decision_time",
    "created_at",
    "available_at",
    "lineage_id",
    "records"
  ],
  "title": "AmbiguitySet",
  "type": "object"
}
