{
  "$defs": {
    "MinimumSamplePolicy": {
      "additionalProperties": false,
      "properties": {
        "minimum_regression_observations": {
          "default": 30,
          "minimum": 3,
          "title": "Minimum Regression Observations",
          "type": "integer"
        },
        "minimum_return_observations": {
          "default": 20,
          "minimum": 2,
          "title": "Minimum Return Observations",
          "type": "integer"
        },
        "minimum_rolling_observations": {
          "default": 20,
          "minimum": 2,
          "title": "Minimum Rolling Observations",
          "type": "integer"
        },
        "minimum_tail_observations": {
          "default": 50,
          "minimum": 5,
          "title": "Minimum Tail Observations",
          "type": "integer"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version"
      ],
      "title": "MinimumSamplePolicy",
      "type": "object"
    }
  },
  "$id": "https://inferencia.local/p9/s4/1.0.0/DistributionPolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "autocorrelation_lags": {
      "default": [
        1,
        5,
        21
      ],
      "items": {
        "type": "integer"
      },
      "title": "Autocorrelation Lags",
      "type": "array"
    },
    "downside_threshold_per_period": {
      "default": 0.0,
      "title": "Downside Threshold Per Period",
      "type": "number"
    },
    "ljung_box_max_lag": {
      "default": 10,
      "minimum": 1,
      "title": "Ljung Box Max Lag",
      "type": "integer"
    },
    "minimum_samples": {
      "$ref": "#/$defs/MinimumSamplePolicy"
    },
    "policy_id": {
      "title": "Policy Id",
      "type": "string"
    },
    "policy_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Policy Version",
      "type": "string"
    },
    "rolling_windows": {
      "default": [
        20,
        60,
        252
      ],
      "items": {
        "type": "integer"
      },
      "title": "Rolling Windows",
      "type": "array"
    }
  },
  "required": [
    "policy_id",
    "policy_version",
    "minimum_samples"
  ],
  "title": "DistributionPolicy",
  "type": "object"
}
