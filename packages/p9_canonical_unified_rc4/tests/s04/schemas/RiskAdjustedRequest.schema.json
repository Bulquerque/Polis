        "net_skewness": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Net Skewness"
        },
        "net_volatility_annualized": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Net Volatility Annualized"
        },
        "window": {
          "minimum": 2,
          "title": "Window",
          "type": "integer"
