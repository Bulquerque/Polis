{
  "$defs": {
    "DiagnosticRecord": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "severity": {
          "pattern": "^(INFO|WARNING|ERROR|BLOCKER)$",
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "severity"
      ],
      "title": "DiagnosticRecord",
      "type": "object"
    },
    "DistributionDiagnosticPanel": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "diagnostics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DiagnosticRecord"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "identity": {
          "$ref": "#/$defs/QualifiedBacktestIdentity"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metrics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricRecord"
          },
          "title": "Metrics",
          "type": "array"
        },
        "panel_id": {
          "title": "Panel Id",
          "type": "string"
        },
        "panel_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Panel Version",
          "type": "string"
        },
        "rolling": {
          "items": {
            "$ref": "#/$defs/RollingDistributionRecord"
          },
          "title": "Rolling",
          "type": "array"
        },
        "serial_correlations": {
          "items": {
            "$ref": "#/$defs/SerialCorrelationRecord"
          },
          "title": "Serial Correlations",
          "type": "array"
        }
      },
      "required": [
        "panel_id",
        "panel_version",
        "identity",
        "content_sha256",
        "serial_correlations",
        "rolling"
      ],
      "title": "DistributionDiagnosticPanel",
      "type": "object"
    },
    "DistributionEngineResult": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "$ref": "#/$defs/DistributionDiagnosticPanel"
        },
        "serial_dependence": {
          "$ref": "#/$defs/SerialDependenceReport"
        },
        "volatility": {
          "$ref": "#/$defs/VolatilityMetricPanel"
        }
      },
      "required": [
        "volatility",
        "diagnostics",
        "serial_dependence"
      ],
      "title": "DistributionEngineResult",
      "type": "object"
    },
    "DrawdownMetricPanel": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "diagnostics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DiagnosticRecord"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "identity": {
          "$ref": "#/$defs/QualifiedBacktestIdentity"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metrics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricRecord"
          },
          "title": "Metrics",
          "type": "array"
        },
        "open_episode_count": {
          "minimum": 0,
          "title": "Open Episode Count",
          "type": "integer"
        },
        "panel_id": {
          "title": "Panel Id",
          "type": "string"
        },
        "panel_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Panel Version",
          "type": "string"
        }
      },
      "required": [
        "panel_id",
        "panel_version",
        "identity",
        "content_sha256",
        "open_episode_count"
      ],
      "title": "DrawdownMetricPanel",
      "type": "object"
    },
    "GrossNet": {
      "enum": [
        "GROSS",
        "NET",
        "ACTIVE",
        "EXCESS",
        "NOT_APPLICABLE"
      ],
      "title": "GrossNet",
      "type": "string"
    },
    "MetricRecord": {
      "additionalProperties": false,
      "properties": {
        "annualization_periods": {
          "anyOf": [
            {
              "gt": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annualization Periods"
        },
        "gross_net": {
          "$ref": "#/$defs/GrossNet",
          "default": "NOT_APPLICABLE"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Metric Version",
          "type": "string"
        },
        "producer_module_id": {
          "title": "Producer Module Id",
          "type": "string"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "metric_id",
        "metric_version",
        "producer_module_id",
        "value",
        "unit",
        "status",
        "sample_count",
        "method"
      ],
      "title": "MetricRecord",
      "type": "object"
    },
    "MetricStatus": {
      "enum": [
        "QUALIFIED",
        "LIMITED",
        "UNAVAILABLE",
        "INSUFFICIENT_SAMPLE",
        "UNDEFINED",
        "INVALID"
      ],
      "title": "MetricStatus",
      "type": "string"
    },
    "PointInTimeSeries": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/SeriesPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "series_id": {
          "title": "Series Id",
          "type": "string"
        },
        "series_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Series Version",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "series_version",
        "points",
        "content_sha256"
      ],
      "title": "PointInTimeSeries",
      "type": "object"
    },
    "QualifiedBacktestIdentity": {
      "additionalProperties": false,
      "properties": {
        "configuration_id": {
          "title": "Configuration Id",
          "type": "string"
        },
        "cycle_id": {
          "title": "Cycle Id",
          "type": "string"
        },
        "fold_id": {
          "title": "Fold Id",
          "type": "string"
        },
        "handoff_id": {
          "title": "Handoff Id",
          "type": "string"
        },
        "handoff_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Handoff Sha256",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "cycle_id",
        "trial_id",
        "fold_id",
        "configuration_id",
        "handoff_id",
        "handoff_sha256"
      ],
      "title": "QualifiedBacktestIdentity",
      "type": "object"
    },
    "ReturnConvention": {
      "enum": [
        "SIMPLE",
        "LOG"
      ],
      "title": "ReturnConvention",
      "type": "string"
    },
    "ReturnEngineResult": {
      "additionalProperties": false,
      "properties": {
        "reconciliation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reconciliation Sha256",
          "type": "string"
