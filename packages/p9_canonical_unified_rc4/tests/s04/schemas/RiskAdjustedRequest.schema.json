        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metrics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricRecord"
          },
          "title": "Metrics",
          "type": "array"
        },
        "net_returns": {
          "items": {
            "type": "number"
          },
          "title": "Net Returns",
          "type": "array"
        },
        "panel_id": {
          "title": "Panel Id",
          "type": "string"
        },
        "panel_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Panel Version",
          "type": "string"
        },
        "periods_per_year": {
          "title": "Periods Per Year",
          "type": "number"
        },
        "timestamps": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Timestamps",
          "type": "array"
        }
      },
      "required": [
        "panel_id",
        "panel_version",
        "identity",
        "content_sha256",
        "timestamps",
        "gross_returns",
        "net_returns",
        "periods_per_year"
      ],
      "title": "ReturnSeriesPanel",
      "type": "object"
    },
    "RiskAdjustedMetricPolicy": {
      "additionalProperties": false,
      "properties": {
        "autocorrelation_max_lag": {
          "default": 10,
          "minimum": 0,
          "title": "Autocorrelation Max Lag",
          "type": "integer"
        },
        "mar_per_period": {
          "default": 0.0,
          "title": "Mar Per Period",
          "type": "number"
        },
        "minimum_observations": {
          "default": 20,
          "minimum": 2,
          "title": "Minimum Observations",
          "type": "integer"
        },
        "omega_threshold_per_period": {
          "default": 0.0,
          "title": "Omega Threshold Per Period",
          "type": "number"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Policy Version",
          "type": "string"
        },
        "probabilistic_sharpe_benchmark": {
          "default": 0.0,
          "title": "Probabilistic Sharpe Benchmark",
          "type": "number"
        },
        "psr_confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0.5,
          "title": "Psr Confidence Level",
          "type": "number"
        }
      },
      "required": [
        "policy_id",
        "policy_version"
      ],
      "title": "RiskAdjustedMetricPolicy",
      "type": "object"
    },
    "RollingDistributionRecord": {
      "additionalProperties": false,
