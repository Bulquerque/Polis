{
  "additionalProperties": false,
  "properties": {
    "check_id": {
      "minLength": 1,
      "title": "Check Id",
      "type": "string"
    },
    "details": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Details",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "pattern": "^P9_[A-Z0-9_]+$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "check_id",
    "passed"
  ],
  "title": "ValidationCheck",
  "type": "object"
}
