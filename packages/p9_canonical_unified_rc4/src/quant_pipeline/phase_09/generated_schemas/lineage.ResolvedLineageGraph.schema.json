{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Artifact Schema Version",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/Availability",
          "default": "AVAILABLE"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "backtest_id": {
          "minLength": 1,
          "title": "Backtest Id",
          "type": "string"
        },
        "computed_at": {
          "format": "date-time",
          "title": "Computed At",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "cycle_id": {
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "decision_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Time"
        },
        "event_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Time"
        },
        "grain": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Grain",
          "type": "array"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "maturity_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maturity At"
        },
        "parent_artifact_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "producer_module_id": {
          "pattern": "^P[0-9]+\\.S[0-9]+\\.M[0-9]+$",
          "title": "Producer Module Id",
          "type": "string"
        },
        "record_count": {
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_name": {
          "minLength": 1,
          "title": "Schema Name",
          "type": "string"
        },
        "schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Sha256",
          "type": "string"
        },
        "settlement_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settlement At"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "schema_name",
        "artifact_schema_version",
        "schema_sha256",
        "content_sha256",
        "producer_module_id",
        "run_id",
        "cycle_id",
        "backtest_id",
        "available_at",
        "computed_at",
        "location",
        "record_count"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "Availability": {
      "enum": [
        "AVAILABLE",
        "LIMITED",
        "UNAVAILABLE",
        "RESERVED"
      ],
      "title": "Availability",
      "type": "string"
    },
    "LineageEdge": {
      "additionalProperties": false,
      "properties": {
        "activity_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Id"
        },
        "child_node_id": {
          "minLength": 1,
          "title": "Child Node Id",
          "type": "string"
        },
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "parent_node_id": {
          "minLength": 1,
          "title": "Parent Node Id",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/LineageRelation"
        }
      },
      "required": [
        "edge_id",
        "parent_node_id",
        "child_node_id",
        "relation",
        "occurred_at"
      ],
      "title": "LineageEdge",
      "type": "object"
    },
    "LineageGap": {
      "additionalProperties": false,
      "properties": {
        "affected_node_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affected Node Ids",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "gap_id": {
          "minLength": 1,
          "title": "Gap Id",
          "type": "string"
        },
        "material": {
          "title": "Material",
          "type": "boolean"
        },
        "reason_code": {
          "pattern": "^P9_[A-Z0-9_]+$",
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "gap_id",
        "description",
        "material",
        "reason_code"
      ],
      "title": "LineageGap",
      "type": "object"
    },
    "LineageNode": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "phase_id": {
          "pattern": "^P[0-9]+$",
          "title": "Phase Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "phase_id",
        "entity_type",
        "artifact",
        "generated_at"
      ],
      "title": "LineageNode",
      "type": "object"
    },
    "LineageRelation": {
      "enum": [
        "DERIVED_FROM",
        "USED",
        "GENERATED_BY",
        "ASSOCIATED_WITH",
        "SPECIALIZATION_OF"
      ],
      "title": "LineageRelation",
      "type": "string"
    },
    "LineageResolutionStatus": {
      "enum": [
        "RESOLVED_COMPLETE",
        "RESOLVED_WITH_NONMATERIAL_GAPS",
        "INCOMPLETE_MATERIAL",
        "CORRUPT",
        "UNAVAILABLE"
      ],
      "title": "LineageResolutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/LineageEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/LineageGap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "graph_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Graph Sha256",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/LineageNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/LineageResolutionStatus"
    },
    "topological_order": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Topological Order",
      "type": "array"
    }
  },
  "required": [
    "status",
    "nodes",
    "edges",
    "topological_order",
    "gaps",
    "graph_sha256"
  ],
  "title": "ResolvedLineageGraph",
  "type": "object"
}
