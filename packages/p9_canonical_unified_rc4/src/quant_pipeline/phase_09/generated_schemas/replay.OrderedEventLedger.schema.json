{
  "$defs": {
    "IntegrityEnvelope": {
      "additionalProperties": false,
      "properties": {
        "canonicalization_version": {
          "default": "P9-C14N-JSON-1",
          "minLength": 1,
          "title": "Canonicalization Version",
          "type": "string"
        },
        "hash_algorithm": {
          "default": "sha256",
          "minLength": 1,
          "title": "Hash Algorithm",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        }
      },
      "required": [
        "payload_sha256"
      ],
      "title": "IntegrityEnvelope",
      "type": "object"
    },
    "OrderedEventLedgerPayload": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/ReplayEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "ledger_id": {
          "minLength": 1,
          "title": "Ledger Id",
          "type": "string"
        }
      },
      "required": [
        "ledger_id",
        "events"
      ],
      "title": "OrderedEventLedgerPayload",
      "type": "object"
    },
    "ReplayEvent": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "cash_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cash Amount"
        },
        "contract_multiplier": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1",
          "title": "Contract Multiplier"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/ReplayEventType"
        },
        "fee_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Fee Amount"
        },
        "fill_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill Id"
        },
        "instrument_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instrument Id"
        },
        "margin_used": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Used"
        },
        "mark_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mark Price"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "order_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Id"
        },
        "position_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Id"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "quantity_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Quantity Delta"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "settlement_cash": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settlement Cash"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "occurred_at",
        "event_type"
      ],
      "title": "ReplayEvent",
      "type": "object"
    },
    "ReplayEventType": {
      "enum": [
        "ORDER_ACCEPTED",
        "ORDER_REJECTED",
        "FILL",
        "FEE",
        "MARK",
        "MARGIN_UPDATE",
        "CASH_ADJUSTMENT",
        "SETTLEMENT"
      ],
      "title": "ReplayEventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "integrity": {
      "$ref": "#/$defs/IntegrityEnvelope"
    },
    "payload": {
      "$ref": "#/$defs/OrderedEventLedgerPayload"
    }
  },
  "required": [
    "payload",
    "integrity"
  ],
  "title": "OrderedEventLedger",
  "type": "object"
}
