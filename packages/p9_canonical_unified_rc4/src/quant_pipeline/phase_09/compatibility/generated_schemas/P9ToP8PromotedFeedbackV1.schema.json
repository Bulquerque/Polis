        "source_cycle_id": {
          "minLength": 1,
          "title": "Source Cycle Id",
          "type": "string"
        },
        "source_cycle_sequence": {
          "minimum": 0,
          "title": "Source Cycle Sequence",
          "type": "integer"
        },
        "target_cycle_id": {
