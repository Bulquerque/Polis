          "type": "string"
        },
        "p0_authorization_ref": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "p9_recommendation_ref": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "payload": {
          "$ref": "#/$defs/ExecutionPolicyPayload"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
