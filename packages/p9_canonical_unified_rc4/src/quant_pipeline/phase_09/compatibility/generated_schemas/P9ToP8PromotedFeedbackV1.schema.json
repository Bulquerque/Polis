    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "relationship_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship Type"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "schema_version",
        "contract_version",
        "content_sha256",
        "available_at"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ExecutionPolicyFeedback": {
