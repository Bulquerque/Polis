          "title": "Effective From Sequence",
          "type": "integer"
        },
        "expires_after_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires After Sequence"
        },
        "feedback_id": {
          "minLength": 1,
          "title": "Feedback Id",
