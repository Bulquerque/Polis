  "additionalProperties": false,
  "properties": {
    "access_policy_id": {
      "title": "Access Policy Id",
      "type": "string"
    },
    "allowed_consumer_module_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Allowed Consumer Module Ids",
      "type": "array"
    },
    "holdout_window": {
      "$ref": "#/$defs/TimeWindow"
    },
    "opened_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
