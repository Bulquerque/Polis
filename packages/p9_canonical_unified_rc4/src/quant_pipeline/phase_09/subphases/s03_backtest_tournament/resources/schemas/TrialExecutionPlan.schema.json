{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_schema_name": {
          "title": "Artifact Schema Name",
          "type": "string"
        },
        "artifact_schema_version": {
          "title": "Artifact Schema Version",
          "type": "string"
        },
        "artifact_type": {
          "title": "Artifact Type",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/Availability",
          "default": "AVAILABLE"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "cycle_id": {
          "title": "Cycle Id",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "producer_module_id": {
          "title": "Producer Module Id",
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Count"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "artifact_schema_name",
        "artifact_schema_version",
        "content_sha256",
        "producer_module_id",
        "run_id",
        "cycle_id",
        "available_at",
        "location"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "Availability": {
      "enum": [
        "AVAILABLE",
        "LIMITED",
        "UNAVAILABLE",
        "LEGACY_RESEARCH_ONLY"
      ],
      "title": "Availability",
      "type": "string"
    },
    "CandidateTerminalRecord": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/CandidateTerminalState"
        }
      },
      "required": [
        "candidate_id",
        "state"
      ],
      "title": "CandidateTerminalRecord",
      "type": "object"
    },
    "CandidateTerminalState": {
      "enum": [
        "GENERATED",
        "RANKED",
        "BLOCKED",
        "ABSTAINED",
        "SELECTED",
        "NOT_SELECTED",
        "EXECUTED",
        "NO_ACTION"
      ],
      "title": "CandidateTerminalState",
      "type": "string"
    },
    "CashCategory": {
      "enum": [
        "FILL",
        "DEPOSIT",
        "WITHDRAWAL",
        "INTEREST",
        "FINANCING",
        "BORROW",
        "LIFECYCLE",
        "OTHER_FEE"
      ],
      "title": "CashCategory",
      "type": "string"
    },
    "CashLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "category": {
          "$ref": "#/$defs/CashCategory"
        },
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "related_fill_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Fill Id"
        },
        "related_lifecycle_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Lifecycle Id"
        }
      },
      "required": [
        "entry_id",
        "event_time",
        "amount",
        "category"
      ],
      "title": "CashLedgerEntry",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "FULL_PIPELINE",
        "FIXED_P8_REPLAY"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "FillRecord": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "fee": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Fee"
        },
        "fill_id": {
          "title": "Fill Id",
          "type": "string"
        },
        "fill_time": {
          "format": "date-time",
          "title": "Fill Time",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Price"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "side": {
          "$ref": "#/$defs/Side"
        }
      },
      "required": [
        "fill_id",
        "order_id",
        "instrument_id",
        "side",
        "quantity",
        "price",
        "fee",
        "fill_time",
        "available_at"
      ],
      "title": "FillRecord",
      "type": "object"
    },
    "LifecycleEvent": {
      "additionalProperties": false,
      "properties": {
        "cash_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cash Amount"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/LifecycleType"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "quantity_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Quantity Delta"
        }
      },
      "required": [
        "event_id",
        "instrument_id",
        "event_type",
        "event_time"
      ],
      "title": "LifecycleEvent",
      "type": "object"
    },
    "LifecycleType": {
      "enum": [
        "EXERCISE",
        "ASSIGNMENT",
        "EXPIRY",
        "ROLL",
        "CASH_SETTLEMENT",
        "QUANTITY_ADJUSTMENT"
      ],
      "title": "LifecycleType",
      "type": "string"
    },
    "OrderRecord": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "status": {
          "$ref": "#/$defs/OrderStatus"
        }
      },
      "required": [
        "order_id",
        "instrument_id",
        "side",
        "quantity",
        "decision_time",
        "available_at",
        "status"
      ],
      "title": "OrderRecord",
      "type": "object"
    },
    "OrderStatus": {
      "enum": [
        "NEW",
        "PARTIALLY_FILLED",
        "FILLED",
        "CANCELLED",
        "REJECTED"
      ],
      "title": "OrderStatus",
      "type": "string"
    },
    "P8EvaluationHandoff": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "cash_entries": {
          "items": {
            "$ref": "#/$defs/CashLedgerEntry"
          },
          "title": "Cash Entries",
          "type": "array"
        },
        "cycle_id": {
          "title": "Cycle Id",
          "type": "string"
        },
        "end_cash": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "End Cash"
        },
        "fills": {
          "items": {
            "$ref": "#/$defs/FillRecord"
          },
          "title": "Fills",
          "type": "array"
        },
        "final_positions": {
          "items": {
            "$ref": "#/$defs/PositionSnapshot"
          },
          "title": "Final Positions",
          "type": "array"
        },
        "fold_id": {
          "title": "Fold Id",
          "type": "string"
        },
        "handoff_id": {
          "title": "Handoff Id",
          "type": "string"
        },
        "lifecycle_events": {
          "items": {
            "$ref": "#/$defs/LifecycleEvent"
          },
          "title": "Lifecycle Events",
          "type": "array"
        },
        "orders": {
          "items": {
            "$ref": "#/$defs/OrderRecord"
          },
          "title": "Orders",
          "type": "array"
        },
        "p6_candidate_ids": {
          "items": {
            "type": "string"
          },
          "title": "P6 Candidate Ids",
          "type": "array"
        },
        "p7_terminal_records": {
          "items": {
            "$ref": "#/$defs/CandidateTerminalRecord"
          },
          "title": "P7 Terminal Records",
          "type": "array"
        },
        "p8_terminal_records": {
          "items": {
            "$ref": "#/$defs/CandidateTerminalRecord"
          },
          "title": "P8 Terminal Records",
          "type": "array"
        },
        "replay_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Sha256",
          "type": "string"
        },
        "required_lifecycle_supported": {
          "title": "Required Lifecycle Supported",
          "type": "boolean"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "start_cash": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Start Cash"
        },
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        },
        "valuations": {
          "items": {
            "$ref": "#/$defs/ValuationRecord"
          },
          "title": "Valuations",
          "type": "array"
        }
      },
      "required": [
        "handoff_id",
        "schema_version",
        "run_id",
        "cycle_id",
        "trial_id",
        "fold_id",
        "capability",
        "start_cash",
        "end_cash",
        "p6_candidate_ids",
        "p7_terminal_records",
        "p8_terminal_records",
        "orders",
        "fills",
        "cash_entries",
        "lifecycle_events",
        "final_positions",
        "valuations",
        "required_lifecycle_supported",
        "replay_sha256"
      ],
      "title": "P8EvaluationHandoff",
      "type": "object"
    },
    "PositionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "market_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Market Value"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        }
      },
      "required": [
        "instrument_id",
        "quantity",
        "market_value"
      ],
      "title": "PositionSnapshot",
      "type": "object"
    },
    "ResourceBudget": {
      "additionalProperties": false,
      "properties": {
        "hard_timeout_supported": {
          "default": false,
          "title": "Hard Timeout Supported",
          "type": "boolean"
        },
        "maximum_output_artifacts": {
          "default": 128,
          "minimum": 1,
          "title": "Maximum Output Artifacts",
          "type": "integer"
        },
        "maximum_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Maximum Seconds"
        }
      },
      "required": [
        "maximum_seconds"
      ],
      "title": "ResourceBudget",
      "type": "object"
    },
    "Side": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "Side",
      "type": "string"
    },
    "TrialSpec": {
      "additionalProperties": false,
      "properties": {
        "configuration_id": {
          "title": "Configuration Id",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "fixed_p8_handoff": {
          "anyOf": [
            {
              "$ref": "#/$defs/P8EvaluationHandoff"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fold_id": {
          "title": "Fold Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ExecutionMode",
          "default": "FULL_PIPELINE"
        },
        "seed_namespace": {
          "title": "Seed Namespace",
          "type": "string"
        },
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        }
      },
      "required": [
        "trial_id",
        "configuration_id",
        "configuration_sha256",
        "fold_id",
        "seed_namespace"
      ],
      "title": "TrialSpec",
      "type": "object"
    },
    "ValuationRecord": {
      "additionalProperties": false,
      "properties": {
        "cash": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cash"
        },
        "costs": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Costs"
        },
        "gross_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Gross Pnl"
        },
        "market_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Market Value"
        },
        "nav": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Nav"
        },
        "net_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Net Pnl"
        },
        "valuation_time": {
          "format": "date-time",
          "title": "Valuation Time",
          "type": "string"
        }
      },
      "required": [
        "valuation_time",
        "cash",
        "market_value",
        "gross_pnl",
        "costs",
        "net_pnl",
        "nav"
      ],
      "title": "ValuationRecord",
      "type": "object"
    }
  },
  "$id": "https://inferencia.local/p9/s3/TrialExecutionPlan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_pack_version": {
      "title": "Contract Pack Version",
      "type": "string"
    },
    "cycle_id": {
      "title": "Cycle Id",
      "type": "string"
    },
    "initial_artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Initial Artifacts",
      "type": "array"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "resource_budget": {
      "$ref": "#/$defs/ResourceBudget"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/TrialSpec"
      },
      "title": "Trials",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "run_id",
    "cycle_id",
    "contract_pack_version",
    "trials",
    "resource_budget"
  ],
  "title": "TrialExecutionPlan",
  "type": "object"
}
