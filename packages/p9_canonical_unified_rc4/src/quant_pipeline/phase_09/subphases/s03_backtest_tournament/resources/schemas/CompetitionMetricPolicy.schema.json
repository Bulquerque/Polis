{
  "$defs": {
    "ComponentTransform": {
      "enum": [
        "IDENTITY",
        "NEGATE",
        "CLIP"
      ],
      "title": "ComponentTransform",
      "type": "string"
    },
    "MetricComponentPolicy": {
      "additionalProperties": false,
      "properties": {
        "clip_lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Lower"
        },
        "clip_upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Upper"
        },
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/ComponentTransform",
          "default": "IDENTITY"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Weight"
        }
      },
      "required": [
        "component_id",
        "weight"
      ],
      "title": "MetricComponentPolicy",
      "type": "object"
    },
    "MissingComponentPolicy": {
      "enum": [
        "ERROR",
        "OMIT_AND_RENORMALIZE"
      ],
      "title": "MissingComponentPolicy",
      "type": "string"
    }
  },
  "$id": "https://inferencia.local/p9/s3/CompetitionMetricPolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/MetricComponentPolicy"
      },
      "title": "Components",
      "type": "array"
    },
    "metric_id": {
      "title": "Metric Id",
      "type": "string"
    },
    "metric_version": {
      "title": "Metric Version",
      "type": "string"
    },
    "missing_policy": {
      "$ref": "#/$defs/MissingComponentPolicy",
      "default": "ERROR"
    },
    "rounding_decimals": {
      "default": 8,
      "maximum": 18,
      "minimum": 0,
      "title": "Rounding Decimals",
      "type": "integer"
    }
  },
  "required": [
    "metric_id",
    "metric_version",
    "components"
  ],
  "title": "CompetitionMetricPolicy",
  "type": "object"
}
