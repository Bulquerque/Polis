{
  "$defs": {
    "CapabilityState": {
      "enum": [
        "AVAILABLE",
        "LIMITED",
        "RESERVED",
        "UNAVAILABLE"
      ],
      "title": "CapabilityState",
      "type": "string"
    },
    "HyperparameterDefinition": {
      "additionalProperties": false,
      "properties": {
        "active_when": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParameterCondition"
          },
          "title": "Active When",
          "type": "array"
        },
        "aliases": {
          "default": [],
          "items": {
            "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "capability_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Id"
        },
        "choices": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Choices",
          "type": "array"
        },
        "default": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "title": "Default"
        },
        "deprecated": {
          "default": false,
          "title": "Deprecated",
          "type": "boolean"
        },
        "economic_description": {
          "minLength": 1,
          "title": "Economic Description",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ParameterKind"
        },
        "lower": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "owner_module_id": {
          "pattern": "^P[0-9]+\\.S[0-9]+\\.M[0-9]+$",
          "title": "Owner Module Id",
          "type": "string"
        },
        "parameter_id": {
          "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Parameter Id",
          "type": "string"
        },
        "replacement_parameter_id": {
          "anyOf": [
            {
              "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Parameter Id"
        },
        "scale": {
          "$ref": "#/$defs/ParameterScale",
          "default": "LINEAR"
        },
        "schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "upper": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        }
      },
      "required": [
        "parameter_id",
        "schema_version",
        "owner_module_id",
        "kind",
        "default",
        "economic_description"
      ],
      "title": "HyperparameterDefinition",
      "type": "object"
    },
    "HyperparameterSchemaSnapshot": {
      "additionalProperties": false,
      "properties": {
        "definitions": {
          "items": {
            "$ref": "#/$defs/HyperparameterDefinition"
          },
          "title": "Definitions",
          "type": "array"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "experiment_id",
        "snapshot_sha256",
        "definitions"
      ],
      "title": "HyperparameterSchemaSnapshot",
      "type": "object"
    },
    "ParameterAuthorityBinding": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capability Id"
        },
        "capability_state": {
          "$ref": "#/$defs/CapabilityState"
        },
        "owner_module_id": {
          "pattern": "^P[0-9]+\\.S[0-9]+\\.M[0-9]+$",
          "title": "Owner Module Id",
          "type": "string"
        },
        "parameter_id": {
          "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Parameter Id",
          "type": "string"
        }
      },
      "required": [
        "parameter_id",
        "owner_module_id",
        "capability_id",
        "capability_state"
      ],
      "title": "ParameterAuthorityBinding",
      "type": "object"
    },
    "ParameterAuthorityMap": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/ParameterAuthorityBinding"
          },
          "title": "Bindings",
          "type": "array"
        }
      },
      "required": [
        "bindings"
      ],
      "title": "ParameterAuthorityMap",
      "type": "object"
    },
    "ParameterCompatibilityIssue": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "parameter_id": {
          "minLength": 1,
          "title": "Parameter Id",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^P9_[A-Z0-9_]+$",
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "parameter_id",
        "reason_code",
        "description",
        "blocking"
      ],
      "title": "ParameterCompatibilityIssue",
      "type": "object"
    },
    "ParameterCompatibilityReport": {
      "additionalProperties": false,
      "properties": {
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParameterCompatibilityIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "pattern": "^P9_[A-Z0-9_]+$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/RegistryState"
        }
      },
      "required": [
        "state"
      ],
      "title": "ParameterCompatibilityReport",
      "type": "object"
    },
    "ParameterCondition": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "title": "Operator",
          "type": "string"
        },
        "parent_parameter_id": {
          "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Parent Parameter Id",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "parent_parameter_id",
        "operator",
        "values"
      ],
      "title": "ParameterCondition",
      "type": "object"
    },
    "ParameterKind": {
      "enum": [
        "INTEGER",
        "FLOAT",
        "CATEGORICAL",
        "BOOLEAN"
      ],
      "title": "ParameterKind",
      "type": "string"
    },
    "ParameterScale": {
      "enum": [
        "LINEAR",
        "LOG"
      ],
      "title": "ParameterScale",
      "type": "string"
    },
    "RegistryState": {
      "enum": [
        "REGISTRY_SNAPSHOT_READY",
        "REGISTRY_LIMITED",
        "PARAMETER_SCHEMA_INCOMPATIBLE",
        "PARAMETER_DEPRECATED_BLOCKING"
      ],
      "title": "RegistryState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority_map": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParameterAuthorityMap"
        },
        {
          "type": "null"
        }
      ]
    },
    "compatibility_report": {
      "$ref": "#/$defs/ParameterCompatibilityReport"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/HyperparameterSchemaSnapshot"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "snapshot",
    "compatibility_report",
    "authority_map"
  ],
  "title": "HyperparameterRegistryOutcome",
  "type": "object"
}
