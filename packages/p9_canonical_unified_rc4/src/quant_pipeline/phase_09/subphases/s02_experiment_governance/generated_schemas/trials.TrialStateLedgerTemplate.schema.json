{
  "$defs": {
    "TrialState": {
      "enum": [
        "PLANNED",
        "RESERVED",
        "RUNNING",
        "COMPLETED",
        "INVALID",
        "INFEASIBLE",
        "EARLY_STOPPED",
        "RESOURCE_EXHAUSTED",
        "FAILED",
        "QUARANTINED",
        "CANCELLED_UPSTREAM"
      ],
      "title": "TrialState",
      "type": "string"
    },
    "TrialStateTemplateRecord": {
      "additionalProperties": false,
      "properties": {
        "assigned_worker_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned Worker Id"
        },
        "attempt": {
          "default": 0,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "current_state": {
          "$ref": "#/$defs/TrialState"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "pattern": "^P9_[A-Z0-9_]+$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "result_artifact_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Artifact Id"
        },
        "trial_id": {
          "pattern": "^trial-[0-9a-f]{64}$",
          "title": "Trial Id",
          "type": "string"
        }
      },
      "required": [
        "trial_id",
        "current_state"
      ],
      "title": "TrialStateTemplateRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ledger_id": {
      "minLength": 1,
      "title": "Ledger Id",
      "type": "string"
    },
    "ledger_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ledger Sha256",
      "type": "string"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/TrialStateTemplateRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "terminal_states": {
      "items": {
        "$ref": "#/$defs/TrialState"
      },
      "title": "Terminal States",
      "type": "array"
    }
  },
  "required": [
    "ledger_id",
    "plan_id",
    "records",
    "terminal_states",
    "ledger_sha256"
  ],
  "title": "TrialStateLedgerTemplate",
  "type": "object"
}
