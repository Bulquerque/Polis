    "CompiledSearchSpace": {
      "additionalProperties": false,
      "properties": {
        "cardinality": {
          "$ref": "#/$defs/SearchSpaceCardinalityReport"
        },
        "constraint_graph": {
          "$ref": "#/$defs/SearchSpaceConstraintGraph"
        },
