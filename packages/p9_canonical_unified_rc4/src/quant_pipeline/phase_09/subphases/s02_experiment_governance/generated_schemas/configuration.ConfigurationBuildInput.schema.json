        "BUDGET_LIMITED",
        "BUDGET_INFEASIBLE",
        "RESOURCE_CAPABILITY_UNAVAILABLE"
      ],
      "title": "BudgetState",
      "type": "string"
    },
    "CompiledParameterDomain": {
