{
  "$defs": {
    "CapabilityState": {
      "enum": [
        "AVAILABLE",
        "LIMITED",
        "RESERVED",
        "UNAVAILABLE"
      ],
      "title": "CapabilityState",
      "type": "string"
    },
    "HyperparameterDefinition": {
      "additionalProperties": false,
      "properties": {
        "active_when": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParameterCondition"
          },
          "title": "Active When",
          "type": "array"
        },
        "aliases": {
          "default": [],
          "items": {
            "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "capability_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Id"
        },
        "choices": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Choices",
          "type": "array"
        },
        "default": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "title": "Default"
        },
        "deprecated": {
          "default": false,
          "title": "Deprecated",
          "type": "boolean"
        },
        "economic_description": {
          "minLength": 1,
          "title": "Economic Description",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ParameterKind"
        },
        "lower": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "owner_module_id": {
          "pattern": "^P[0-9]+\\.S[0-9]+\\.M[0-9]+$",
          "title": "Owner Module Id",
          "type": "string"
        },
        "parameter_id": {
          "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Parameter Id",
          "type": "string"
        },
        "replacement_parameter_id": {
          "anyOf": [
            {
              "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Parameter Id"
        },
        "scale": {
          "$ref": "#/$defs/ParameterScale",
          "default": "LINEAR"
        },
        "schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "upper": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        }
      },
      "required": [
        "parameter_id",
        "schema_version",
        "owner_module_id",
        "kind",
        "default",
        "economic_description"
      ],
      "title": "HyperparameterDefinition",
      "type": "object"
    },
    "ParameterCondition": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "title": "Operator",
          "type": "string"
        },
        "parent_parameter_id": {
          "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Parent Parameter Id",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "parent_parameter_id",
        "operator",
        "values"
      ],
      "title": "ParameterCondition",
      "type": "object"
    },
    "ParameterKind": {
      "enum": [
        "INTEGER",
        "FLOAT",
        "CATEGORICAL",
        "BOOLEAN"
      ],
      "title": "ParameterKind",
      "type": "string"
    },
    "ParameterScale": {
      "enum": [
        "LINEAR",
        "LOG"
      ],
      "title": "ParameterScale",
      "type": "string"
    },
    "PhaseParameterContractSnapshot": {
      "additionalProperties": false,
      "properties": {
        "capability_state": {
          "$ref": "#/$defs/CapabilityState"
        },
        "contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "contract_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Contract Version",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/HyperparameterDefinition"
          },
          "title": "Parameters",
          "type": "array"
        },
        "phase_id": {
          "minLength": 1,
          "title": "Phase Id",
          "type": "string"
        }
      },
      "required": [
        "phase_id",
        "contract_version",
        "contract_sha256",
        "capability_state",
        "parameters"
      ],
      "title": "PhaseParameterContractSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "snapshots": {
      "items": {
        "$ref": "#/$defs/PhaseParameterContractSnapshot"
      },
      "title": "Snapshots",
      "type": "array"
    }
  },
  "required": [
    "snapshots"
  ],
  "title": "PhaseParameterContractSnapshots",
  "type": "object"
}
