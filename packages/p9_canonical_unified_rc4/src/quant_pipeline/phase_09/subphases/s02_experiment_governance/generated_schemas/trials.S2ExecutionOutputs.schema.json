        "requested_max_configurations": {
          "minimum": 1,
          "title": "Requested Max Configurations",
          "type": "integer"
        },
        "requested_seed_count": {
          "maximum": 128,
          "minimum": 1,
          "title": "Requested Seed Count",
          "type": "integer"
        },
        "required_capability_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Capability Ids",
          "type": "array"
        },
        "search_strategy": {
          "$ref": "#/$defs/SearchStrategy"
        },
        "target_module_ids": {
          "items": {
            "pattern": "^P[0-9]+\\.S[0-9]+\\.M[0-9]+$",
            "type": "string"
