            "$ref": "#/$defs/ActivationCondition"
          },
          "title": "Active When",
          "type": "array"
        },
        "discrete_values": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Discrete Values",
          "type": "array"
        },
        "grid_points": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grid Points"
        },
        "kind": {
          "$ref": "#/$defs/ParameterKind"
        },
        "lower": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "parameter_id": {
          "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Parameter Id",
          "type": "string"
        },
        "scale": {
          "$ref": "#/$defs/ParameterScale"
        },
        "topological_index": {
          "minimum": 0,
          "title": "Topological Index",
          "type": "integer"
        },
        "upper": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        }
      },
      "required": [
        "parameter_id",
        "kind",
        "scale",
        "topological_index"
      ],
      "title": "CompiledParameterDomain",
      "type": "object"
    },
    "CompiledSearchSpace": {
      "additionalProperties": false,
      "properties": {
        "cardinality": {
          "$ref": "#/$defs/SearchSpaceCardinalityReport"
        },
        "constraint_graph": {
          "$ref": "#/$defs/SearchSpaceConstraintGraph"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/CompiledParameterDomain"
          },
          "title": "Parameters",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "pattern": "^P9_[A-Z0-9_]+$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "space_id": {
          "minLength": 1,
          "title": "Space Id",
          "type": "string"
        },
        "space_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Space Sha256",
          "type": "string"
        },
        "specification_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Specification Sha256",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SearchSpaceState"
        }
      },
      "required": [
        "space_id",
        "experiment_id",
        "specification_sha256",
        "state",
        "parameters",
        "constraint_graph",
        "cardinality",
        "space_sha256"
      ],
      "title": "CompiledSearchSpace",
      "type": "object"
    },
    "ComplexityPenaltyPolicy": {
      "additionalProperties": false,
      "properties": {
        "adaptive_search_depth": {
          "minimum": 0,
          "title": "Adaptive Search Depth",
          "type": "integer"
        },
        "effective_dimension_count": {
          "minimum": 0,
          "title": "Effective Dimension Count",
          "type": "integer"
        },
        "nominal_configuration_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nominal Configuration Count"
        },
        "penalty_metadata_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Penalty Metadata Sha256",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "effective_dimension_count",
        "adaptive_search_depth",
        "penalty_metadata_sha256"
      ],
      "title": "ComplexityPenaltyPolicy",
      "type": "object"
    },
    "ConditionOperator": {
      "enum": [
        "EQUALS",
        "NOT_EQUALS",
        "IN",
        "NOT_IN"
      ],
      "title": "ConditionOperator",
      "type": "string"
    },
    "ConfigurationCatalog": {
      "additionalProperties": false,
      "properties": {
        "catalog_id": {
          "minLength": 1,
          "title": "Catalog Id",
          "type": "string"
        },
        "catalog_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Sha256",
          "type": "string"
        },
        "configurations": {
          "items": {
            "$ref": "#/$defs/ConfigurationRecord"
          },
          "title": "Configurations",
          "type": "array"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "pattern": "^P9_[A-Z0-9_]+$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/CatalogState"
        }
