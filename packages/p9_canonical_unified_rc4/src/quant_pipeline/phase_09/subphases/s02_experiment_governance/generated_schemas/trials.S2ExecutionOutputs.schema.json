          "type": "string"
        },
        "parameter_id": {
          "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Parameter Id",
          "type": "string"
        },
        "replacement_parameter_id": {
          "anyOf": [
            {
              "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Parameter Id"
        },
        "scale": {
          "$ref": "#/$defs/ParameterScale",
