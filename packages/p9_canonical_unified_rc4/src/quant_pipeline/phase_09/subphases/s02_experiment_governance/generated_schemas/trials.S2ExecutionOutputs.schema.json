        "choices": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Choices",
          "type": "array"
        },
        "default": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "title": "Default"
        },
        "deprecated": {
          "default": false,
          "title": "Deprecated",
          "type": "boolean"
        },
        "economic_description": {
          "minLength": 1,
          "title": "Economic Description",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ParameterKind"
        },
        "lower": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "owner_module_id": {
          "pattern": "^P[0-9]+\\.S[0-9]+\\.M[0-9]+$",
