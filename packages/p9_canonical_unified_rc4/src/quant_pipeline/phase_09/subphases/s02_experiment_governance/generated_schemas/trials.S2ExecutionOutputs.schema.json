        },
        "experiment_id": {
          "pattern": "^exp-[a-z0-9][a-z0-9._-]{2,127}$",
          "title": "Experiment Id",
          "type": "string"
        },
        "final_holdout_dataset_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Final Holdout Dataset Ids",
          "type": "array"
        },
        "hard_guardrail_metric_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{2,127}$",
            "type": "string"
          },
          "title": "Hard Guardrail Metric Ids",
          "type": "array"
        },
        "hypothesis": {
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "non_goals": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Non Goals",
          "type": "array"
        },
        "primary_metric_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,127}$",
          "title": "Primary Metric Id",
