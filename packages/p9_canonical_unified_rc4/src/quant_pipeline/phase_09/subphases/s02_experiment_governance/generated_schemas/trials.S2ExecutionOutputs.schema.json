{
  "$defs": {
    "ActivationCondition": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "$ref": "#/$defs/ConditionOperator"
        },
        "parent_parameter_id": {
          "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Parent Parameter Id",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "parent_parameter_id",
        "operator",
        "values"
      ],
      "title": "ActivationCondition",
      "type": "object"
    },
    "BudgetAllocation": {
      "additionalProperties": false,
      "properties": {
        "configuration_slots": {
          "minimum": 0,
          "title": "Configuration Slots",
          "type": "integer"
        },
        "cpu_seconds_reserved": {
          "minimum": 0,
          "title": "Cpu Seconds Reserved",
          "type": "integer"
        },
        "stage": {
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "trial_execution_slots": {
          "minimum": 0,
          "title": "Trial Execution Slots",
          "type": "integer"
        }
      },
      "required": [
        "stage",
        "configuration_slots",
        "trial_execution_slots",
        "cpu_seconds_reserved"
      ],
      "title": "BudgetAllocation",
      "type": "object"
    },
    "BudgetState": {
      "enum": [
        "BUDGET_RESERVED",
        "BUDGET_LIMITED",
        "BUDGET_INFEASIBLE",
        "RESOURCE_CAPABILITY_UNAVAILABLE"
      ],
      "title": "BudgetState",
      "type": "string"
    },
    "CatalogState": {
      "enum": [
        "CATALOG_READY",
        "CATALOG_WITH_EQUIVALENCES",
        "IDENTITY_COLLISION",
        "LINEAGE_INVALID"
      ],
      "title": "CatalogState",
      "type": "string"
    },
    "CompiledParameterDomain": {
      "additionalProperties": false,
      "properties": {
        "active_when": {
          "default": [],
