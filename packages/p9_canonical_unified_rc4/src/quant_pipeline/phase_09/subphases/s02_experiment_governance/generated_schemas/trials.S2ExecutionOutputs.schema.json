        "catalog_id",
        "experiment_id",
        "state",
        "configurations",
        "catalog_sha256"
      ],
      "title": "ConfigurationCatalog",
      "type": "object"
    },
    "ConfigurationRecord": {
      "additionalProperties": false,
      "properties": {
        "active_parameter_ids": {
          "items": {
            "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
            "type": "string"
          },
          "title": "Active Parameter Ids",
          "type": "array"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/ParameterAssignment"
          },
          "title": "Assignments",
          "type": "array"
        },
        "boundary_parameter_ids": {
          "default": [],
          "items": {
            "pattern": "^P[5-8]\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
            "type": "string"
          },
          "title": "Boundary Parameter Ids",
          "type": "array"
        },
        "configuration_id": {
          "pattern": "^cfg-[0-9a-f]{64}$",
          "title": "Configuration Id",
          "type": "string"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "identity_preimage_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Preimage Sha256",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_index": {
          "minimum": 0,
          "title": "Source Index",
          "type": "integer"
        }
      },
      "required": [
        "configuration_id",
        "experiment_id",
        "assignments",
        "active_parameter_ids",
        "source",
        "source_index",
        "identity_preimage_sha256"
      ],
      "title": "ConfigurationRecord",
      "type": "object"
    },
    "EarlyStoppingPolicy": {
      "additionalProperties": false,
      "properties": {
        "development_only": {
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "minimum_completed_cells": {
          "default": 1,
          "minimum": 1,
          "title": "Minimum Completed Cells",
          "type": "integer"
        },
        "signal_metric_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{2,127}$",
            "type": "string"
          },
          "title": "Signal Metric Ids",
          "type": "array"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "EarlyStoppingPolicy",
      "type": "object"
    },
    "ExperimentSpecification": {
      "additionalProperties": false,
      "properties": {
        "activated_at": {
          "format": "date-time",
