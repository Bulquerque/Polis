          "type": "string"
        },
        "development_dataset_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Development Dataset Ids",
          "type": "array"
        },
        "diagnostic_metric_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{2,127}$",
            "type": "string"
          },
          "title": "Diagnostic Metric Ids",
          "type": "array"
        },
        "evaluation_dataset_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evaluation Dataset Ids",
