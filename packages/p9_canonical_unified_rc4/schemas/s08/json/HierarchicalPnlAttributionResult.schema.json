{
  "$defs": {
    "AttributionAmount": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "pnl_effect": {
          "title": "Pnl Effect",
          "type": "number"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "quality": {
          "$ref": "#/$defs/AttributionQuality"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "component_id",
        "pnl_effect",
        "evidence_class",
        "quality"
      ],
      "title": "AttributionAmount",
      "type": "object"
    },
    "AttributionQuality": {
      "enum": [
        "QUALIFIED",
        "LIMITED",
        "INSUFFICIENT_EVIDENCE",
        "NOT_IDENTIFIABLE",
        "INVALID"
      ],
      "title": "AttributionQuality",
      "type": "string"
    },
    "AttributionReconciliationReceipt": {
      "additionalProperties": false,
      "properties": {
        "decomposition_version": {
          "minLength": 1,
          "title": "Decomposition Version",
          "type": "string"
        },
        "factual_pnl": {
          "title": "Factual Pnl",
          "type": "number"
        },
        "attributed_pnl": {
          "title": "Attributed Pnl",
          "type": "number"
        },
        "residual_pnl": {
          "title": "Residual Pnl",
          "type": "number"
        },
        "tolerance": {
          "minimum": 0.0,
          "title": "Tolerance",
          "type": "number"
        },
        "reconciled": {
          "title": "Reconciled",
          "type": "boolean"
        },
        "double_count_checks_passed": {
          "title": "Double Count Checks Passed",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "decomposition_version",
        "factual_pnl",
        "attributed_pnl",
        "residual_pnl",
        "tolerance",
        "reconciled",
        "double_count_checks_passed",
        "reason_codes"
      ],
      "title": "AttributionReconciliationReceipt",
      "type": "object"
    },
    "CausalStrength": {
      "enum": [
        "SUPPORTED",
        "PLAUSIBLE",
        "UNRESOLVED"
      ],
      "title": "CausalStrength",
      "type": "string"
    },
    "CounterfactualPolicyResult": {
      "additionalProperties": false,
      "properties": {
        "factual_mean_reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Factual Mean Reward"
        },
        "ips_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ips Value"
        },
        "snips_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snips Value"
        },
        "doubly_robust_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Doubly Robust Value"
        },
        "direct_model_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Direct Model Value"
        },
        "opportunity_cost_vs_factual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Opportunity Cost Vs Factual"
        },
        "overlap": {
          "$ref": "#/$defs/OverlapDiagnostics"
        },
        "quality": {
          "$ref": "#/$defs/AttributionQuality"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        }
      },
      "required": [
        "factual_mean_reward",
        "ips_value",
        "snips_value",
        "doubly_robust_value",
        "direct_model_value",
        "opportunity_cost_vs_factual",
        "overlap",
        "quality",
        "evidence_class",
        "reason_codes",
        "result_sha256"
      ],
      "title": "CounterfactualPolicyResult",
      "type": "object"
    },
    "EvidenceClass": {
      "enum": [
        "FACTUAL_EXECUTED",
        "FACTUAL_OBSERVED_NOT_EXECUTED",
        "OBSERVABLE_COUNTERFACTUAL",
        "MODEL_BASED_COUNTERFACTUAL",
        "CENSORED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "EvidenceStrength": {
      "enum": [
        "FACTUAL",
        "OBSERVABLE",
        "MODEL_BASED",
        "INSUFFICIENT"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    },
    "OptionAttributionResult": {
      "additionalProperties": false,
      "properties": {
        "intervals": {
          "items": {
            "$ref": "#/$defs/OptionIntervalAttribution"
          },
          "title": "Intervals",
          "type": "array"
        },
        "full_repricing_pnl": {
          "title": "Full Repricing Pnl",
          "type": "number"
        },
        "explained_pnl": {
          "title": "Explained Pnl",
          "type": "number"
        },
        "residual_pnl": {
          "title": "Residual Pnl",
          "type": "number"
        },
        "quality": {
          "$ref": "#/$defs/AttributionQuality"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        }
      },
      "required": [
        "intervals",
        "full_repricing_pnl",
        "explained_pnl",
        "residual_pnl",
        "quality",
        "reason_codes",
        "result_sha256"
      ],
      "title": "OptionAttributionResult",
      "type": "object"
    },
    "OptionIntervalAttribution": {
      "additionalProperties": false,
      "properties": {
        "position_id": {
          "minLength": 1,
          "title": "Position Id",
          "type": "string"
        },
        "full_repricing_pnl": {
          "title": "Full Repricing Pnl",
          "type": "number"
        },
        "delta_pnl": {
          "title": "Delta Pnl",
          "type": "number"
        },
        "gamma_pnl": {
          "title": "Gamma Pnl",
          "type": "number"
        },
        "vega_pnl": {
          "title": "Vega Pnl",
          "type": "number"
        },
        "theta_pnl": {
          "title": "Theta Pnl",
          "type": "number"
        },
        "rho_pnl": {
          "title": "Rho Pnl",
          "type": "number"
        },
        "skew_pnl": {
          "title": "Skew Pnl",
          "type": "number"
        },
        "term_structure_pnl": {
          "title": "Term Structure Pnl",
          "type": "number"
        },
        "cross_greek_pnl": {
          "title": "Cross Greek Pnl",
          "type": "number"
        },
        "lifecycle_pnl": {
          "title": "Lifecycle Pnl",
          "type": "number"
        },
        "explained_pnl": {
          "title": "Explained Pnl",
          "type": "number"
        },
        "residual_pnl": {
          "title": "Residual Pnl",
          "type": "number"
        },
        "residual_material": {
          "title": "Residual Material",
          "type": "boolean"
        },
        "quality": {
          "$ref": "#/$defs/AttributionQuality"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "position_id",
        "full_repricing_pnl",
        "delta_pnl",
        "gamma_pnl",
        "vega_pnl",
        "theta_pnl",
        "rho_pnl",
        "skew_pnl",
        "term_structure_pnl",
        "cross_greek_pnl",
        "lifecycle_pnl",
        "explained_pnl",
        "residual_pnl",
        "residual_material",
        "quality"
      ],
      "title": "OptionIntervalAttribution",
      "type": "object"
    },
    "OverlapDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "supported_observation_count": {
          "minimum": 0,
          "title": "Supported Observation Count",
          "type": "integer"
        },
        "minimum_logging_propensity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Logging Propensity"
        },
        "maximum_importance_weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Importance Weight"
        },
        "effective_sample_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Sample Size"
        },
        "support_qualified": {
          "title": "Support Qualified",
          "type": "boolean"
        }
      },
      "required": [
        "observation_count",
        "supported_observation_count",
        "support_qualified"
      ],
      "title": "OverlapDiagnostics",
      "type": "object"
    },
    "RootCauseEdge": {
      "additionalProperties": false,
      "properties": {
        "parent_cause_id": {
          "minLength": 1,
          "title": "Parent Cause Id",
          "type": "string"
        },
        "child_cause_id": {
          "minLength": 1,
          "title": "Child Cause Id",
          "type": "string"
        },
        "relation": {
          "enum": [
            "CONTRIBUTES_TO",
            "CONTRADICTS",
            "CONDITIONS",
            "EXPLAINS"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "parent_cause_id",
        "child_cause_id",
        "relation"
      ],
      "title": "RootCauseEdge",
      "type": "object"
    },
    "RootCauseNode": {
      "additionalProperties": false,
      "properties": {
        "cause_id": {
          "minLength": 1,
          "title": "Cause Id",
          "type": "string"
        },
        "source_module_id": {
          "pattern": "^P9\\.S8\\.M0[1-8]$",
          "title": "Source Module Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "pnl_effect": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pnl Effect"
        },
        "causal_strength": {
          "$ref": "#/$defs/CausalStrength"
        },
        "evidence_strength": {
          "$ref": "#/$defs/EvidenceStrength"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "contradictions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Contradictions",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "cause_id",
        "source_module_id",
        "label",
        "causal_strength",
        "evidence_strength",
        "evidence_refs"
      ],
      "title": "RootCauseNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "stage_amounts": {
      "items": {
        "$ref": "#/$defs/AttributionAmount"
      },
      "title": "Stage Amounts",
      "type": "array"
    },
    "option_nested_explanation": {
      "$ref": "#/$defs/OptionAttributionResult"
    },
    "counterfactual_diagnostic": {
      "$ref": "#/$defs/CounterfactualPolicyResult"
    },
    "reconciliation": {
      "$ref": "#/$defs/AttributionReconciliationReceipt"
    },
    "root_cause_nodes": {
      "items": {
        "$ref": "#/$defs/RootCauseNode"
      },
      "title": "Root Cause Nodes",
      "type": "array"
    },
    "root_cause_edges": {
      "items": {
        "$ref": "#/$defs/RootCauseEdge"
      },
      "title": "Root Cause Edges",
      "type": "array"
    },
    "quality": {
      "$ref": "#/$defs/AttributionQuality"
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    }
  },
  "required": [
    "stage_amounts",
    "option_nested_explanation",
    "counterfactual_diagnostic",
    "reconciliation",
    "root_cause_nodes",
    "root_cause_edges",
    "quality",
    "reason_codes",
    "result_sha256"
  ],
  "title": "HierarchicalPnlAttributionResult",
  "type": "object",
  "$id": "urn:inferencia:p9:s8:HierarchicalPnlAttributionResult:1.0.0"
}
