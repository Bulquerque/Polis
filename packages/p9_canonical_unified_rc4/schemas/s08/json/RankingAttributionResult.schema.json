{
  "$defs": {
    "AttributionQuality": {
      "enum": [
        "QUALIFIED",
        "LIMITED",
        "INSUFFICIENT_EVIDENCE",
        "NOT_IDENTIFIABLE",
        "INVALID"
      ],
      "title": "AttributionQuality",
      "type": "string"
    },
    "RankingGroupReport": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "eligible_count": {
          "minimum": 0,
          "title": "Eligible Count",
          "type": "integer"
        },
        "observable_count": {
          "minimum": 0,
          "title": "Observable Count",
          "type": "integer"
        },
        "pairwise_accuracy": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pairwise Accuracy"
        },
        "spearman_correlation": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spearman Correlation"
        },
        "ndcg_at_k": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ndcg At K"
        },
        "ranking_regret": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranking Regret"
        },
        "dominance_violations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Dominance Violations",
          "type": "array"
        },
        "abstention_state": {
          "minLength": 1,
          "title": "Abstention State",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/AttributionQuality"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "group_id",
        "eligible_count",
        "observable_count",
        "dominance_violations",
        "abstention_state",
        "quality"
      ],
      "title": "RankingGroupReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "groups": {
      "items": {
        "$ref": "#/$defs/RankingGroupReport"
      },
      "title": "Groups",
      "type": "array"
    },
    "mean_pairwise_accuracy": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mean Pairwise Accuracy"
    },
    "mean_ndcg_at_k": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mean Ndcg At K"
    },
    "total_ranking_regret": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Ranking Regret"
    },
    "aggregate_pnl_effect": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Aggregate Pnl Effect"
    },
    "quality": {
      "$ref": "#/$defs/AttributionQuality"
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    }
  },
  "required": [
    "groups",
    "aggregate_pnl_effect",
    "quality",
    "reason_codes",
    "result_sha256"
  ],
  "title": "RankingAttributionResult",
  "type": "object",
  "$id": "urn:inferencia:p9:s8:RankingAttributionResult:1.0.0"
}
