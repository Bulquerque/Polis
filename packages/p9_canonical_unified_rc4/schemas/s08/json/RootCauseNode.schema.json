{
  "$defs": {
    "CausalStrength": {
      "enum": [
        "SUPPORTED",
        "PLAUSIBLE",
        "UNRESOLVED"
      ],
      "title": "CausalStrength",
      "type": "string"
    },
    "EvidenceStrength": {
      "enum": [
        "FACTUAL",
        "OBSERVABLE",
        "MODEL_BASED",
        "INSUFFICIENT"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cause_id": {
      "minLength": 1,
      "title": "Cause Id",
      "type": "string"
    },
    "source_module_id": {
      "pattern": "^P9\\.S8\\.M0[1-8]$",
      "title": "Source Module Id",
      "type": "string"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "pnl_effect": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pnl Effect"
    },
    "causal_strength": {
      "$ref": "#/$defs/CausalStrength"
    },
    "evidence_strength": {
      "$ref": "#/$defs/EvidenceStrength"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "contradictions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "cause_id",
    "source_module_id",
    "label",
    "causal_strength",
    "evidence_strength",
    "evidence_refs"
  ],
  "title": "RootCauseNode",
  "type": "object",
  "$id": "urn:inferencia:p9:s8:RootCauseNode:1.0.0"
}
