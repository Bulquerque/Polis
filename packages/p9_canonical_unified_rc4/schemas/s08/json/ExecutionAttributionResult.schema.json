{
  "$defs": {
    "AttributionQuality": {
      "enum": [
        "QUALIFIED",
        "LIMITED",
        "INSUFFICIENT_EVIDENCE",
        "NOT_IDENTIFIABLE",
        "INVALID"
      ],
      "title": "AttributionQuality",
      "type": "string"
    },
    "EvidenceClass": {
      "enum": [
        "FACTUAL_EXECUTED",
        "FACTUAL_OBSERVED_NOT_EXECUTED",
        "OBSERVABLE_COUNTERFACTUAL",
        "MODEL_BASED_COUNTERFACTUAL",
        "CENSORED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "LifecycleAttribution": {
      "additionalProperties": false,
      "properties": {
        "position_id": {
          "minLength": 1,
          "title": "Position Id",
          "type": "string"
        },
        "planned_event": {
          "minLength": 1,
          "title": "Planned Event",
          "type": "string"
        },
        "actual_event": {
          "minLength": 1,
          "title": "Actual Event",
          "type": "string"
        },
        "lifecycle_pnl_effect": {
          "title": "Lifecycle Pnl Effect",
          "type": "number"
        },
        "matched_plan": {
          "title": "Matched Plan",
          "type": "boolean"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        }
      },
      "required": [
        "position_id",
        "planned_event",
        "actual_event",
        "lifecycle_pnl_effect",
        "matched_plan",
        "evidence_class"
      ],
      "title": "LifecycleAttribution",
      "type": "object"
    },
    "OrderShortfall": {
      "additionalProperties": false,
      "properties": {
        "order_id": {
          "minLength": 1,
          "title": "Order Id",
          "type": "string"
        },
        "delay_cost": {
          "title": "Delay Cost",
          "type": "number"
        },
        "trading_cost": {
          "title": "Trading Cost",
          "type": "number"
        },
        "opportunity_cost": {
          "title": "Opportunity Cost",
          "type": "number"
        },
        "explicit_cost": {
          "title": "Explicit Cost",
          "type": "number"
        },
        "legging_cost": {
          "title": "Legging Cost",
          "type": "number"
        },
        "total_shortfall": {
          "title": "Total Shortfall",
          "type": "number"
        },
        "fill_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fill Rate",
          "type": "number"
        },
        "slippage_model_error": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Slippage Model Error"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        }
      },
      "required": [
        "order_id",
        "delay_cost",
        "trading_cost",
        "opportunity_cost",
        "explicit_cost",
        "legging_cost",
        "total_shortfall",
        "fill_rate",
        "slippage_model_error",
        "evidence_class"
      ],
      "title": "OrderShortfall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "orders": {
      "items": {
        "$ref": "#/$defs/OrderShortfall"
      },
      "title": "Orders",
      "type": "array"
    },
    "lifecycle": {
      "items": {
        "$ref": "#/$defs/LifecycleAttribution"
      },
      "title": "Lifecycle",
      "type": "array"
    },
    "total_delay_cost": {
      "title": "Total Delay Cost",
      "type": "number"
    },
    "total_trading_cost": {
      "title": "Total Trading Cost",
      "type": "number"
    },
    "total_opportunity_cost": {
      "title": "Total Opportunity Cost",
      "type": "number"
    },
    "total_explicit_cost": {
      "title": "Total Explicit Cost",
      "type": "number"
    },
    "total_legging_cost": {
      "title": "Total Legging Cost",
      "type": "number"
    },
    "total_shortfall": {
      "title": "Total Shortfall",
      "type": "number"
    },
    "lifecycle_pnl_effect": {
      "title": "Lifecycle Pnl Effect",
      "type": "number"
    },
    "aggregate_pnl_effect": {
      "title": "Aggregate Pnl Effect",
      "type": "number"
    },
    "quality": {
      "$ref": "#/$defs/AttributionQuality"
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    }
  },
  "required": [
    "orders",
    "lifecycle",
    "total_delay_cost",
    "total_trading_cost",
    "total_opportunity_cost",
    "total_explicit_cost",
    "total_legging_cost",
    "total_shortfall",
    "lifecycle_pnl_effect",
    "aggregate_pnl_effect",
    "quality",
    "reason_codes",
    "result_sha256"
  ],
  "title": "ExecutionAttributionResult",
  "type": "object",
  "$id": "urn:inferencia:p9:s8:ExecutionAttributionResult:1.0.0"
}
