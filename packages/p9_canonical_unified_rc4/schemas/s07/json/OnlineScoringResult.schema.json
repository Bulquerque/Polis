{
  "$defs": {
    "CalibrationBin": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "lower_edge": {
          "title": "Lower Edge",
          "type": "number"
        },
        "upper_edge": {
          "title": "Upper Edge",
          "type": "number"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "mean_prediction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Prediction"
        },
        "observed_frequency": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Frequency"
        },
        "qualified": {
          "title": "Qualified",
          "type": "boolean"
        }
      },
      "required": [
        "policy_id",
        "lower_edge",
        "upper_edge",
        "observation_count",
        "qualified"
      ],
      "title": "CalibrationBin",
      "type": "object"
    },
    "OnlineScoreRecord": {
      "additionalProperties": false,
      "properties": {
        "prediction_event_id": {
          "minLength": 1,
          "title": "Prediction Event Id",
          "type": "string"
        },
        "cohort_id": {
          "minLength": 1,
          "title": "Cohort Id",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "horizon_id": {
          "minLength": 1,
          "title": "Horizon Id",
          "type": "string"
        },
        "score_name": {
          "minLength": 1,
          "title": "Score Name",
          "type": "string"
        },
        "score_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score Value"
        },
        "quality_state": {
          "minLength": 1,
          "title": "Quality State",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "prediction_event_id",
        "cohort_id",
        "policy_id",
        "target_id",
        "horizon_id",
        "score_name",
        "score_value",
        "quality_state"
      ],
      "title": "OnlineScoreRecord",
      "type": "object"
    },
    "ReliabilitySummary": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "horizon_id": {
          "minLength": 1,
          "title": "Horizon Id",
          "type": "string"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "mean_score_by_name": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Mean Score By Name",
          "type": "array"
        },
        "empirical_coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Empirical Coverage"
        },
        "mean_interval_width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Interval Width"
        },
        "abstention_rate": {
          "title": "Abstention Rate",
          "type": "number"
        },
        "calibration_qualified": {
          "title": "Calibration Qualified",
          "type": "boolean"
        }
      },
      "required": [
        "policy_id",
        "target_id",
        "horizon_id",
        "observation_count",
        "mean_score_by_name",
        "abstention_rate",
        "calibration_qualified"
      ],
      "title": "ReliabilitySummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "score_records": {
      "items": {
        "$ref": "#/$defs/OnlineScoreRecord"
      },
      "title": "Score Records",
      "type": "array"
    },
    "calibration_bins": {
      "items": {
        "$ref": "#/$defs/CalibrationBin"
      },
      "title": "Calibration Bins",
      "type": "array"
    },
    "summaries": {
      "items": {
        "$ref": "#/$defs/ReliabilitySummary"
      },
      "title": "Summaries",
      "type": "array"
    },
    "score_panel_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Score Panel Sha256",
      "type": "string"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "score_records",
    "calibration_bins",
    "summaries",
    "score_panel_sha256"
  ],
  "title": "OnlineScoringResult",
  "type": "object",
  "$id": "urn:inferencia:p9:s7:OnlineScoringResult:1.0.0"
}
