{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Role",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "cycle": {
          "$ref": "#/$defs/CycleRef"
        },
        "location": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "producer_module_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Producer Module Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Name",
          "type": "string"
        },
        "schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Sha256",
          "type": "string"
        },
        "schema_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_role",
        "schema_name",
        "schema_version",
        "schema_sha256",
        "payload_sha256",
        "producer_module_id",
        "run_id",
        "cycle",
        "available_at",
        "location"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "CategoricalChangeBounds": {
      "additionalProperties": false,
      "properties": {
        "allowed_values": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Values",
          "type": "array"
        },
        "parameter_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parameter Name",
          "type": "string"
        }
      },
      "required": [
        "parameter_name",
        "allowed_values"
      ],
      "title": "CategoricalChangeBounds",
      "type": "object"
    },
    "CycleRef": {
      "additionalProperties": false,
      "properties": {
        "cycle_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "cycle_id",
        "ordinal"
      ],
      "title": "CycleRef",
      "type": "object"
    },
    "EvidenceQuality": {
      "enum": [
        "FACTUAL_EXECUTED",
        "FACTUAL_OBSERVED",
        "OBSERVABLE_COUNTERFACTUAL",
        "MODEL_BASED_COUNTERFACTUAL",
        "CENSORED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceQuality",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "evidence_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/EvidenceQuality"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "artifact_ref",
        "quality",
        "summary"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "FeedbackEffectType": {
      "enum": [
        "RESEARCH_REQUEST",
        "POLICY_BOUND_CHANGE",
        "ELIGIBILITY_REVIEW",
        "CALIBRATION_REVIEW",
        "CAPABILITY_REQUIREMENT",
        "DEPRECATION_CANDIDATE"
      ],
      "title": "FeedbackEffectType",
      "type": "string"
    },
    "NumericChangeBounds": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "maximum_absolute_delta": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Absolute Delta"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "parameter_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parameter Name",
          "type": "string"
        }
      },
      "required": [
        "parameter_name"
      ],
      "title": "NumericChangeBounds",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "atomic_group_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Atomic Group Id"
    },
    "categorical_change_bounds": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CategoricalChangeBounds"
      },
      "title": "Categorical Change Bounds",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "economic_materiality": {
      "minimum": 0.0,
      "title": "Economic Materiality",
      "type": "number"
    },
    "effect_type": {
      "$ref": "#/$defs/FeedbackEffectType"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "expires_after_cycle": {
      "$ref": "#/$defs/CycleRef"
    },
    "feedback_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Feedback Id",
      "type": "string"
    },
    "feedback_type": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Feedback Type",
      "type": "string"
    },
    "numeric_change_bounds": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NumericChangeBounds"
      },
      "title": "Numeric Change Bounds",
      "type": "array"
    },
    "promotion_dependency": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Promotion Dependency"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "pattern": "^P9_[A-Z0-9_]+$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "source_cycle": {
      "$ref": "#/$defs/CycleRef"
    },
    "supersedes_feedback_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Feedback Id"
    },
    "target_cycle": {
      "$ref": "#/$defs/CycleRef"
    },
    "target_phase": {
      "const": "P8",
      "default": "P8",
      "title": "Target Phase",
      "type": "string"
    },
    "target_policy_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Target Policy Id",
      "type": "string"
    },
    "target_policy_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Policy Version",
      "type": "string"
    }
  },
  "required": [
    "feedback_id",
    "source_cycle",
    "target_cycle",
    "target_policy_id",
    "target_policy_version",
    "feedback_type",
    "effect_type",
    "evidence_refs",
    "confidence",
    "economic_materiality",
    "expires_after_cycle"
  ],
  "title": "P9P8PortfolioExecutionFeedback",
  "type": "object"
}
