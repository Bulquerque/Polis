{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Role",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "cycle": {
          "$ref": "#/$defs/CycleRef"
        },
        "location": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "producer_module_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Producer Module Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Name",
          "type": "string"
        },
        "schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Sha256",
          "type": "string"
        },
        "schema_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_role",
        "schema_name",
        "schema_version",
        "schema_sha256",
        "payload_sha256",
        "producer_module_id",
        "run_id",
        "cycle",
        "available_at",
        "location"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "CycleRef": {
      "additionalProperties": false,
      "properties": {
        "cycle_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "cycle_id",
        "ordinal"
      ],
      "title": "CycleRef",
      "type": "object"
    },
    "DeploymentStage": {
      "enum": [
        "SHADOW_ONLY",
        "PAPER_EXECUTION",
        "LIMITED_CAPITAL",
        "FULL_PRODUCTION",
        "RETAIN_CURRENT",
        "ROLLBACK",
        "QUARANTINE"
      ],
      "title": "DeploymentStage",
      "type": "string"
    },
    "EvidenceQuality": {
      "enum": [
        "FACTUAL_EXECUTED",
        "FACTUAL_OBSERVED",
        "OBSERVABLE_COUNTERFACTUAL",
        "MODEL_BASED_COUNTERFACTUAL",
        "CENSORED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceQuality",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "evidence_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/EvidenceQuality"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "artifact_ref",
        "quality",
        "summary"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "GateSeverity": {
      "enum": [
        "INFO",
        "WARNING",
        "BLOCKING",
        "CRITICAL"
      ],
      "title": "GateSeverity",
      "type": "string"
    },
    "GateState": {
      "enum": [
        "PASS",
        "PASS_WITH_LIMITATIONS",
        "FAIL",
        "NOT_AVAILABLE",
        "NOT_APPLICABLE",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "GateState",
      "type": "string"
    },
    "P0AuthorizationState": {
      "enum": [
        "PENDING_P0"
      ],
      "title": "P0AuthorizationState",
      "type": "string"
    },
    "P0PromotionAuthorizationRequest": {
      "additionalProperties": false,
      "properties": {
        "authorization_state": {
          "$ref": "#/$defs/P0AuthorizationState",
          "default": "PENDING_P0"
        },
        "evidence_bundle_sha256": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Bundle Sha256",
          "type": "string"
        },
        "recommendation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Recommendation Id",
          "type": "string"
        },
        "recommendation_state": {
          "$ref": "#/$defs/RecommendationState"
        },
        "request_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "requested_deployment_stage": {
          "$ref": "#/$defs/DeploymentStage"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "recommendation_id",
        "recommendation_state",
        "requested_deployment_stage",
        "submitted_at",
        "evidence_bundle_sha256"
      ],
      "title": "P0PromotionAuthorizationRequest",
      "type": "object"
    },
    "PromotionEvidenceBundle": {
      "additionalProperties": false,
      "properties": {
        "contrary_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Contrary Evidence Refs",
          "type": "array"
        },
        "favorable_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Favorable Evidence Refs",
          "type": "array"
        },
        "gate_receipts": {
          "items": {
            "$ref": "#/$defs/PromotionGateReceipt"
          },
          "title": "Gate Receipts",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "recommendation_candidate_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recommendation Candidate Id"
        },
        "rollback_requirements": {
          "default": [],
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rollback Requirements",
          "type": "array"
        }
      },
      "required": [
        "recommendation_candidate_id",
        "gate_receipts"
      ],
      "title": "PromotionEvidenceBundle",
      "type": "object"
    },
    "PromotionGateReceipt": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "gate_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Gate Id",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "pattern": "^P9_[A-Z0-9_]+$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/GateSeverity"
        },
        "state": {
          "$ref": "#/$defs/GateState"
        }
      },
      "required": [
        "gate_id",
        "state",
        "severity"
      ],
      "title": "PromotionGateReceipt",
      "type": "object"
    },
    "PromotionRecommendation": {
      "additionalProperties": false,
      "properties": {
        "authorization_required": {
          "default": true,
          "title": "Authorization Required",
          "type": "boolean"
        },
        "challenger_configuration_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Challenger Configuration Id"
        },
        "champion_configuration_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Champion Configuration Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_bundle": {
          "$ref": "#/$defs/PromotionEvidenceBundle"
        },
        "reason_codes": {
          "items": {
            "pattern": "^P9_[A-Z0-9_]+$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "recommendation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Recommendation Id",
          "type": "string"
        },
        "recommendation_state": {
          "$ref": "#/$defs/RecommendationState"
        },
        "requested_deployment_stage": {
          "$ref": "#/$defs/DeploymentStage"
        }
      },
      "required": [
        "recommendation_id",
        "recommendation_state",
        "champion_configuration_id",
        "challenger_configuration_id",
        "requested_deployment_stage",
        "evidence_bundle",
        "reason_codes",
        "created_at"
      ],
      "title": "PromotionRecommendation",
      "type": "object"
    },
    "RecommendationState": {
      "enum": [
        "PROMOTE_RECOMMENDED",
        "LIMITED_CAPITAL_RECOMMENDED",
        "SHADOW_EXTENSION_RECOMMENDED",
        "RETAIN_CHAMPION",
        "CHALLENGER_ONLY",
        "REQUALIFICATION_REQUIRED",
        "ROLLBACK_RECOMMENDED",
        "QUARANTINE_RECOMMENDED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "RecommendationState",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_bundle": {
      "$ref": "#/$defs/PromotionEvidenceBundle"
    },
    "p0_authorization_request": {
      "$ref": "#/$defs/P0PromotionAuthorizationRequest"
    },
    "recommendation": {
      "$ref": "#/$defs/PromotionRecommendation"
    }
  },
  "required": [
    "evidence_bundle",
    "recommendation",
    "p0_authorization_request"
  ],
  "title": "PromotionModuleOutput",
  "type": "object"
}
