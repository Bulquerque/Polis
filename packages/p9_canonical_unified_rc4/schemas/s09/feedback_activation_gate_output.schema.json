        "target_phase": {
          "const": "P5",
          "default": "P5",
          "title": "Target Phase",
          "type": "string"
        },
        "target_policy_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Target Policy Id",
          "type": "string"
        },
        "target_policy_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Policy Version",
          "type": "string"
        }
