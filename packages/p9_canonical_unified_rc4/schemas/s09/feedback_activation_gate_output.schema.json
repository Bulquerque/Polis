        "feedback_id",
        "source_cycle",
        "target_cycle",
        "target_policy_id",
        "target_policy_version",
        "feedback_type",
        "effect_type",
        "evidence_refs",
        "confidence",
        "economic_materiality",
        "expires_after_cycle"
