        "expires_after_cycle": {
          "$ref": "#/$defs/CycleRef"
        },
        "feedback_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Feedback Id",
          "type": "string"
        },
        "feedback_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Feedback Type",
          "type": "string"
