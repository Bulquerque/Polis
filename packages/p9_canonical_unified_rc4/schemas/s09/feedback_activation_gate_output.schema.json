          },
          "title": "Reason Codes",
          "type": "array"
        },
        "source_cycle": {
          "$ref": "#/$defs/CycleRef"
        },
        "supersedes_feedback_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Feedback Id"
        },
        "target_cycle": {
          "$ref": "#/$defs/CycleRef"
