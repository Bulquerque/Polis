{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Role",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "cycle": {
          "$ref": "#/$defs/CycleRef"
        },
        "location": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "producer_module_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Producer Module Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Name",
          "type": "string"
        },
        "schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Sha256",
          "type": "string"
        },
        "schema_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_role",
        "schema_name",
        "schema_version",
        "schema_sha256",
        "payload_sha256",
        "producer_module_id",
        "run_id",
        "cycle",
        "available_at",
        "location"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "BuildEnvironment": {
      "additionalProperties": false,
      "properties": {
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "platform": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "pydantic_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Pydantic Version",
          "type": "string"
        },
        "python_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "s10_distribution_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "S10 Distribution Version",
          "type": "string"
        },
        "s9_distribution_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "S9 Distribution Version",
          "type": "string"
        }
      },
      "required": [
        "python_version",
        "platform",
        "pydantic_version",
        "s9_distribution_version",
        "s10_distribution_version",
        "dependency_lock_sha256"
      ],
      "title": "BuildEnvironment",
      "type": "object"
    },
    "ConsumerReceiptReference": {
      "additionalProperties": false,
      "properties": {
        "accepted_count": {
          "minimum": 0,
          "title": "Accepted Count",
          "type": "integer"
        },
        "consumer_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Consumer Id",
          "type": "string"
        },
        "receipt_ref": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "rejected_count": {
          "minimum": 0,
          "title": "Rejected Count",
          "type": "integer"
        },
        "reserved_count": {
          "minimum": 0,
          "title": "Reserved Count",
          "type": "integer"
        },
        "source_contract_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Contract Name",
          "type": "string"
        },
        "source_contract_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Contract Version",
          "type": "string"
        }
      },
      "required": [
        "consumer_id",
        "source_contract_name",
        "source_contract_version",
        "receipt_ref",
        "accepted_count",
        "rejected_count",
        "reserved_count"
      ],
      "title": "ConsumerReceiptReference",
      "type": "object"
    },
    "CycleRef": {
      "additionalProperties": false,
      "properties": {
        "cycle_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "cycle_id",
        "ordinal"
      ],
      "title": "CycleRef",
      "type": "object"
    },
    "FeedbackDistributionManifest": {
      "additionalProperties": false,
      "properties": {
        "accepted_feedback_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Accepted Feedback Ids",
          "type": "array"
        },
        "activated_feedback_ids": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Activated Feedback Ids",
          "type": "array"
        },
        "rejected_feedback_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rejected Feedback Ids",
          "type": "array"
        },
        "reserved_feedback_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reserved Feedback Ids",
          "type": "array"
        }
      },
      "required": [
        "accepted_feedback_ids",
        "rejected_feedback_ids",
        "reserved_feedback_ids"
      ],
      "title": "FeedbackDistributionManifest",
      "type": "object"
    },
    "ModuleStatus": {
      "enum": [
        "SUCCESS",
        "LIMITED",
        "INSUFFICIENT_EVIDENCE",
        "INVALID",
        "FAILED"
      ],
      "title": "ModuleStatus",
      "type": "string"
    },
    "P0AuthorizationRequestManifest": {
      "additionalProperties": false,
      "properties": {
        "authorization_state": {
          "$ref": "#/$defs/P0AuthorizationState"
        },
        "recommendation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Recommendation Id",
          "type": "string"
        },
        "release_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Release Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "request_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Payload Sha256",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "request_id",
        "recommendation_id",
        "authorization_state",
        "request_payload_sha256"
      ],
      "title": "P0AuthorizationRequestManifest",
      "type": "object"
    },
    "P0AuthorizationState": {
      "enum": [
        "PENDING_P0"
      ],
      "title": "P0AuthorizationState",
      "type": "string"
    },
    "P9ReleaseManifest": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ReleaseArtifactEntry"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "material_limitations": {
          "default": [],
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Material Limitations",
          "type": "array"
        },
        "release_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Release Id",
          "type": "string"
        },
        "release_state": {
          "$ref": "#/$defs/ReleaseState"
        },
        "source_cycle": {
          "$ref": "#/$defs/CycleRef"
        },
        "subphase_receipts": {
          "items": {
            "$ref": "#/$defs/SubphaseReceiptReference"
          },
          "title": "Subphase Receipts",
          "type": "array"
        }
      },
      "required": [
        "release_id",
        "source_cycle",
        "release_state",
        "subphase_receipts",
        "artifacts",
        "created_at",
        "manifest_sha256"
      ],
      "title": "P9ReleaseManifest",
      "type": "object"
    },
    "Phase09DeliveryManifest": {
      "additionalProperties": false,
      "properties": {
        "build_environment": {
          "$ref": "#/$defs/BuildEnvironment"
        },
        "consumer_receipts": {
          "items": {
            "$ref": "#/$defs/ConsumerReceiptReference"
          },
          "title": "Consumer Receipts",
          "type": "array"
        },
        "module_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Module Ids",
          "type": "array"
        },
        "producer_id": {
          "default": "PHASE09_RELEASE",
          "maxLength": 256,
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "s10_wheel_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "S10 Wheel Sha256",
          "type": "string"
        },
        "s9_wheel_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "S9 Wheel Sha256",
          "type": "string"
        },
        "source_tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Tree Sha256",
          "type": "string"
        },
        "test_summary": {
          "$ref": "#/$defs/TestSummary"
        }
      },
      "required": [
        "module_ids",
        "source_tree_sha256",
        "s9_wheel_sha256",
        "s10_wheel_sha256",
        "consumer_receipts",
        "build_environment",
        "test_summary"
      ],
      "title": "Phase09DeliveryManifest",
      "type": "object"
    },
    "ReleaseArtifactEntry": {
      "additionalProperties": false,
      "properties": {
        "artifact_role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Role",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "producer_module_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Producer Module Id",
          "type": "string"
        },
        "record_count": {
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "schema_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_role",
        "schema_name",
        "schema_version",
        "payload_sha256",
        "producer_module_id",
        "record_count"
      ],
      "title": "ReleaseArtifactEntry",
      "type": "object"
    },
    "ReleaseState": {
      "enum": [
        "RELEASE_READY_FOR_P0",
        "RELEASE_READY_NO_PROMOTION",
        "RELEASE_BLOCKED_INCOMPLETE_RECEIPTS",
        "RELEASE_BLOCKED_HASH_MISMATCH",
        "RELEASE_BLOCKED_CONTRACT_DRIFT",
        "RELEASE_BLOCKED_NONDETERMINISTIC"
      ],
      "title": "ReleaseState",
      "type": "string"
    },
    "SubphaseReceiptReference": {
      "additionalProperties": false,
      "properties": {
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "receipt_ref": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "status": {
          "$ref": "#/$defs/ModuleStatus"
        },
        "subphase_id": {
          "pattern": "^P9\\.S(?:[1-9]|10)$",
          "title": "Subphase Id",
          "type": "string"
        }
      },
      "required": [
        "subphase_id",
        "status",
        "receipt_ref",
        "output_sha256"
      ],
      "title": "SubphaseReceiptReference",
      "type": "object"
    },
    "TestSummary": {
      "additionalProperties": false,
      "properties": {
        "branch_coverage_percent": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Branch Coverage Percent",
          "type": "number"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "line_coverage_percent": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Line Coverage Percent",
          "type": "number"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "line_coverage_percent",
        "branch_coverage_percent",
        "report_sha256"
      ],
      "title": "TestSummary",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "feedback_distribution_manifest": {
      "$ref": "#/$defs/FeedbackDistributionManifest"
    },
    "limitations": {
      "default": [],
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "p0_authorization_manifest": {
      "$ref": "#/$defs/P0AuthorizationRequestManifest"
    },
    "p3_handoff_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "P3 Handoff Manifest Sha256",
      "type": "string"
    },
    "phase09_delivery_manifest": {
      "$ref": "#/$defs/Phase09DeliveryManifest"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "pattern": "^P9_[A-Z0-9_]+$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "release_manifest_without_s10": {
      "$ref": "#/$defs/P9ReleaseManifest"
    },
    "release_state": {
      "$ref": "#/$defs/ReleaseState"
    }
  },
  "required": [
    "release_state",
    "release_manifest_without_s10",
    "p0_authorization_manifest",
    "p3_handoff_manifest_sha256",
    "feedback_distribution_manifest",
    "phase09_delivery_manifest"
  ],
  "title": "ReleaseCandidateOutput",
  "type": "object"
}
