{
  "$defs": {
    "AmbiguityFamily": {
      "enum": [
        "DISCRETE_SUPPORT_WASSERSTEIN_1"
      ],
      "title": "AmbiguityFamily",
      "type": "string"
    },
    "AmbiguitySetPolicy": {
      "additionalProperties": false,
      "properties": {
        "cvar_confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.5,
          "title": "Cvar Confidence Level",
          "type": "number"
        },
        "family": {
          "$ref": "#/$defs/AmbiguityFamily",
          "default": "DISCRETE_SUPPORT_WASSERSTEIN_1"
        },
        "maximum_scenarios": {
          "default": 80,
          "minimum": 1,
          "title": "Maximum Scenarios",
          "type": "integer"
        },
        "radius_calibration_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius Calibration Id"
        },
        "radius_grid": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Radius Grid",
          "type": "array"
        },
        "solver_method": {
          "default": "highs",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Solver Method",
          "type": "string"
        }
      },
      "required": [
        "radius_grid"
      ],
      "title": "AmbiguitySetPolicy",
      "type": "object"
    },
    "BreachDirection": {
      "enum": [
        "LESS_THAN_OR_EQUAL",
        "GREATER_THAN_OR_EQUAL"
      ],
      "title": "BreachDirection",
      "type": "string"
    },
    "CapacityRequest": {
      "additionalProperties": false,
      "properties": {
        "annual_gross_return": {
          "title": "Annual Gross Return",
          "type": "number"
        },
        "annual_turnover_ratio": {
          "minimum": 0.0,
          "title": "Annual Turnover Ratio",
          "type": "number"
        },
        "aum_grid": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Aum Grid",
          "type": "array"
        },
        "base_aum": {
          "exclusiveMinimum": 0,
          "title": "Base Aum",
          "type": "number"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "legs": {
          "items": {
            "$ref": "#/$defs/ExecutionLeg"
          },
          "title": "Legs",
          "type": "array"
        },
        "network_stress": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkStressInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy": {
          "$ref": "#/$defs/CapacityStressPolicy",
          "default": {
            "allow_extrapolation": true,
            "break_even_tolerance": 1e-10,
            "margin_limit_fraction": 1.0,
            "network_spectral_radius_limit": 0.98,
            "trading_days_per_year": 252
          }
        }
      },
      "required": [
        "context",
        "base_aum",
        "annual_gross_return",
        "annual_turnover_ratio",
        "aum_grid",
        "legs"
      ],
      "title": "CapacityRequest",
      "type": "object"
    },
    "CapacityStressPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_extrapolation": {
          "default": true,
          "title": "Allow Extrapolation",
          "type": "boolean"
        },
        "break_even_tolerance": {
          "default": 1e-10,
          "exclusiveMinimum": 0,
          "title": "Break Even Tolerance",
          "type": "number"
        },
        "margin_limit_fraction": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Margin Limit Fraction",
          "type": "number"
        },
        "network_spectral_radius_limit": {
          "default": 0.98,
          "exclusiveMinimum": 0,
          "title": "Network Spectral Radius Limit",
          "type": "number"
        },
        "trading_days_per_year": {
          "default": 252,
          "minimum": 1,
          "title": "Trading Days Per Year",
          "type": "integer"
        }
      },
      "title": "CapacityStressPolicy",
      "type": "object"
    },
    "ConstraintDefinition": {
      "additionalProperties": false,
      "properties": {
        "breach_direction": {
          "$ref": "#/$defs/BreachDirection"
        },
        "constraint_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Constraint Id",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "constraint_id",
        "threshold",
        "breach_direction"
      ],
      "title": "ConstraintDefinition",
      "type": "object"
    },
    "DRORequest": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "distribution": {
          "$ref": "#/$defs/EmpiricalScenarioDistribution"
        },
        "policy": {
          "$ref": "#/$defs/AmbiguitySetPolicy"
        }
      },
      "required": [
        "context",
        "distribution",
        "policy"
      ],
      "title": "DRORequest",
      "type": "object"
    },
    "EVTPolicy": {
      "additionalProperties": false,
      "properties": {
        "confidence_level": {
          "default": 0.99,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.5,
          "title": "Confidence Level",
          "type": "number"
        },
        "ewma_lambda": {
          "default": 0.94,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0,
          "title": "Ewma Lambda",
          "type": "number"
        },
        "maximum_absolute_residual_autocorrelation": {
          "default": 0.15,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Absolute Residual Autocorrelation",
          "type": "number"
        },
        "maximum_tail_index_range": {
          "default": 0.35,
          "exclusiveMinimum": 0,
          "title": "Maximum Tail Index Range",
          "type": "number"
        },
        "minimum_exceedances": {
          "default": 40,
          "minimum": 1,
          "title": "Minimum Exceedances",
          "type": "integer"
        },
        "minimum_scale": {
          "default": 1e-12,
          "exclusiveMinimum": 0,
          "title": "Minimum Scale",
          "type": "number"
        },
        "parameter_bootstrap_replicates": {
          "default": 200,
          "minimum": 1,
          "title": "Parameter Bootstrap Replicates",
          "type": "integer"
        },
        "threshold_quantile": {
          "default": 0.95,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.5,
          "title": "Threshold Quantile",
          "type": "number"
        },
        "threshold_sensitivity_step": {
          "default": 0.01,
          "exclusiveMaximum": 0.1,
          "exclusiveMinimum": 0,
          "title": "Threshold Sensitivity Step",
          "type": "number"
        }
      },
      "title": "EVTPolicy",
      "type": "object"
    },
    "EVTRequest": {
      "additionalProperties": false,
      "properties": {
        "conditional_scales": {
          "anyOf": [
            {
              "items": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditional Scales"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "loss_series_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Loss Series Id",
          "type": "string"
        },
        "losses": {
          "items": {
            "type": "number"
          },
          "title": "Losses",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/EVTPolicy",
          "default": {
            "confidence_level": 0.99,
            "ewma_lambda": 0.94,
            "maximum_absolute_residual_autocorrelation": 0.15,
            "maximum_tail_index_range": 0.35,
            "minimum_exceedances": 40,
            "minimum_scale": 1e-12,
            "parameter_bootstrap_replicates": 200,
            "threshold_quantile": 0.95,
            "threshold_sensitivity_step": 0.01
          }
        },
        "seed_policy": {
          "$ref": "#/$defs/SeedPolicy"
        }
      },
      "required": [
        "context",
        "loss_series_id",
        "losses",
        "seed_policy"
      ],
      "title": "EVTRequest",
      "type": "object"
    },
    "EmpiricalScenarioDistribution": {
      "additionalProperties": false,
      "properties": {
        "distribution_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Distribution Id",
          "type": "string"
        },
        "losses": {
          "items": {
            "type": "number"
          },
          "title": "Losses",
          "type": "array"
        },
        "scenario_ids": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Scenario Ids",
          "type": "array"
        },
        "scores": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scores"
        },
        "state_vectors": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "State Vectors",
          "type": "array"
        }
      },
      "required": [
        "distribution_id",
        "scenario_ids",
        "state_vectors",
        "losses"
      ],
      "title": "EmpiricalScenarioDistribution",
      "type": "object"
    },
    "EvidenceClass": {
      "enum": [
        "OBSERVED_LIVE",
        "OBSERVED_HISTORICAL",
        "TRANSLATED_FACTOR",
        "MODELLED",
        "PARAMETRIC",
        "STRESS_EXTRAPOLATED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "ExecutionLeg": {
      "additionalProperties": false,
      "properties": {
        "average_daily_volume": {
          "exclusiveMinimum": 0,
          "title": "Average Daily Volume",
          "type": "number"
        },
        "borrow_bps": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Borrow Bps",
          "type": "number"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "funding_bps": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Funding Bps",
          "type": "number"
        },
        "gross_exposure_multiple": {
          "minimum": 0,
          "title": "Gross Exposure Multiple",
          "type": "number"
        },
        "impact_coefficient_bps": {
          "minimum": 0.0,
          "title": "Impact Coefficient Bps",
          "type": "number"
        },
        "impact_exponent": {
          "default": 1.5,
          "exclusiveMinimum": 1.0,
          "title": "Impact Exponent",
          "type": "number"
        },
        "instrument_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Instrument Id",
          "type": "string"
        },
        "margin_rate": {
          "default": 0.0,
          "minimum": 0,
          "title": "Margin Rate",
          "type": "number"
        },
        "max_participation_rate": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Participation Rate",
          "type": "number"
        },
        "spread_bps": {
          "minimum": 0.0,
          "title": "Spread Bps",
          "type": "number"
        },
        "trade_weight": {
          "exclusiveMinimum": 0,
          "title": "Trade Weight",
          "type": "number"
        }
      },
      "required": [
        "instrument_id",
        "trade_weight",
        "gross_exposure_multiple",
        "average_daily_volume",
        "spread_bps",
        "impact_coefficient_bps",
        "evidence_class"
      ],
      "title": "ExecutionLeg",
      "type": "object"
    },
    "ExposureRecord": {
      "additionalProperties": false,
      "properties": {
        "current_factor_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Current Factor Id",
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "exposure_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Exposure Id",
          "type": "string"
        },
        "linear_sensitivity": {
          "title": "Linear Sensitivity",
          "type": "number"
        },
        "notional": {
          "title": "Notional",
          "type": "number"
        },
        "position_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Position Id",
          "type": "string"
        },
        "quadratic_sensitivity": {
          "default": 0.0,
          "title": "Quadratic Sensitivity",
          "type": "number"
        }
      },
      "required": [
        "exposure_id",
        "position_id",
        "current_factor_id",
        "notional",
        "linear_sensitivity",
        "evidence_class"
      ],
      "title": "ExposureRecord",
      "type": "object"
    },
    "FactorAxis": {
      "additionalProperties": false,
      "properties": {
        "factor_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Factor Id",
          "type": "string"
        },
        "grid_values": {
          "items": {
            "type": "number"
          },
          "title": "Grid Values",
          "type": "array"
        },
        "observed_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Max"
        },
        "observed_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Min"
        }
      },
      "required": [
        "factor_id",
        "grid_values"
      ],
      "title": "FactorAxis",
      "type": "object"
    },
    "FactorBound": {
      "additionalProperties": false,
      "properties": {
        "factor_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Factor Id",
          "type": "string"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "norm_weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Norm Weight",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "factor_id",
        "lower",
        "upper"
      ],
      "title": "FactorBound",
      "type": "object"
    },
    "FactorMapping": {
      "additionalProperties": false,
      "properties": {
        "current_factor_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Current Factor Id",
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "historical_factor_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Historical Factor Id",
          "type": "string"
        },
        "scale": {
          "default": 1.0,
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "current_factor_id",
        "historical_factor_id",
        "evidence_class"
      ],
      "title": "FactorMapping",
      "type": "object"
    },
    "FactorPath": {
      "additionalProperties": false,
      "properties": {
        "evidence_classes": {
          "items": {
            "$ref": "#/$defs/EvidenceClass"
          },
          "title": "Evidence Classes",
          "type": "array"
        },
        "factor_ids": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Factor Ids",
          "type": "array"
        },
        "path_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Path Id",
          "type": "string"
        },
        "timestamps": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Timestamps",
          "type": "array"
        },
        "units": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Units",
          "type": "array"
        },
        "values": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "path_id",
        "timestamps",
        "factor_ids",
        "values",
        "units",
        "evidence_classes"
      ],
      "title": "FactorPath",
      "type": "object"
    },
    "FactorShock": {
      "additionalProperties": false,
      "properties": {
        "factor_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Factor Id",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "factor_id",
        "value",
        "unit"
      ],
      "title": "FactorShock",
      "type": "object"
    },
    "FailureCondition": {
      "additionalProperties": false,
      "properties": {
        "breach_direction": {
          "$ref": "#/$defs/BreachDirection"
        },
        "condition_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Condition Id",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "condition_id",
        "threshold",
        "breach_direction"
      ],
      "title": "FailureCondition",
      "type": "object"
    },
    "HistoricalReplayPolicy": {
      "additionalProperties": false,
      "properties": {
        "maximum_modelled_pnl_share": {
          "default": 0.35,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Modelled Pnl Share",
          "type": "number"
        },
        "minimum_mapped_exposure_share": {
          "default": 0.9,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Mapped Exposure Share",
          "type": "number"
        },
        "require_recovery_path": {
          "default": true,
          "title": "Require Recovery Path",
          "type": "boolean"
        }
      },
      "title": "HistoricalReplayPolicy",
      "type": "object"
    },
    "MaterialRiskDefinition": {
      "additionalProperties": false,
      "properties": {
        "factor_ids": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Factor Ids",
          "type": "array"
        },
        "materiality_weight": {
          "exclusiveMinimum": 0,
          "title": "Materiality Weight",
          "type": "number"
        },
        "risk_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Risk Id",
          "type": "string"
        }
      },
      "required": [
        "risk_id",
        "factor_ids",
        "materiality_weight"
      ],
      "title": "MaterialRiskDefinition",
      "type": "object"
    },
    "NetworkStressInput": {
      "additionalProperties": false,
      "properties": {
        "initial_forced_sale": {
          "items": {
            "minimum": 0.0,
            "type": "number"
          },
          "title": "Initial Forced Sale",
          "type": "array"
        },
        "overlap_matrix": {
          "items": {
            "items": {
              "minimum": 0.0,
              "type": "number"
            },
            "type": "array"
          },
          "title": "Overlap Matrix",
          "type": "array"
        }
      },
      "required": [
        "overlap_matrix",
        "initial_forced_sale"
      ],
      "title": "NetworkStressInput",
      "type": "object"
    },
    "OutputSemantics": {
      "enum": [
        "PNL",
        "LOSS",
        "SCORE",
        "PORTFOLIO_VALUE"
      ],
      "title": "OutputSemantics",
      "type": "string"
    },
    "QuadraticResponseModel": {
      "additionalProperties": false,
      "properties": {
        "baseline_value": {
          "title": "Baseline Value",
          "type": "number"
        },
        "factor_ids": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Factor Ids",
          "type": "array"
        },
        "linear_coefficients": {
          "items": {
            "type": "number"
          },
          "title": "Linear Coefficients",
          "type": "array"
        },
        "model_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Model Id",
          "type": "string"
        },
        "model_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Model Sha256",
          "type": "string"
        },
        "quadratic_matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Quadratic Matrix",
          "type": "array"
        },
        "semantics": {
          "$ref": "#/$defs/OutputSemantics"
        },
        "units": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "model_id",
        "factor_ids",
        "units",
        "baseline_value",
        "linear_coefficients",
        "quadratic_matrix",
        "semantics",
        "model_sha256"
      ],
      "title": "QuadraticResponseModel",
      "type": "object"
    },
    "ReplayMode": {
      "enum": [
        "STATIC_EXPOSURE",
        "FROZEN_DYNAMIC_POLICY"
      ],
      "title": "ReplayMode",
      "type": "string"
    },
    "ReverseNorm": {
      "enum": [
        "WEIGHTED_L2"
      ],
      "title": "ReverseNorm",
      "type": "string"
    },
    "ReverseStressPolicy": {
      "additionalProperties": false,
      "properties": {
        "maximum_iterations": {
          "default": 500,
          "minimum": 1,
          "title": "Maximum Iterations",
          "type": "integer"
        },
        "minimum_safe_distance": {
          "default": 0.25,
          "minimum": 0,
          "title": "Minimum Safe Distance",
          "type": "number"
        },
        "multi_start_points": {
          "default": 16,
          "minimum": 1,
          "title": "Multi Start Points",
          "type": "integer"
        },
        "norm": {
          "$ref": "#/$defs/ReverseNorm",
          "default": "WEIGHTED_L2"
        },
        "solver_tolerance": {
          "default": 1e-09,
          "exclusiveMinimum": 0,
          "title": "Solver Tolerance",
          "type": "number"
        },
        "verification_tolerance": {
          "default": 1e-07,
          "exclusiveMinimum": 0,
          "title": "Verification Tolerance",
          "type": "number"
        }
      },
      "title": "ReverseStressPolicy",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
