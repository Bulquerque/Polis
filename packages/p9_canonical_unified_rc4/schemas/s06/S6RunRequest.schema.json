    "S5QualificationReference": {
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Bundle Id",
          "type": "string"
        },
        "bundle_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "qualification_status": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Qualification Status",
          "type": "string"
        },
        "source_version": {
          "default": "0.1.0rc1",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
