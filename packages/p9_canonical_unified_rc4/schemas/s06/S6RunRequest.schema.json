        },
        "extrapolation_margin": {
          "default": 0.0,
          "minimum": 0,
          "title": "Extrapolation Margin",
          "type": "number"
        },
        "interaction_tolerance": {
          "default": 1e-10,
          "minimum": 0,
          "title": "Interaction Tolerance",
          "type": "number"
        },
        "maximum_evaluations": {
          "default": 20000,
          "minimum": 1,
