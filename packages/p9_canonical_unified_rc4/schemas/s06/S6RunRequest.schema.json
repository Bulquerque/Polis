  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capacity": {
      "$ref": "#/$defs/CapacityRequest"
    },
    "crisis_exposures": {
      "items": {
        "$ref": "#/$defs/ExposureRecord"
      },
      "title": "Crisis Exposures",
      "type": "array"
    },
    "crisis_factor_path": {
      "$ref": "#/$defs/FactorPath"
    },
    "crisis_frozen_exposure_scales": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Crisis Frozen Exposure Scales"
    },
    "crisis_mappings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FactorMapping"
      },
      "title": "Crisis Mappings",
      "type": "array"
    },
    "crisis_replay_mode": {
      "$ref": "#/$defs/ReplayMode",
      "default": "STATIC_EXPOSURE"
    },
    "crisis_scenario_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Crisis Scenario Id",
      "type": "string"
    },
    "dro": {
      "anyOf": [
        {
          "$ref": "#/$defs/DRORequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evt": {
      "anyOf": [
        {
          "$ref": "#/$defs/EVTRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "historical_replay_policy": {
      "$ref": "#/$defs/HistoricalReplayPolicy",
      "default": {
        "maximum_modelled_pnl_share": 0.35,
        "minimum_mapped_exposure_share": 0.9,
        "require_recovery_path": true
      }
    },
    "reverse_bounds": {
      "items": {
        "$ref": "#/$defs/FactorBound"
      },
      "title": "Reverse Bounds",
      "type": "array"
    },
    "reverse_failure_condition": {
      "$ref": "#/$defs/FailureCondition"
    },
    "reverse_policy": {
      "$ref": "#/$defs/ReverseStressPolicy",
      "default": {
        "maximum_iterations": 500,
        "minimum_safe_distance": 0.25,
        "multi_start_points": 16,
        "norm": "WEIGHTED_L2",
        "solver_tolerance": 1e-09,
        "verification_tolerance": 1e-07
      }
    },
    "reverse_seed_policy": {
      "$ref": "#/$defs/SeedPolicy"
    },
    "scenario_registry": {
      "$ref": "#/$defs/ScenarioRegistryRequest"
    },
    "sensitivity_axes": {
      "items": {
        "$ref": "#/$defs/FactorAxis"
      },
      "title": "Sensitivity Axes",
      "type": "array"
    },
    "sensitivity_constraints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ConstraintDefinition"
      },
      "title": "Sensitivity Constraints",
      "type": "array"
    },
    "sensitivity_policy": {
      "$ref": "#/$defs/SensitivityPolicy",
      "default": {
        "cliff_relative_threshold": 0.25,
        "extrapolation_margin": 0.0,
        "interaction_tolerance": 1e-10,
        "maximum_evaluations": 20000
      }
    },
    "sensitivity_response_model": {
      "$ref": "#/$defs/QuadraticResponseModel"
    },
    "validation_policy": {
      "$ref": "#/$defs/StressValidationPolicy",
      "default": {
        "maximum_modelled_pnl_share": 0.35,
        "maximum_reverse_verification_error": 1e-06,
        "minimum_mapped_exposure_share": 0.9,
        "minimum_material_risk_coverage": 0.9,
        "minimum_reverse_distance": 0.25,
        "monotonicity_tolerance": 1e-10,
        "require_capacity": true,
        "require_dro": false,
        "require_evt": false,
        "require_reverse_stress": true
      }
    }
  },
  "required": [
    "scenario_registry",
    "crisis_factor_path",
    "crisis_exposures",
    "crisis_scenario_id",
    "sensitivity_response_model",
    "sensitivity_axes",
    "capacity",
    "reverse_bounds",
    "reverse_failure_condition",
    "reverse_seed_policy"
  ],
  "title": "S6RunRequest",
  "type": "object"
}
