{
  "$defs": {
    "CapacityPoint": {
      "additionalProperties": false,
      "properties": {
        "annual_cost_fraction": {
          "minimum": 0.0,
          "title": "Annual Cost Fraction",
          "type": "number"
        },
        "aum": {
          "exclusiveMinimum": 0,
          "title": "Aum",
          "type": "number"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
        },
        "liquidation_horizon_days": {
          "minimum": 0.0,
          "title": "Liquidation Horizon Days",
          "type": "number"
        },
        "margin_usage_fraction": {
          "minimum": 0.0,
          "title": "Margin Usage Fraction",
          "type": "number"
        },
        "maximum_participation_rate": {
          "minimum": 0.0,
          "title": "Maximum Participation Rate",
          "type": "number"
        },
        "net_return": {
          "title": "Net Return",
          "type": "number"
        }
      },
      "required": [
        "aum",
        "net_return",
        "annual_cost_fraction",
        "maximum_participation_rate",
        "liquidation_horizon_days",
        "margin_usage_fraction",
        "evidence_class",
        "feasible"
      ],
      "title": "CapacityPoint",
      "type": "object"
    },
    "EvidenceClass": {
      "enum": [
        "OBSERVED_LIVE",
        "OBSERVED_HISTORICAL",
        "TRANSLATED_FACTOR",
        "MODELLED",
        "PARAMETRIC",
        "STRESS_EXTRAPOLATED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "S6State": {
      "enum": [
        "SUCCESS",
        "COMMITTED",
        "COMMITTED_WITH_COVERAGE_GAPS",
        "DUPLICATE_REJECTED",
        "SUCCESS_WITH_MAPPING_LIMITATIONS",
        "MATERIAL_EXPOSURE_UNMAPPED",
        "LOCAL_ONLY",
        "EXTRAPOLATION_LIMITED",
        "CONSTRAINT_DISCONTINUITY_FOUND",
        "QUALIFIED",
        "QUALIFIED_WITH_LIMITATIONS",
        "INSUFFICIENT_EXCEEDANCES",
        "UNSTABLE_TAIL_INDEX",
        "THRESHOLD_NOT_IDENTIFIED",
        "DEPENDENCE_NOT_REMOVED",
        "AMBIGUITY_SET_UNINFORMATIVE",
        "SOLVER_NOT_QUALIFIED",
        "UNBOUNDED",
        "CAPACITY_LIMITED",
        "BORROW_LIMITED",
        "MARGIN_FRAGILE",
        "NETWORK_STRESS_RESEARCH_ONLY",
        "INSUFFICIENT_LIQUIDITY_DATA",
        "STRESS_RESILIENT",
        "RESILIENT_WITH_LIMITATIONS",
        "REVERSE_STRESS_TOO_CLOSE",
        "STRUCTURALLY_UNSAFE",
        "NO_FAILURE_WITHIN_DOMAIN",
        "SEARCH_NOT_CONVERGED",
        "VALIDATED",
        "VALIDATED_WITH_LIMITATIONS",
        "RESEARCH_ONLY",
        "SCENARIO_INCOMPLETE",
        "MODEL_NOT_FIT_FOR_STRESS",
        "UNVALIDATED",
        "CAPABILITY_UNAVAILABLE",
        "INVALID_INPUT",
        "INVALID"
      ],
      "title": "S6State",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "break_even_aum": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Break Even Aum"
    },
    "capacity_limit_aum": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Capacity Limit Aum"
    },
    "limitations": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "maximum_liquidation_horizon_days": {
      "minimum": 0.0,
      "title": "Maximum Liquidation Horizon Days",
      "type": "number"
    },
    "minimum_margin_buffer": {
      "title": "Minimum Margin Buffer",
      "type": "number"
    },
    "network_loss_amplification": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Network Loss Amplification"
    },
    "network_spectral_radius": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Network Spectral Radius"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/CapacityPoint"
      },
      "title": "Points",
      "type": "array"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/S6State"
    }
  },
  "required": [
    "status",
    "points",
    "break_even_aum",
    "capacity_limit_aum",
    "maximum_liquidation_horizon_days",
    "minimum_margin_buffer",
    "network_spectral_radius",
    "network_loss_amplification"
  ],
  "title": "CapacityResult",
  "type": "object"
}
