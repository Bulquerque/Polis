{
  "$defs": {
    "EvidenceClass": {
      "enum": [
        "OBSERVED_LIVE",
        "OBSERVED_HISTORICAL",
        "TRANSLATED_FACTOR",
        "MODELLED",
        "PARAMETRIC",
        "STRESS_EXTRAPOLATED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "ExposureMappingResult": {
      "additionalProperties": false,
      "properties": {
        "current_factor_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Current Factor Id",
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "exposure_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Exposure Id",
          "type": "string"
        },
        "historical_factor_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Historical Factor Id"
        },
        "mapped": {
          "title": "Mapped",
          "type": "boolean"
        },
        "mapping_scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mapping Scale"
        },
        "notional": {
          "title": "Notional",
          "type": "number"
        }
      },
      "required": [
        "exposure_id",
        "current_factor_id",
        "historical_factor_id",
        "mapping_scale",
        "evidence_class",
        "mapped",
        "notional"
      ],
      "title": "ExposureMappingResult",
      "type": "object"
    },
    "ReplayMode": {
      "enum": [
        "STATIC_EXPOSURE",
        "FROZEN_DYNAMIC_POLICY"
      ],
      "title": "ReplayMode",
      "type": "string"
    },
    "ReplayPoint": {
      "additionalProperties": false,
      "properties": {
        "cumulative_pnl": {
          "title": "Cumulative Pnl",
          "type": "number"
        },
        "mapped_pnl": {
          "title": "Mapped Pnl",
          "type": "number"
        },
        "modelled_pnl": {
          "title": "Modelled Pnl",
          "type": "number"
        },
        "pnl": {
          "title": "Pnl",
          "type": "number"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "unmapped_notional": {
          "minimum": 0.0,
          "title": "Unmapped Notional",
          "type": "number"
        }
      },
      "required": [
        "timestamp",
        "pnl",
        "cumulative_pnl",
        "mapped_pnl",
        "modelled_pnl",
        "unmapped_notional"
      ],
      "title": "ReplayPoint",
      "type": "object"
    },
    "S6State": {
      "enum": [
        "SUCCESS",
        "COMMITTED",
        "COMMITTED_WITH_COVERAGE_GAPS",
        "DUPLICATE_REJECTED",
        "SUCCESS_WITH_MAPPING_LIMITATIONS",
        "MATERIAL_EXPOSURE_UNMAPPED",
        "LOCAL_ONLY",
        "EXTRAPOLATION_LIMITED",
        "CONSTRAINT_DISCONTINUITY_FOUND",
        "QUALIFIED",
        "QUALIFIED_WITH_LIMITATIONS",
        "INSUFFICIENT_EXCEEDANCES",
        "UNSTABLE_TAIL_INDEX",
        "THRESHOLD_NOT_IDENTIFIED",
        "DEPENDENCE_NOT_REMOVED",
        "AMBIGUITY_SET_UNINFORMATIVE",
        "SOLVER_NOT_QUALIFIED",
        "UNBOUNDED",
        "CAPACITY_LIMITED",
        "BORROW_LIMITED",
        "MARGIN_FRAGILE",
        "NETWORK_STRESS_RESEARCH_ONLY",
        "INSUFFICIENT_LIQUIDITY_DATA",
        "STRESS_RESILIENT",
        "RESILIENT_WITH_LIMITATIONS",
        "REVERSE_STRESS_TOO_CLOSE",
        "STRUCTURALLY_UNSAFE",
        "NO_FAILURE_WITHIN_DOMAIN",
        "SEARCH_NOT_CONVERGED",
        "VALIDATED",
        "VALIDATED_WITH_LIMITATIONS",
        "RESEARCH_ONLY",
        "SCENARIO_INCOMPLETE",
        "MODEL_NOT_FIT_FOR_STRESS",
        "UNVALIDATED",
        "CAPABILITY_UNAVAILABLE",
        "INVALID_INPUT",
        "INVALID"
      ],
      "title": "S6State",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "limitations": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "mapped_exposure_share": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Mapped Exposure Share",
      "type": "number"
    },
    "mappings": {
      "items": {
        "$ref": "#/$defs/ExposureMappingResult"
      },
      "title": "Mappings",
      "type": "array"
    },
    "modelled_pnl_share": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Modelled Pnl Share",
      "type": "number"
    },
    "path": {
      "items": {
        "$ref": "#/$defs/ReplayPoint"
      },
      "title": "Path",
      "type": "array"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "recovery_included": {
      "title": "Recovery Included",
      "type": "boolean"
    },
    "replay_mode": {
      "$ref": "#/$defs/ReplayMode"
    },
    "scenario_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Scenario Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/S6State"
    },
    "unmapped_notional": {
      "minimum": 0.0,
      "title": "Unmapped Notional",
      "type": "number"
    },
    "worst_cumulative_pnl": {
      "title": "Worst Cumulative Pnl",
      "type": "number"
    }
  },
  "required": [
    "status",
    "scenario_id",
    "replay_mode",
    "mappings",
    "path",
    "mapped_exposure_share",
    "modelled_pnl_share",
    "unmapped_notional",
    "worst_cumulative_pnl",
    "recovery_included"
  ],
  "title": "HistoricalCrisisReplayResult",
  "type": "object"
}
