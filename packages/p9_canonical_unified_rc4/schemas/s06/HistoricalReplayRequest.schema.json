{
  "$defs": {
    "CommittedScenario": {
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "$ref": "#/$defs/ScenarioProposal"
        },
        "semantic_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Semantic Sha256",
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "semantic_sha256"
      ],
      "title": "CommittedScenario",
      "type": "object"
    },
    "EvidenceClass": {
      "enum": [
        "OBSERVED_LIVE",
        "OBSERVED_HISTORICAL",
        "TRANSLATED_FACTOR",
        "MODELLED",
        "PARAMETRIC",
        "STRESS_EXTRAPOLATED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "evidence_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Evidence Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type",
        "content_sha256",
        "evidence_class"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ExposureRecord": {
      "additionalProperties": false,
      "properties": {
        "current_factor_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Current Factor Id",
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "exposure_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Exposure Id",
          "type": "string"
        },
        "linear_sensitivity": {
          "title": "Linear Sensitivity",
          "type": "number"
        },
        "notional": {
          "title": "Notional",
          "type": "number"
        },
        "position_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Position Id",
          "type": "string"
        },
        "quadratic_sensitivity": {
          "default": 0.0,
          "title": "Quadratic Sensitivity",
          "type": "number"
        }
      },
      "required": [
        "exposure_id",
        "position_id",
        "current_factor_id",
        "notional",
        "linear_sensitivity",
        "evidence_class"
      ],
      "title": "ExposureRecord",
      "type": "object"
    },
    "FactorMapping": {
      "additionalProperties": false,
      "properties": {
        "current_factor_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Current Factor Id",
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "historical_factor_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Historical Factor Id",
          "type": "string"
        },
        "scale": {
          "default": 1.0,
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "current_factor_id",
        "historical_factor_id",
        "evidence_class"
      ],
      "title": "FactorMapping",
      "type": "object"
    },
    "FactorPath": {
      "additionalProperties": false,
      "properties": {
        "evidence_classes": {
          "items": {
            "$ref": "#/$defs/EvidenceClass"
          },
          "title": "Evidence Classes",
          "type": "array"
        },
        "factor_ids": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Factor Ids",
          "type": "array"
        },
        "path_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Path Id",
          "type": "string"
        },
        "timestamps": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Timestamps",
          "type": "array"
        },
        "units": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Units",
          "type": "array"
        },
        "values": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "path_id",
        "timestamps",
        "factor_ids",
        "values",
        "units",
        "evidence_classes"
      ],
      "title": "FactorPath",
      "type": "object"
    },
    "FactorShock": {
      "additionalProperties": false,
      "properties": {
        "factor_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Factor Id",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "factor_id",
        "value",
        "unit"
      ],
      "title": "FactorShock",
      "type": "object"
    },
    "HistoricalReplayPolicy": {
      "additionalProperties": false,
      "properties": {
        "maximum_modelled_pnl_share": {
          "default": 0.35,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Modelled Pnl Share",
          "type": "number"
        },
        "minimum_mapped_exposure_share": {
          "default": 0.9,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Mapped Exposure Share",
          "type": "number"
        },
        "require_recovery_path": {
          "default": true,
          "title": "Require Recovery Path",
          "type": "boolean"
        }
      },
      "title": "HistoricalReplayPolicy",
      "type": "object"
    },
    "MaterialRiskCoverage": {
      "additionalProperties": false,
      "properties": {
        "covered": {
          "title": "Covered",
          "type": "boolean"
        },
        "covering_scenario_ids": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Covering Scenario Ids",
          "type": "array"
        },
        "materiality_weight": {
          "exclusiveMinimum": 0,
          "title": "Materiality Weight",
          "type": "number"
        },
        "risk_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Risk Id",
          "type": "string"
        }
      },
      "required": [
        "risk_id",
        "covered",
        "covering_scenario_ids",
        "materiality_weight"
      ],
      "title": "MaterialRiskCoverage",
      "type": "object"
    },
    "ReplayMode": {
      "enum": [
        "STATIC_EXPOSURE",
        "FROZEN_DYNAMIC_POLICY"
      ],
      "title": "ReplayMode",
      "type": "string"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "code_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "configuration_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Configuration Id",
          "type": "string"
        },
        "cycle_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Cycle Id",
          "type": "string"
        },
        "data_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Data Sha256",
          "type": "string"
        },
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "experiment_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Experiment Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "cycle_id",
        "experiment_id",
        "configuration_id",
        "decision_time",
        "available_at",
        "code_sha256",
        "data_sha256"
      ],
      "title": "RunContext",
      "type": "object"
    },
    "S6State": {
      "enum": [
        "SUCCESS",
        "COMMITTED",
        "COMMITTED_WITH_COVERAGE_GAPS",
        "DUPLICATE_REJECTED",
        "SUCCESS_WITH_MAPPING_LIMITATIONS",
        "MATERIAL_EXPOSURE_UNMAPPED",
        "LOCAL_ONLY",
        "EXTRAPOLATION_LIMITED",
        "CONSTRAINT_DISCONTINUITY_FOUND",
        "QUALIFIED",
        "QUALIFIED_WITH_LIMITATIONS",
        "INSUFFICIENT_EXCEEDANCES",
        "UNSTABLE_TAIL_INDEX",
        "THRESHOLD_NOT_IDENTIFIED",
        "DEPENDENCE_NOT_REMOVED",
        "AMBIGUITY_SET_UNINFORMATIVE",
        "SOLVER_NOT_QUALIFIED",
        "UNBOUNDED",
        "CAPACITY_LIMITED",
        "BORROW_LIMITED",
        "MARGIN_FRAGILE",
        "NETWORK_STRESS_RESEARCH_ONLY",
        "INSUFFICIENT_LIQUIDITY_DATA",
        "STRESS_RESILIENT",
        "RESILIENT_WITH_LIMITATIONS",
        "REVERSE_STRESS_TOO_CLOSE",
        "STRUCTURALLY_UNSAFE",
        "NO_FAILURE_WITHIN_DOMAIN",
        "SEARCH_NOT_CONVERGED",
        "VALIDATED",
        "VALIDATED_WITH_LIMITATIONS",
        "RESEARCH_ONLY",
        "SCENARIO_INCOMPLETE",
        "MODEL_NOT_FIT_FOR_STRESS",
        "UNVALIDATED",
        "CAPABILITY_UNAVAILABLE",
        "INVALID_INPUT",
        "INVALID"
      ],
      "title": "S6State",
      "type": "string"
    },
    "ScenarioClass": {
      "enum": [
        "HISTORICAL_REPLAY",
        "HYPOTHETICAL_SCENARIO",
        "UNIVARIATE_SENSITIVITY",
        "MULTIVARIATE_STRESS",
        "REVERSE_STRESS",
        "LIQUIDITY_STRESS",
        "MARGIN_STRESS",
        "EXECUTION_STRESS",
        "MODEL_STRESS",
        "SYSTEMIC_STRESS"
      ],
      "title": "ScenarioClass",
      "type": "string"
    },
    "ScenarioProposal": {
      "additionalProperties": false,
      "properties": {
        "approved_uses": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Approved Uses",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "horizon_days": {
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Name",
          "type": "string"
        },
        "plausibility_label": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Plausibility Label",
          "type": "string"
        },
        "prohibited_uses": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Prohibited Uses",
          "type": "array"
        },
        "purpose": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Purpose",
          "type": "string"
        },
        "scenario_class": {
          "$ref": "#/$defs/ScenarioClass"
        },
        "scenario_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Scenario Id",
          "type": "string"
        },
        "severity_label": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Severity Label",
          "type": "string"
        },
        "shocks": {
          "items": {
            "$ref": "#/$defs/FactorShock"
          },
          "title": "Shocks",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "name",
        "scenario_class",
        "created_at",
        "purpose",
        "approved_uses",
        "shocks",
        "horizon_days",
        "severity_label",
        "plausibility_label"
      ],
      "title": "ScenarioProposal",
      "type": "object"
    },
    "StressScenarioRegistrySnapshot": {
      "additionalProperties": false,
      "properties": {
        "commitment_time": {
          "format": "date-time",
          "title": "Commitment Time",
          "type": "string"
        },
        "duplicate_scenario_ids": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Duplicate Scenario Ids",
          "type": "array"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "registry_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Registry Id",
          "type": "string"
        },
        "registry_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Registry Sha256",
          "type": "string"
        },
        "risk_coverage": {
          "items": {
            "$ref": "#/$defs/MaterialRiskCoverage"
          },
          "title": "Risk Coverage",
          "type": "array"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/CommittedScenario"
          },
          "title": "Scenarios",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/S6State"
        },
        "weighted_material_risk_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weighted Material Risk Coverage",
          "type": "number"
        }
      },
      "required": [
        "status",
        "registry_id",
        "scenarios",
        "duplicate_scenario_ids",
        "risk_coverage",
        "weighted_material_risk_coverage",
        "commitment_time",
        "registry_sha256"
      ],
      "title": "StressScenarioRegistrySnapshot",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/RunContext"
    },
    "exposures": {
      "items": {
        "$ref": "#/$defs/ExposureRecord"
      },
      "title": "Exposures",
      "type": "array"
    },
    "factor_path": {
      "$ref": "#/$defs/FactorPath"
    },
    "frozen_exposure_scales": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen Exposure Scales"
    },
    "mappings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FactorMapping"
      },
      "title": "Mappings",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/HistoricalReplayPolicy",
      "default": {
        "maximum_modelled_pnl_share": 0.35,
        "minimum_mapped_exposure_share": 0.9,
        "require_recovery_path": true
      }
    },
    "registry": {
      "$ref": "#/$defs/StressScenarioRegistrySnapshot"
    },
    "replay_mode": {
      "$ref": "#/$defs/ReplayMode",
      "default": "STATIC_EXPOSURE"
    },
    "scenario_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Scenario Id",
      "type": "string"
    }
  },
  "required": [
    "context",
    "registry",
    "scenario_id",
    "factor_path",
    "exposures"
  ],
  "title": "HistoricalReplayRequest",
  "type": "object"
}
