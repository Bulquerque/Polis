{
  "$defs": {
    "RegressionCovariance": {
      "enum": [
        "NONROBUST",
        "HC3",
        "HAC"
      ],
      "title": "RegressionCovariance",
      "type": "string"
    }
  },
  "$id": "https://inferencia.local/p9/s4/1.0.0/RegressionPolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "condition_number_limit": {
      "default": 1000000.0,
      "exclusiveMinimum": 1,
      "title": "Condition Number Limit",
      "type": "number"
    },
    "covariance": {
      "$ref": "#/$defs/RegressionCovariance",
      "default": "HAC"
    },
    "factor_model_ids": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Factor Model Ids",
      "type": "array"
    },
    "hac_max_lags": {
      "default": 5,
      "minimum": 0,
      "title": "Hac Max Lags",
      "type": "integer"
    },
    "minimum_observations": {
      "default": 30,
      "minimum": 3,
      "title": "Minimum Observations",
      "type": "integer"
    },
    "policy_id": {
      "title": "Policy Id",
      "type": "string"
    },
    "policy_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Policy Version",
      "type": "string"
    },
    "rolling_window": {
      "anyOf": [
        {
          "minimum": 3,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rolling Window"
    }
  },
  "required": [
    "policy_id",
    "policy_version",
    "factor_model_ids"
  ],
  "title": "RegressionPolicy",
  "type": "object"
}
