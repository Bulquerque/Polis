{
  "$defs": {
    "AnnualizationPolicy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/FrequencyMode"
        },
        "periods_per_year": {
          "anyOf": [
            {
              "gt": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Periods Per Year"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Policy Version",
          "type": "string"
        },
        "regularity_tolerance_fraction": {
          "default": 0.1,
          "maximum": 1,
          "minimum": 0,
          "title": "Regularity Tolerance Fraction",
          "type": "number"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "mode"
      ],
      "title": "AnnualizationPolicy",
      "type": "object"
    },
    "BacktestQualificationReceipt": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "handoff_id": {
          "title": "Handoff Id",
          "type": "string"
        },
        "qualified_handoff_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Qualified Handoff Sha256"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/QualificationState"
        }
      },
      "required": [
        "handoff_id",
        "state",
        "checks",
        "reason_codes",
        "qualified_handoff_sha256",
        "content_sha256"
      ],
      "title": "BacktestQualificationReceipt",
      "type": "object"
    },
    "BenchmarkAndFactorPanel": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/FactorObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "panel_id": {
          "title": "Panel Id",
          "type": "string"
        },
        "panel_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Panel Version",
          "type": "string"
        }
      },
      "required": [
        "panel_id",
        "panel_version",
        "observations",
        "content_sha256"
      ],
      "title": "BenchmarkAndFactorPanel",
      "type": "object"
    },
    "CandidateTerminalRecord": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/CandidateTerminalState"
        }
      },
      "required": [
        "candidate_id",
        "state"
      ],
      "title": "CandidateTerminalRecord",
      "type": "object"
    },
    "CandidateTerminalState": {
      "enum": [
        "GENERATED",
        "RANKED",
        "BLOCKED",
        "ABSTAINED",
        "SELECTED",
        "NOT_SELECTED",
        "EXECUTED",
        "NO_ACTION"
      ],
      "title": "CandidateTerminalState",
      "type": "string"
    },
    "CapacityPolicy": {
      "additionalProperties": false,
      "properties": {
        "aum_multipliers": {
          "default": [
            0.5,
            1.0,
            2.0,
            5.0
          ],
          "items": {
            "type": "number"
          },
          "title": "Aum Multipliers",
          "type": "array"
        },
        "impact": {
          "$ref": "#/$defs/ImpactPolicy"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "impact"
      ],
      "title": "CapacityPolicy",
      "type": "object"
    },
    "CashCategory": {
      "enum": [
        "FILL",
        "DEPOSIT",
        "WITHDRAWAL",
        "INTEREST",
        "FINANCING",
        "BORROW",
        "LIFECYCLE",
        "OTHER_FEE"
      ],
      "title": "CashCategory",
      "type": "string"
    },
    "CashLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "category": {
          "$ref": "#/$defs/CashCategory"
        },
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "related_fill_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Fill Id"
        },
        "related_lifecycle_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Lifecycle Id"
        }
      },
      "required": [
        "entry_id",
        "event_time",
        "amount",
        "category"
      ],
      "title": "CashLedgerEntry",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "observed": {
          "title": "Observed",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        }
      },
      "required": [
        "check_id",
        "passed",
        "observed",
        "expected"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "DistributionPolicy": {
      "additionalProperties": false,
      "properties": {
        "autocorrelation_lags": {
          "default": [
            1,
            5,
            21
          ],
          "items": {
            "type": "integer"
          },
          "title": "Autocorrelation Lags",
          "type": "array"
        },
        "downside_threshold_per_period": {
          "default": 0.0,
          "title": "Downside Threshold Per Period",
          "type": "number"
        },
        "ljung_box_max_lag": {
          "default": 10,
          "minimum": 1,
          "title": "Ljung Box Max Lag",
          "type": "integer"
        },
        "minimum_samples": {
          "$ref": "#/$defs/MinimumSamplePolicy"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Policy Version",
          "type": "string"
        },
        "rolling_windows": {
          "default": [
            20,
            60,
            252
          ],
          "items": {
            "type": "integer"
          },
          "title": "Rolling Windows",
          "type": "array"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "minimum_samples"
      ],
      "title": "DistributionPolicy",
      "type": "object"
    },
    "DrawdownPolicy": {
      "additionalProperties": false,
      "properties": {
        "conditional_tail_fraction": {
          "default": 0.2,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Conditional Tail Fraction",
          "type": "number"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version"
      ],
      "title": "DrawdownPolicy",
      "type": "object"
    },
    "EvidenceClass": {
      "enum": [
        "OBSERVED_LIVE",
        "OBSERVED_HISTORICAL",
        "SIMULATED_ORDERBOOK",
        "PARAMETRIC_IMPACT",
        "STRESS_EXTRAPOLATED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "ExposureSnapshot": {
      "additionalProperties": false,
      "properties": {
        "gross_exposure": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Gross Exposure"
        },
        "margin_used": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Margin Used"
        },
        "nav": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Nav"
        },
        "net_exposure": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Net Exposure"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "gross_exposure",
        "net_exposure",
        "margin_used",
        "nav"
      ],
      "title": "ExposureSnapshot",
      "type": "object"
    },
    "ExternalFlowTiming": {
      "enum": [
        "END_OF_PERIOD"
      ],
      "title": "ExternalFlowTiming",
      "type": "string"
    },
    "FactorModelRegistry": {
      "additionalProperties": false,
      "properties": {
        "models": {
          "items": {
            "$ref": "#/$defs/FactorModelSpec"
          },
          "title": "Models",
          "type": "array"
        },
        "registry_id": {
          "title": "Registry Id",
          "type": "string"
        },
        "registry_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Registry Version",
          "type": "string"
        }
      },
      "required": [
        "registry_id",
        "registry_version",
        "models"
      ],
      "title": "FactorModelRegistry",
      "type": "object"
    },
    "FactorModelSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "factor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Factor Ids",
          "type": "array"
        },
        "factor_model_id": {
          "title": "Factor Model Id",
          "type": "string"
        },
        "factor_model_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Factor Model Version",
          "type": "string"
        },
        "include_intercept": {
          "default": true,
          "title": "Include Intercept",
          "type": "boolean"
        }
      },
      "required": [
        "factor_model_id",
        "factor_model_version",
        "factor_ids",
        "description"
      ],
      "title": "FactorModelSpec",
      "type": "object"
    },
    "FactorObservation": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/FactorValue"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "timestamp",
        "available_at",
        "values"
      ],
      "title": "FactorObservation",
      "type": "object"
    },
    "FactorValue": {
      "additionalProperties": false,
      "properties": {
        "factor_id": {
          "title": "Factor Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "factor_id",
        "value"
      ],
      "title": "FactorValue",
      "type": "object"
    },
    "FillRecord": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "fee": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Fee"
        },
        "fill_id": {
          "title": "Fill Id",
          "type": "string"
        },
        "fill_time": {
          "format": "date-time",
          "title": "Fill Time",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Price"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "side": {
          "$ref": "#/$defs/Side"
        }
      },
      "required": [
        "fill_id",
        "order_id",
        "instrument_id",
        "side",
        "quantity",
        "price",
        "fee",
        "fill_time",
        "available_at"
      ],
      "title": "FillRecord",
      "type": "object"
    },
    "FrequencyMode": {
      "enum": [
        "EXPLICIT",
        "OBSERVED_REGULAR"
      ],
      "title": "FrequencyMode",
      "type": "string"
    },
    "ImpactPolicy": {
      "additionalProperties": false,
      "properties": {
        "eta": {
          "default": 0.1,
          "minimum": 0,
          "title": "Eta",
          "type": "number"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass",
          "default": "PARAMETRIC_IMPACT"
        },
        "maximum_participation": {
          "default": 0.2,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Maximum Participation",
          "type": "number"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version"
      ],
      "title": "ImpactPolicy",
      "type": "object"
    },
    "LifecycleEvent": {
      "additionalProperties": false,
      "properties": {
        "cash_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cash Amount"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/LifecycleType"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "quantity_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Quantity Delta"
        }
      },
      "required": [
        "event_id",
        "instrument_id",
        "event_type",
        "event_time"
      ],
      "title": "LifecycleEvent",
      "type": "object"
    },
    "LifecycleType": {
      "enum": [
        "EXERCISE",
        "ASSIGNMENT",
        "EXPIRY",
        "ROLL",
        "CASH_SETTLEMENT",
        "QUANTITY_ADJUSTMENT"
      ],
      "title": "LifecycleType",
      "type": "string"
    },
    "LiquidityObservation": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "average_daily_volume": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Average Daily Volume"
        },
        "daily_volatility": {
          "exclusiveMinimum": 0,
          "title": "Daily Volatility",
          "type": "number"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "mid_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Mid Price"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "timestamp",
        "available_at",
        "average_daily_volume",
        "daily_volatility",
        "mid_price"
      ],
      "title": "LiquidityObservation",
      "type": "object"
    },
    "MetricQualityPolicy": {
      "additionalProperties": false,
      "properties": {
        "money_tolerance": {
          "default": 1e-06,
          "minimum": 0,
          "title": "Money Tolerance",
          "type": "number"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Policy Version",
          "type": "string"
        },
        "require_all_core_metrics_qualified": {
          "default": false,
          "title": "Require All Core Metrics Qualified",
          "type": "boolean"
        },
        "require_factor_panel": {
          "default": false,
          "title": "Require Factor Panel",
          "type": "boolean"
        }
      },
      "required": [
        "policy_id",
        "policy_version"
      ],
      "title": "MetricQualityPolicy",
      "type": "object"
    },
    "MetricRegistry": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/MetricRegistryEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "registry_id": {
          "title": "Registry Id",
          "type": "string"
        },
        "registry_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Registry Version",
          "type": "string"
        }
      },
      "required": [
        "registry_id",
        "registry_version",
        "entries",
        "content_sha256"
      ],
      "title": "MetricRegistry",
      "type": "object"
    },
    "MetricRegistryEntry": {
      "additionalProperties": false,
      "properties": {
        "allowed_gross_net": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Gross Net",
          "type": "array"
        },
        "metric_pattern": {
          "title": "Metric Pattern",
          "type": "string"
        },
        "metric_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Metric Version",
          "type": "string"
        },
        "producer_module_id": {
