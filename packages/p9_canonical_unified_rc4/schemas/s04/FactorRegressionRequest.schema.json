{
  "$defs": {
    "BenchmarkAndFactorPanel": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/FactorObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "panel_id": {
          "title": "Panel Id",
          "type": "string"
        },
        "panel_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Panel Version",
          "type": "string"
        }
      },
      "required": [
        "panel_id",
        "panel_version",
        "observations",
        "content_sha256"
      ],
      "title": "BenchmarkAndFactorPanel",
      "type": "object"
    },
    "DiagnosticRecord": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "severity": {
          "pattern": "^(INFO|WARNING|ERROR|BLOCKER)$",
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "severity"
      ],
      "title": "DiagnosticRecord",
      "type": "object"
    },
    "FactorModelRegistry": {
      "additionalProperties": false,
      "properties": {
        "models": {
          "items": {
            "$ref": "#/$defs/FactorModelSpec"
          },
          "title": "Models",
          "type": "array"
        },
        "registry_id": {
          "title": "Registry Id",
          "type": "string"
        },
        "registry_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Registry Version",
          "type": "string"
        }
      },
      "required": [
        "registry_id",
        "registry_version",
        "models"
      ],
      "title": "FactorModelRegistry",
      "type": "object"
    },
    "FactorModelSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "factor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Factor Ids",
          "type": "array"
        },
        "factor_model_id": {
          "title": "Factor Model Id",
          "type": "string"
        },
        "factor_model_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Factor Model Version",
          "type": "string"
        },
        "include_intercept": {
          "default": true,
          "title": "Include Intercept",
          "type": "boolean"
        }
      },
      "required": [
        "factor_model_id",
        "factor_model_version",
        "factor_ids",
        "description"
      ],
      "title": "FactorModelSpec",
      "type": "object"
    },
    "FactorObservation": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/FactorValue"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "timestamp",
        "available_at",
        "values"
      ],
      "title": "FactorObservation",
      "type": "object"
    },
    "FactorValue": {
      "additionalProperties": false,
      "properties": {
        "factor_id": {
          "title": "Factor Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "factor_id",
        "value"
      ],
      "title": "FactorValue",
      "type": "object"
    },
    "GrossNet": {
      "enum": [
        "GROSS",
        "NET",
        "ACTIVE",
        "EXCESS",
        "NOT_APPLICABLE"
      ],
      "title": "GrossNet",
      "type": "string"
    },
    "MetricRecord": {
      "additionalProperties": false,
      "properties": {
        "annualization_periods": {
          "anyOf": [
            {
              "gt": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annualization Periods"
        },
        "gross_net": {
          "$ref": "#/$defs/GrossNet",
          "default": "NOT_APPLICABLE"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Metric Version",
          "type": "string"
        },
        "producer_module_id": {
          "title": "Producer Module Id",
          "type": "string"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "metric_id",
        "metric_version",
        "producer_module_id",
        "value",
        "unit",
        "status",
        "sample_count",
        "method"
      ],
      "title": "MetricRecord",
      "type": "object"
    },
    "MetricStatus": {
      "enum": [
        "QUALIFIED",
        "LIMITED",
        "UNAVAILABLE",
        "INSUFFICIENT_SAMPLE",
        "UNDEFINED",
        "INVALID"
      ],
      "title": "MetricStatus",
      "type": "string"
    },
    "PointInTimeSeries": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/SeriesPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "series_id": {
          "title": "Series Id",
          "type": "string"
        },
        "series_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Series Version",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "series_version",
        "points",
        "content_sha256"
      ],
      "title": "PointInTimeSeries",
      "type": "object"
    },
    "QualifiedBacktestIdentity": {
      "additionalProperties": false,
      "properties": {
        "configuration_id": {
          "title": "Configuration Id",
          "type": "string"
        },
        "cycle_id": {
          "title": "Cycle Id",
          "type": "string"
        },
        "fold_id": {
          "title": "Fold Id",
          "type": "string"
        },
        "handoff_id": {
          "title": "Handoff Id",
          "type": "string"
        },
        "handoff_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Handoff Sha256",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "cycle_id",
        "trial_id",
        "fold_id",
        "configuration_id",
        "handoff_id",
        "handoff_sha256"
      ],
      "title": "QualifiedBacktestIdentity",
      "type": "object"
    },
    "RegressionCovariance": {
      "enum": [
        "NONROBUST",
        "HC3",
        "HAC"
      ],
      "title": "RegressionCovariance",
      "type": "string"
    },
    "RegressionPolicy": {
      "additionalProperties": false,
      "properties": {
        "condition_number_limit": {
          "default": 1000000.0,
          "exclusiveMinimum": 1,
          "title": "Condition Number Limit",
          "type": "number"
        },
        "covariance": {
          "$ref": "#/$defs/RegressionCovariance",
          "default": "HAC"
        },
        "factor_model_ids": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Factor Model Ids",
          "type": "array"
        },
        "hac_max_lags": {
          "default": 5,
          "minimum": 0,
          "title": "Hac Max Lags",
          "type": "integer"
        },
        "minimum_observations": {
          "default": 30,
          "minimum": 3,
          "title": "Minimum Observations",
          "type": "integer"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Policy Version",
          "type": "string"
        },
        "rolling_window": {
          "anyOf": [
            {
              "minimum": 3,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rolling Window"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "factor_model_ids"
      ],
      "title": "RegressionPolicy",
      "type": "object"
    },
    "ReturnSeriesPanel": {
      "additionalProperties": false,
      "properties": {
        "active_returns": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Returns"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "diagnostics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DiagnosticRecord"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "excess_returns": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excess Returns"
        },
        "gross_returns": {
          "items": {
            "type": "number"
          },
          "title": "Gross Returns",
          "type": "array"
        },
        "identity": {
          "$ref": "#/$defs/QualifiedBacktestIdentity"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metrics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricRecord"
          },
          "title": "Metrics",
          "type": "array"
        },
        "net_returns": {
          "items": {
            "type": "number"
          },
          "title": "Net Returns",
          "type": "array"
        },
        "panel_id": {
          "title": "Panel Id",
          "type": "string"
        },
        "panel_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Panel Version",
          "type": "string"
        },
        "periods_per_year": {
          "title": "Periods Per Year",
          "type": "number"
        },
        "timestamps": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Timestamps",
          "type": "array"
        }
      },
      "required": [
        "panel_id",
        "panel_version",
        "identity",
        "content_sha256",
        "timestamps",
        "gross_returns",
        "net_returns",
        "periods_per_year"
      ],
      "title": "ReturnSeriesPanel",
      "type": "object"
    },
    "SeriesPoint": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "timestamp",
        "value",
        "available_at"
      ],
      "title": "SeriesPoint",
      "type": "object"
    },
    "Unit": {
      "enum": [
        "DECIMAL_RETURN",
        "ANNUALIZED_DECIMAL",
        "RATIO",
        "PROBABILITY",
        "MONEY",
        "BPS",
        "COUNT",
        "SECONDS",
        "FRACTION",
        "COEFFICIENT"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "$id": "https://inferencia.local/p9/s4/1.0.0/FactorRegressionRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "factors": {
      "$ref": "#/$defs/BenchmarkAndFactorPanel"
    },
    "policy": {
      "$ref": "#/$defs/RegressionPolicy"
    },
    "registry": {
      "$ref": "#/$defs/FactorModelRegistry"
    },
    "returns": {
      "$ref": "#/$defs/ReturnSeriesPanel"
    },
    "risk_free": {
      "$ref": "#/$defs/PointInTimeSeries"
    }
  },
  "required": [
    "returns",
    "factors",
    "risk_free",
    "registry",
    "policy"
  ],
  "title": "FactorRegressionRequest",
  "type": "object"
}
