{
  "$defs": {
    "CapabilityBinding": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "limitation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitation"
        },
        "owner_module_id": {
          "pattern": "^P[0-9]+\\.S[0-9]+\\.M[0-9]+$",
          "title": "Owner Module Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CapabilityState"
        },
        "supported_strategy_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SearchStrategy"
          },
          "title": "Supported Strategy Ids",
          "type": "array"
        }
      },
      "required": [
        "capability_id",
        "owner_module_id",
        "state"
      ],
      "title": "CapabilityBinding",
      "type": "object"
    },
    "CapabilityState": {
      "enum": [
        "AVAILABLE",
        "LIMITED",
        "RESERVED",
        "UNAVAILABLE"
      ],
      "title": "CapabilityState",
      "type": "string"
    },
    "EvidenceClass": {
      "enum": [
        "FACTUAL_EXECUTED",
        "FACTUAL_OBSERVED_NOT_EXECUTED",
        "OBSERVABLE_COUNTERFACTUAL",
        "MODEL_BASED_COUNTERFACTUAL",
        "CENSORED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "ExperimentSpecification": {
      "additionalProperties": false,
      "properties": {
        "activated_at": {
          "format": "date-time",
          "title": "Activated At",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "development_dataset_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Development Dataset Ids",
          "type": "array"
        },
        "diagnostic_metric_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{2,127}$",
            "type": "string"
          },
          "title": "Diagnostic Metric Ids",
          "type": "array"
        },
        "evaluation_dataset_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evaluation Dataset Ids",
          "type": "array"
        },
        "experiment_id": {
          "pattern": "^exp-[a-z0-9][a-z0-9._-]{2,127}$",
          "title": "Experiment Id",
          "type": "string"
        },
        "final_holdout_dataset_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Final Holdout Dataset Ids",
          "type": "array"
        },
        "hard_guardrail_metric_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{2,127}$",
            "type": "string"
          },
          "title": "Hard Guardrail Metric Ids",
          "type": "array"
        },
        "hypothesis": {
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "non_goals": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Non Goals",
          "type": "array"
        },
        "primary_metric_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,127}$",
          "title": "Primary Metric Id",
          "type": "string"
        },
        "requested_max_configurations": {
          "minimum": 1,
          "title": "Requested Max Configurations",
          "type": "integer"
        },
        "requested_seed_count": {
          "maximum": 128,
          "minimum": 1,
          "title": "Requested Seed Count",
          "type": "integer"
        },
        "required_capability_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Capability Ids",
          "type": "array"
        },
        "search_strategy": {
          "$ref": "#/$defs/SearchStrategy"
        },
        "target_module_ids": {
          "items": {
            "pattern": "^P[0-9]+\\.S[0-9]+\\.M[0-9]+$",
            "type": "string"
          },
          "title": "Target Module Ids",
          "type": "array"
        },
        "temporal_evaluation": {
          "$ref": "#/$defs/TemporalEvaluationRequest"
        }
      },
      "required": [
        "experiment_id",
        "created_at",
        "activated_at",
        "hypothesis",
        "primary_metric_id",
        "hard_guardrail_metric_ids",
        "target_module_ids",
        "development_dataset_ids",
        "evaluation_dataset_ids",
        "final_holdout_dataset_ids",
        "search_strategy",
        "requested_max_configurations",
        "requested_seed_count",
        "temporal_evaluation"
      ],
      "title": "ExperimentSpecification",
      "type": "object"
    },
    "FrozenCohortRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "lineage_complete": {
          "title": "Lineage Complete",
          "type": "boolean"
        },
        "outcome_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Outcome Record Sha256",
          "type": "string"
        },
        "subject_id": {
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "target_type": {
          "minLength": 1,
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "target_type",
        "evidence_class",
        "outcome_record_sha256",
        "lineage_complete"
      ],
      "title": "FrozenCohortRecord",
      "type": "object"
    },
    "FrozenEvaluationCohort": {
      "additionalProperties": false,
      "properties": {
        "cohort_id": {
          "minLength": 1,
          "title": "Cohort Id",
          "type": "string"
        },
        "cohort_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cohort Sha256",
          "type": "string"
        },
        "commitment_id": {
          "minLength": 1,
          "title": "Commitment Id",
          "type": "string"
        },
        "excluded_subject_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Excluded Subject Ids",
          "type": "array"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/FrozenCohortRecord"
          },
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "cohort_id",
        "commitment_id",
        "policy_id",
        "frozen_at",
        "records",
        "excluded_subject_ids",
        "cohort_sha256"
      ],
      "title": "FrozenEvaluationCohort",
      "type": "object"
    },
    "MetricBinding": {
      "additionalProperties": false,
      "properties": {
        "allowed_for_tuning": {
          "title": "Allowed For Tuning",
          "type": "boolean"
        },
        "direction": {
          "$ref": "#/$defs/MetricDirection"
        },
        "hard_guardrail_eligible": {
          "default": false,
          "title": "Hard Guardrail Eligible",
          "type": "boolean"
        },
        "metric_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,127}$",
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "minLength": 1,
          "title": "Metric Version",
          "type": "string"
        },
        "minimum_observations": {
          "minimum": 1,
          "title": "Minimum Observations",
          "type": "integer"
        }
      },
      "required": [
        "metric_id",
        "metric_version",
        "direction",
        "minimum_observations",
        "allowed_for_tuning"
      ],
      "title": "MetricBinding",
      "type": "object"
    },
    "MetricDirection": {
      "enum": [
        "MAXIMIZE",
        "MINIMIZE"
      ],
      "title": "MetricDirection",
      "type": "string"
    },
    "MetricRegistrySnapshot": {
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricBinding"
          },
          "title": "Metrics",
          "type": "array"
        },
        "registry_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registry Sha256",
          "type": "string"
        },
        "registry_version": {
          "minLength": 1,
          "title": "Registry Version",
          "type": "string"
        }
      },
      "required": [
        "registry_version",
        "registry_sha256",
        "metrics"
      ],
      "title": "MetricRegistrySnapshot",
      "type": "object"
    },
    "PhaseCapabilityRegistry": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityBinding"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "registry_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registry Sha256",
          "type": "string"
        },
        "registry_version": {
          "minLength": 1,
          "title": "Registry Version",
          "type": "string"
        }
      },
      "required": [
        "registry_version",
        "registry_sha256",
        "capabilities"
      ],
      "title": "PhaseCapabilityRegistry",
      "type": "object"
    },
    "PromotionPolicyReference": {
      "additionalProperties": false,
      "properties": {
        "hard_guardrails_non_compensable": {
          "default": true,
          "title": "Hard Guardrails Non Compensable",
          "type": "boolean"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "policy_sha256"
      ],
      "title": "PromotionPolicyReference",
      "type": "object"
    },
    "SearchStrategy": {
      "enum": [
        "GRID",
        "RANDOM",
        "SUCCESSIVE_HALVING",
        "HYPERBAND",
        "BOHB"
      ],
      "title": "SearchStrategy",
      "type": "string"
    },
    "TemporalEvaluationRequest": {
      "additionalProperties": false,
      "properties": {
        "embargo_required": {
          "default": true,
          "title": "Embargo Required",
          "type": "boolean"
        },
        "final_holdout_required": {
          "default": true,
          "title": "Final Holdout Required",
          "type": "boolean"
        },
        "inner_fold_count": {
          "maximum": 64,
          "minimum": 1,
          "title": "Inner Fold Count",
          "type": "integer"
        },
        "outer_fold_count": {
          "maximum": 64,
          "minimum": 1,
          "title": "Outer Fold Count",
          "type": "integer"
        },
        "purge_required": {
          "default": true,
          "title": "Purge Required",
          "type": "boolean"
        }
      },
      "required": [
        "outer_fold_count",
        "inner_fold_count"
      ],
      "title": "TemporalEvaluationRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capability_registry": {
      "$ref": "#/$defs/PhaseCapabilityRegistry"
    },
    "frozen_cohort": {
      "$ref": "#/$defs/FrozenEvaluationCohort"
    },
    "metric_registry": {
      "$ref": "#/$defs/MetricRegistrySnapshot"
    },
    "promotion_policy": {
      "$ref": "#/$defs/PromotionPolicyReference"
    },
    "specification": {
      "$ref": "#/$defs/ExperimentSpecification"
    }
  },
  "required": [
    "specification",
    "frozen_cohort",
    "metric_registry",
    "capability_registry",
    "promotion_policy"
  ],
  "title": "ExperimentValidationInput",
  "type": "object"
}
