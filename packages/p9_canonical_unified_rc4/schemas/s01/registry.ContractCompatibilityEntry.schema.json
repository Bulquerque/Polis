{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_modes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Accepted Modes",
      "type": "array"
    },
    "contract_name": {
      "minLength": 1,
      "title": "Contract Name",
      "type": "string"
    },
    "contract_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "title": "Contract Version",
      "type": "string"
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "accepted_modes"
  ],
  "title": "ContractCompatibilityEntry",
  "type": "object"
}
