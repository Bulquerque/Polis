{
  "$defs": {
    "DurationSpec": {
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "minimum": 0,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "required": [
        "seconds"
      ],
      "title": "DurationSpec",
      "type": "object"
    },
    "FoldDefinition": {
      "additionalProperties": false,
      "properties": {
        "embargo": {
          "$ref": "#/$defs/DurationSpec"
        },
        "fold_id": {
          "title": "Fold Id",
          "type": "string"
        },
        "outer_index": {
          "minimum": 0,
          "title": "Outer Index",
          "type": "integer"
        },
        "test_window": {
          "$ref": "#/$defs/TimeWindow"
        },
        "train_window": {
          "$ref": "#/$defs/TimeWindow"
        },
        "tuning_window": {
          "$ref": "#/$defs/TimeWindow"
        }
      },
      "required": [
        "fold_id",
        "outer_index",
        "train_window",
        "tuning_window",
        "test_window",
        "embargo"
      ],
      "title": "FoldDefinition",
      "type": "object"
    },
    "HoldoutFirewallPolicy": {
      "additionalProperties": false,
      "properties": {
        "access_policy_id": {
          "title": "Access Policy Id",
          "type": "string"
        },
        "allowed_consumer_module_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Consumer Module Ids",
          "type": "array"
        },
        "holdout_window": {
          "$ref": "#/$defs/TimeWindow"
        },
        "opened_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opened At"
        }
      },
      "required": [
        "holdout_window",
        "access_policy_id"
      ],
      "title": "HoldoutFirewallPolicy",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "$id": "https://inferencia.local/p9/s3/TemporalEvaluationPlan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "folds": {
      "items": {
        "$ref": "#/$defs/FoldDefinition"
      },
      "title": "Folds",
      "type": "array"
    },
    "holdout_firewall": {
      "$ref": "#/$defs/HoldoutFirewallPolicy"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "policy_id": {
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "policy_id",
    "policy_sha256",
    "folds",
    "holdout_firewall",
    "content_sha256"
  ],
  "title": "TemporalEvaluationPlan",
  "type": "object"
}
