{
  "$defs": {
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Evidence Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type",
        "content_sha256"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "LjungBoxDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "lag": {
          "minimum": 1,
          "title": "Lag",
          "type": "integer"
        },
        "pvalue": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Pvalue",
          "type": "number"
        },
        "statistic": {
          "minimum": 0,
          "title": "Statistic",
          "type": "number"
        }
      },
      "required": [
        "lag",
        "statistic",
        "pvalue"
      ],
      "title": "LjungBoxDiagnostic",
      "type": "object"
    },
    "S5State": {
      "enum": [
        "SUCCESS",
        "QUALIFIED",
        "QUALIFIED_WITH_LIMITATIONS",
        "PARTIAL_METRIC_COVERAGE",
        "INSUFFICIENT_EVIDENCE",
        "INSUFFICIENT_HISTORY",
        "INSUFFICIENT_TRADES",
        "INSUFFICIENT_VALID_REPLICATES",
        "IRREGULAR_TIME_UNSUPPORTED",
        "TRIAL_FAMILY_INCOMPLETE",
        "EFFECTIVE_TRIAL_COUNT_UNRESOLVED",
        "METRIC_VERSION_MISMATCH",
        "ROBUST",
        "PROVISIONALLY_ROBUST",
        "FRAGILE",
        "BACKTEST_OVERFIT_RISK",
        "REGIME_DEPENDENT",
        "SELECTION_BIAS_UNRESOLVED",
        "INVALID_INPUT",
        "INVALID"
      ],
      "title": "S5State",
      "type": "string"
    },
    "SamplingUnit": {
      "enum": [
        "TIME_BLOCK",
        "HIERARCHICAL_TIME_CROSS_SECTION",
        "TRADE_EPISODE_CLUSTER"
      ],
      "title": "SamplingUnit",
      "type": "string"
    },
    "SeriesDependenceDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "autocorrelations": {
          "items": {
            "type": "number"
          },
          "title": "Autocorrelations",
          "type": "array"
        },
        "dependence_horizon": {
          "minimum": 1,
          "title": "Dependence Horizon",
          "type": "integer"
        },
        "effective_sample_size": {
          "exclusiveMinimum": 0,
          "title": "Effective Sample Size",
          "type": "number"
        },
        "ljung_box": {
          "items": {
            "$ref": "#/$defs/LjungBoxDiagnostic"
          },
          "title": "Ljung Box",
          "type": "array"
        },
        "observation_count": {
          "minimum": 1,
          "title": "Observation Count",
          "type": "integer"
        },
        "series_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Series Id",
          "type": "string"
        },
        "variance": {
          "minimum": 0,
          "title": "Variance",
          "type": "number"
        }
      },
      "required": [
        "series_id",
        "observation_count",
        "effective_sample_size",
        "dependence_horizon",
        "autocorrelations",
        "ljung_box",
        "variance"
      ],
      "title": "SeriesDependenceDiagnostic",
      "type": "object"
    },
    "TradeOverlapDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "cluster_count": {
          "minimum": 0,
          "title": "Cluster Count",
          "type": "integer"
        },
        "cluster_ids_by_trade": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minLength": 1,
                "pattern": ".*\\S.*",
                "type": "string"
              },
              {
                "minimum": 1,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Cluster Ids By Trade",
          "type": "array"
        },
        "maximum_concurrency": {
          "minimum": 0,
          "title": "Maximum Concurrency",
          "type": "integer"
        },
        "overlap_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overlap Fraction",
          "type": "number"
        },
        "trade_count": {
          "minimum": 0,
          "title": "Trade Count",
          "type": "integer"
        }
      },
      "required": [
        "trade_count",
        "cluster_count",
        "maximum_concurrency",
        "overlap_fraction",
        "cluster_ids_by_trade"
      ],
      "title": "TradeOverlapDiagnostic",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "average_absolute_cross_correlation": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Average Absolute Cross Correlation",
      "type": "number"
    },
    "cross_sectional_correlation": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "title": "Cross Sectional Correlation",
      "type": "array"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "recommended_sampling_units": {
      "items": {
        "$ref": "#/$defs/SamplingUnit"
      },
      "title": "Recommended Sampling Units",
      "type": "array"
    },
    "regular_interval_seconds": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Regular Interval Seconds"
    },
    "series_diagnostics": {
      "items": {
        "$ref": "#/$defs/SeriesDependenceDiagnostic"
      },
      "title": "Series Diagnostics",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/S5State"
    },
    "trade_overlap": {
      "anyOf": [
        {
          "$ref": "#/$defs/TradeOverlapDiagnostic"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "series_diagnostics",
    "cross_sectional_correlation",
    "average_absolute_cross_correlation",
    "trade_overlap",
    "recommended_sampling_units",
    "regular_interval_seconds"
  ],
  "title": "DependenceDiagnosticsResult",
  "type": "object"
}
