{
  "$defs": {
    "FoldScore": {
      "additionalProperties": false,
      "properties": {
        "fold_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Fold Id",
          "type": "string"
        },
        "observation_count": {
          "minimum": 1,
          "title": "Observation Count",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "fold_id",
        "score",
        "observation_count"
      ],
      "title": "FoldScore",
      "type": "object"
    },
    "FoldScorePanel": {
      "additionalProperties": false,
      "properties": {
        "configuration_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Configuration Id",
          "type": "string"
        },
        "scores": {
          "items": {
            "$ref": "#/$defs/FoldScore"
          },
          "title": "Scores",
          "type": "array"
        }
      },
      "required": [
        "configuration_id",
        "scores"
      ],
      "title": "FoldScorePanel",
      "type": "object"
    },
    "MetricDistributionResult": {
      "additionalProperties": false,
      "properties": {
        "estimates": {
          "items": {
            "$ref": "#/$defs/MetricEstimate"
          },
          "title": "Estimates",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metric_registry_version": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Metric Registry Version",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/S5State"
        }
      },
      "required": [
        "status",
        "metric_registry_version",
        "estimates"
      ],
      "title": "MetricDistributionResult",
      "type": "object"
    },
    "MetricEstimate": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bootstrap Mean"
        },
        "bootstrap_median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bootstrap Median"
        },
        "confidence_interval_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence Interval High"
        },
        "confidence_interval_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence Interval Low"
        },
        "invalid_replicates": {
          "minimum": 0,
          "title": "Invalid Replicates",
          "type": "integer"
        },
        "lower_confidence_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower Confidence Bound"
        },
        "metric_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Metric Id",
          "type": "string"
        },
        "metric_name": {
          "$ref": "#/$defs/MetricName"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Value"
        },
        "probability_above_threshold": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Probability Above Threshold"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "standard_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Error"
        },
        "status": {
          "$ref": "#/$defs/S5State"
        },
        "valid_replicates": {
          "minimum": 0,
          "title": "Valid Replicates",
          "type": "integer"
        },
        "worst_quantile": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Worst Quantile"
        }
      },
      "required": [
        "metric_id",
        "metric_name",
        "observed_value",
        "bootstrap_mean",
        "bootstrap_median",
        "confidence_interval_low",
        "confidence_interval_high",
        "lower_confidence_bound",
        "worst_quantile",
        "probability_above_threshold",
        "valid_replicates",
        "invalid_replicates",
        "status"
      ],
      "title": "MetricEstimate",
      "type": "object"
    },
    "MetricName": {
      "enum": [
        "ANNUALIZED_RETURN",
        "VOLATILITY",
        "SHARPE",
        "CUMULATIVE_RETURN",
        "CAGR",
        "MAX_DRAWDOWN",
        "SORTINO",
        "CALMAR",
        "EXPECTED_SHORTFALL",
        "ALPHA",
        "BETA",
        "INFORMATION_RATIO",
        "COMPETITION_SCORE"
      ],
      "title": "MetricName",
      "type": "string"
    },
    "MultipleTestingPolicy": {
      "additionalProperties": false,
      "properties": {
        "cscv_slices": {
          "default": 8,
          "minimum": 1,
          "title": "Cscv Slices",
          "type": "integer"
        },
        "maximum_cscv_combinations": {
          "default": 5000,
          "minimum": 1,
          "title": "Maximum Cscv Combinations",
          "type": "integer"
        },
        "reality_check_block_length": {
          "default": 5,
          "minimum": 1,
          "title": "Reality Check Block Length",
          "type": "integer"
        },
        "reality_check_replicates": {
          "default": 1000,
          "minimum": 1,
          "title": "Reality Check Replicates",
          "type": "integer"
        },
        "significance_level": {
          "default": 0.05,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Significance Level",
          "type": "number"
        }
      },
      "title": "MultipleTestingPolicy",
      "type": "object"
    },
    "QualificationThresholdPolicy": {
      "additionalProperties": false,
      "properties": {
        "maximum_pbo": {
          "default": 0.2,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Pbo",
          "type": "number"
        },
        "maximum_reality_check_pvalue": {
          "default": 0.1,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Reality Check Pvalue",
          "type": "number"
        },
        "minimum_bootstrap_probability_above_threshold": {
          "default": 0.8,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Bootstrap Probability Above Threshold",
          "type": "number"
        },
        "minimum_dsr": {
          "default": 0.95,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Dsr",
          "type": "number"
        },
        "minimum_rank_stability": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Rank Stability",
          "type": "number"
        },
        "minimum_worst_fold_score": {
          "default": 0.0,
          "title": "Minimum Worst Fold Score",
          "type": "number"
        }
      },
      "title": "QualificationThresholdPolicy",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "code_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "configuration_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Configuration Id",
          "type": "string"
        },
        "cycle_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Cycle Id",
          "type": "string"
        },
        "data_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Data Sha256",
          "type": "string"
        },
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "experiment_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Experiment Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "cycle_id",
        "experiment_id",
        "configuration_id",
        "decision_time",
        "available_at",
        "code_sha256",
        "data_sha256"
      ],
      "title": "RunContext",
      "type": "object"
    },
    "S5State": {
      "enum": [
        "SUCCESS",
        "QUALIFIED",
        "QUALIFIED_WITH_LIMITATIONS",
        "PARTIAL_METRIC_COVERAGE",
        "INSUFFICIENT_EVIDENCE",
        "INSUFFICIENT_HISTORY",
        "INSUFFICIENT_TRADES",
        "INSUFFICIENT_VALID_REPLICATES",
        "IRREGULAR_TIME_UNSUPPORTED",
        "TRIAL_FAMILY_INCOMPLETE",
        "EFFECTIVE_TRIAL_COUNT_UNRESOLVED",
        "METRIC_VERSION_MISMATCH",
        "ROBUST",
        "PROVISIONALLY_ROBUST",
        "FRAGILE",
        "BACKTEST_OVERFIT_RISK",
        "REGIME_DEPENDENT",
        "SELECTION_BIAS_UNRESOLVED",
        "INVALID_INPUT",
        "INVALID"
      ],
      "title": "S5State",
      "type": "string"
    },
    "SeedPolicy": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "default": "PCG64",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Algorithm",
          "type": "string"
        },
        "derivation_version": {
          "default": "seedsequence-v1",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Derivation Version",
          "type": "string"
        },
        "root_entropy": {
          "minimum": 0,
          "title": "Root Entropy",
          "type": "integer"
        }
      },
      "required": [
        "root_entropy"
      ],
      "title": "SeedPolicy",
      "type": "object"
    },
    "SharpeInferenceResult": {
      "additionalProperties": false,
      "properties": {
        "autocorrelation_adjusted_annualized_sharpe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Autocorrelation Adjusted Annualized Sharpe"
        },
        "benchmark_annualized_sharpe": {
          "title": "Benchmark Annualized Sharpe",
          "type": "number"
        },
        "deflated_sharpe_ratio": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deflated Sharpe Ratio"
        },
        "effective_trial_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Trial Count"
        },
        "expected_max_annualized_sharpe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Max Annualized Sharpe"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "minimum_track_record_observations": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Track Record Observations"
        },
        "observation_count": {
          "minimum": 1,
          "title": "Observation Count",
          "type": "integer"
        },
        "observed_annualized_sharpe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Annualized Sharpe"
        },
        "pearson_kurtosis": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pearson Kurtosis"
        },
        "probabilistic_sharpe_ratio": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Probabilistic Sharpe Ratio"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "skewness": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Skewness"
        },
        "status": {
          "$ref": "#/$defs/S5State"
        },
        "target_series_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Target Series Id",
          "type": "string"
        }
      },
      "required": [
        "status",
        "target_series_id",
        "observation_count",
        "observed_annualized_sharpe",
        "autocorrelation_adjusted_annualized_sharpe",
        "probabilistic_sharpe_ratio",
        "deflated_sharpe_ratio",
        "benchmark_annualized_sharpe",
        "expected_max_annualized_sharpe",
        "skewness"
      ],
      "title": "SharpeInferenceResult",
      "type": "object"
    },
    "TrialPerformancePanel": {
      "additionalProperties": false,
      "properties": {
        "configuration_ids": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Configuration Ids",
          "type": "array"
        },
        "economic_cluster_ids": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "pattern": ".*\\S.*",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Economic Cluster Ids"
        },
        "family_complete": {
          "title": "Family Complete",
          "type": "boolean"
        },
        "panel_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Panel Id",
          "type": "string"
        },
        "performance_values": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Performance Values",
          "type": "array"
        },
        "states": {
          "items": {
            "$ref": "#/$defs/TrialState"
          },
          "title": "States",
          "type": "array"
        },
        "timestamps": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Timestamps",
          "type": "array"
        },
        "trial_ids": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Trial Ids",
          "type": "array"
        }
      },
      "required": [
        "panel_id",
        "timestamps",
        "trial_ids",
        "configuration_ids",
        "states",
        "performance_values",
        "family_complete"
      ],
      "title": "TrialPerformancePanel",
      "type": "object"
    },
    "TrialState": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "EARLY_STOPPED",
        "ABANDONED"
      ],
      "title": "TrialState",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/RunContext"
    },
    "fold_scores": {
      "$ref": "#/$defs/FoldScorePanel"
    },
    "metric_distributions": {
      "$ref": "#/$defs/MetricDistributionResult"
    },
    "multiple_testing_policy": {
      "$ref": "#/$defs/MultipleTestingPolicy",
      "default": {
        "cscv_slices": 8,
        "maximum_cscv_combinations": 5000,
        "reality_check_block_length": 5,
        "reality_check_replicates": 1000,
        "significance_level": 0.05
      }
    },
    "seed_policy": {
      "$ref": "#/$defs/SeedPolicy"
    },
    "sharpe_inference": {
      "$ref": "#/$defs/SharpeInferenceResult"
    },
    "target_configuration_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Target Configuration Id",
      "type": "string"
    },
    "target_metric_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Target Metric Id",
      "type": "string"
    },
    "threshold_policy": {
      "$ref": "#/$defs/QualificationThresholdPolicy",
      "default": {
        "maximum_pbo": 0.2,
        "maximum_reality_check_pvalue": 0.1,
        "minimum_bootstrap_probability_above_threshold": 0.8,
        "minimum_dsr": 0.95,
        "minimum_rank_stability": 0.5,
        "minimum_worst_fold_score": 0.0
      }
    },
    "trial_performance": {
      "$ref": "#/$defs/TrialPerformancePanel"
    }
  },
  "required": [
    "context",
    "target_configuration_id",
    "target_metric_id",
    "trial_performance",
    "fold_scores",
    "metric_distributions",
    "sharpe_inference",
    "seed_policy"
  ],
  "title": "RobustnessQualificationRequest",
  "type": "object"
}
