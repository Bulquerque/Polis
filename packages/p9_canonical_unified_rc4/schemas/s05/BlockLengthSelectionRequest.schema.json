{
  "$defs": {
    "BlockLengthPolicy": {
      "additionalProperties": false,
      "properties": {
        "fallback_dependence_multiplier": {
          "default": 2.0,
          "minimum": 1.0,
          "title": "Fallback Dependence Multiplier",
          "type": "number"
        },
        "joint_aggregation": {
          "default": "MAX",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Joint Aggregation",
          "type": "string"
        },
        "maximum_fraction": {
          "default": 0.3333333333333333,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Fraction",
          "type": "number"
        },
        "minimum_block_length": {
          "default": 1,
          "minimum": 1,
          "title": "Minimum Block Length",
          "type": "integer"
        }
      },
      "title": "BlockLengthPolicy",
      "type": "object"
    },
    "DependenceDiagnosticsResult": {
      "additionalProperties": false,
      "properties": {
        "average_absolute_cross_correlation": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Average Absolute Cross Correlation",
          "type": "number"
        },
        "cross_sectional_correlation": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Cross Sectional Correlation",
          "type": "array"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "recommended_sampling_units": {
          "items": {
            "$ref": "#/$defs/SamplingUnit"
          },
          "title": "Recommended Sampling Units",
          "type": "array"
        },
        "regular_interval_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Regular Interval Seconds"
        },
        "series_diagnostics": {
          "items": {
            "$ref": "#/$defs/SeriesDependenceDiagnostic"
          },
          "title": "Series Diagnostics",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/S5State"
        },
        "trade_overlap": {
          "anyOf": [
            {
              "$ref": "#/$defs/TradeOverlapDiagnostic"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "series_diagnostics",
        "cross_sectional_correlation",
        "average_absolute_cross_correlation",
        "trade_overlap",
        "recommended_sampling_units",
        "regular_interval_seconds"
      ],
      "title": "DependenceDiagnosticsResult",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Evidence Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type",
        "content_sha256"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "GrossNet": {
      "enum": [
        "GROSS",
        "NET"
      ],
      "title": "GrossNet",
      "type": "string"
    },
    "LjungBoxDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "lag": {
          "minimum": 1,
          "title": "Lag",
          "type": "integer"
        },
        "pvalue": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Pvalue",
          "type": "number"
        },
        "statistic": {
          "minimum": 0,
          "title": "Statistic",
          "type": "number"
        }
      },
      "required": [
        "lag",
        "statistic",
        "pvalue"
      ],
      "title": "LjungBoxDiagnostic",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "code_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "configuration_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Configuration Id",
          "type": "string"
        },
        "cycle_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Cycle Id",
          "type": "string"
        },
        "data_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Data Sha256",
          "type": "string"
        },
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "experiment_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Experiment Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "cycle_id",
        "experiment_id",
        "configuration_id",
        "decision_time",
        "available_at",
        "code_sha256",
        "data_sha256"
      ],
      "title": "RunContext",
      "type": "object"
    },
    "S5State": {
      "enum": [
        "SUCCESS",
        "QUALIFIED",
        "QUALIFIED_WITH_LIMITATIONS",
        "PARTIAL_METRIC_COVERAGE",
        "INSUFFICIENT_EVIDENCE",
        "INSUFFICIENT_HISTORY",
        "INSUFFICIENT_TRADES",
        "INSUFFICIENT_VALID_REPLICATES",
        "IRREGULAR_TIME_UNSUPPORTED",
        "TRIAL_FAMILY_INCOMPLETE",
        "EFFECTIVE_TRIAL_COUNT_UNRESOLVED",
        "METRIC_VERSION_MISMATCH",
        "ROBUST",
        "PROVISIONALLY_ROBUST",
        "FRAGILE",
        "BACKTEST_OVERFIT_RISK",
        "REGIME_DEPENDENT",
        "SELECTION_BIAS_UNRESOLVED",
        "INVALID_INPUT",
        "INVALID"
      ],
      "title": "S5State",
      "type": "string"
    },
    "SamplingUnit": {
      "enum": [
        "TIME_BLOCK",
        "HIERARCHICAL_TIME_CROSS_SECTION",
        "TRADE_EPISODE_CLUSTER"
      ],
      "title": "SamplingUnit",
      "type": "string"
    },
    "SeriesDependenceDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "autocorrelations": {
          "items": {
            "type": "number"
          },
          "title": "Autocorrelations",
          "type": "array"
        },
        "dependence_horizon": {
          "minimum": 1,
          "title": "Dependence Horizon",
          "type": "integer"
        },
        "effective_sample_size": {
          "exclusiveMinimum": 0,
          "title": "Effective Sample Size",
          "type": "number"
        },
        "ljung_box": {
          "items": {
            "$ref": "#/$defs/LjungBoxDiagnostic"
          },
          "title": "Ljung Box",
          "type": "array"
        },
        "observation_count": {
          "minimum": 1,
          "title": "Observation Count",
          "type": "integer"
        },
        "series_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Series Id",
          "type": "string"
        },
        "variance": {
          "minimum": 0,
          "title": "Variance",
          "type": "number"
        }
      },
      "required": [
        "series_id",
        "observation_count",
        "effective_sample_size",
        "dependence_horizon",
        "autocorrelations",
        "ljung_box",
        "variance"
      ],
      "title": "SeriesDependenceDiagnostic",
      "type": "object"
    },
    "TimeSeriesPanel": {
      "additionalProperties": false,
      "properties": {
        "benchmark_series_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benchmark Series Id"
        },
        "fold_ids": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "pattern": ".*\\S.*",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fold Ids"
        },
        "gross_or_net": {
          "$ref": "#/$defs/GrossNet"
        },
        "metric_registry_version": {
          "default": "1.0.0",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Metric Registry Version",
          "type": "string"
        },
        "panel_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Panel Id",
          "type": "string"
        },
        "periods_per_year": {
          "exclusiveMinimum": 0,
          "title": "Periods Per Year",
          "type": "number"
        },
        "regime_ids": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "pattern": ".*\\S.*",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regime Ids"
        },
        "risk_free_series_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Free Series Id"
        },
        "series_ids": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Series Ids",
          "type": "array"
        },
        "timestamps": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Timestamps",
          "type": "array"
        },
        "values": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "panel_id",
        "timestamps",
        "series_ids",
        "values",
        "periods_per_year",
        "gross_or_net"
      ],
      "title": "TimeSeriesPanel",
      "type": "object"
    },
    "TradeOverlapDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "cluster_count": {
          "minimum": 0,
          "title": "Cluster Count",
          "type": "integer"
        },
        "cluster_ids_by_trade": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minLength": 1,
                "pattern": ".*\\S.*",
                "type": "string"
              },
              {
                "minimum": 1,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Cluster Ids By Trade",
          "type": "array"
        },
        "maximum_concurrency": {
          "minimum": 0,
          "title": "Maximum Concurrency",
          "type": "integer"
        },
        "overlap_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overlap Fraction",
          "type": "number"
        },
        "trade_count": {
          "minimum": 0,
          "title": "Trade Count",
          "type": "integer"
        }
      },
      "required": [
        "trade_count",
        "cluster_count",
        "maximum_concurrency",
        "overlap_fraction",
        "cluster_ids_by_trade"
      ],
      "title": "TradeOverlapDiagnostic",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/RunContext"
    },
    "diagnostics": {
      "$ref": "#/$defs/DependenceDiagnosticsResult"
    },
    "policy": {
      "$ref": "#/$defs/BlockLengthPolicy",
      "default": {
        "fallback_dependence_multiplier": 2.0,
        "joint_aggregation": "MAX",
        "maximum_fraction": 0.3333333333333333,
        "minimum_block_length": 1
      }
    },
    "series": {
      "$ref": "#/$defs/TimeSeriesPanel"
    }
  },
  "required": [
    "context",
    "series",
    "diagnostics"
  ],
  "title": "BlockLengthSelectionRequest",
  "type": "object"
}
